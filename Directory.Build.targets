<Project>

  <!-- Enable AOT compatibility analysis on all projects except Roslyn
       analyzers / source-generators (netstandard2.0). Placed in .targets
       so that TargetFramework from the project file is already resolved.

       Opt-out: a project that is never trimmed / AOT-published AND whose
       reflection is intentional (build tools that reflect over arbitrary
       assemblies, and test projects whose architecture/contract guards scan
       IL or reflect over types by design) sets
       <ReactorSkipAotAnalysis>true</ReactorSkipAotAnalysis> to disable the
       IL2*/IL3* analyzer for that project. This replaces the old blanket
       consumer-wide NoWarn: shipped/AOT-relevant consumers (the CLI, WinForms
       interop, samples, the AOT-published hosts) stay analyzed and were fixed
       at the source; only the genuinely-non-AOT reflection projects opt out. -->
  <PropertyGroup Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net10.0')) And '$(ReactorSkipAotAnalysis)' != 'true'">
    <IsAotCompatible>true</IsAotCompatible>
    <!-- Show every individual trimmer warning instead of collapsing them. -->
    <TrimmerSingleWarn>false</TrimmerSingleWarn>
  </PropertyGroup>

  <!-- Promote IL trimming/AOT warnings to hard errors in EVERY configuration
       (Debug included) on every project the trim/AOT analyzer runs on (i.e.
       IsAotCompatible was turned on above). Directory.Build.props already makes
       ALL warnings errors on Release; this adds inner-loop (Debug) enforcement
       for the AOT-specific codes so new un-annotated reflection is caught while
       iterating, not only at the Release gate — uniformly across core, the
       shipped libraries, consumers (CLI, WinForms), and the AOT-published
       hosts/samples/proofs. Projects that reflect/scan IL by design opt out via
       <ReactorSkipAotAnalysis>true</ReactorSkipAotAnalysis> above, which turns
       off IsAotCompatible and therefore this promotion too. Individual codes are
       handled per-site (genuine [DynamicallyAccessedMembers] where the reflection
       can be made trim-safe, or a justified [UnconditionalSuppressMessage],
       tracked under issue #70). Any IL code outside this curated list is still an
       error on Release via TreatWarningsAsErrors. -->
  <PropertyGroup Condition="'$(IsAotCompatible)' == 'true'">
    <WarningsAsErrors>$(WarningsAsErrors);IL2026;IL2062;IL2065;IL2067;IL2069;IL2070;IL2072;IL2073;IL2075;IL2087;IL2090;IL2091;IL2111;IL3000;IL3050</WarningsAsErrors>
  </PropertyGroup>

  <!-- Prevent PublishAot from leaking into netstandard projects (e.g. Roslyn
       analyzers/generators) when passed as a global property. -->
  <PropertyGroup Condition="!$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net10.0'))">
    <PublishAot>false</PublishAot>
  </PropertyGroup>

  <!--
    Windows App SDK reference injection (centralized — see docs/specs/022 and
    Directory.Build.props / Directory.Packages.props).

    Windows App SDK 2.0 split the monolithic Microsoft.WindowsAppSDK metapackage
    into independently-versioned sub-packages. Reactor only needs the WinUI slice,
    which transitively brings Base + Foundation + InteractiveExperiences + WebView2
    (the bootstrapper, deployment manager, MRT Core and app-lifecycle MSBuild
    targets). The metapackage also aggregates AI / ML / Widgets / DWrite, which the
    repo never uses — so framework-dependent projects reference only
    Microsoft.WindowsAppSDK.WinUI and let the machine-wide installed
    Microsoft.WindowsAppRuntime.2 supply native bits (DWriteCore, etc.) at runtime.

    Projects that BUNDLE the native runtime keep the full metapackage, which carries
    the Runtime redist + DWriteCore: WindowsAppSDKSelfContained=true, or
    framework-dependent MSIX (WindowsPackageType=MSIX). A framework-dependent WinUI
    *executable* additionally needs Microsoft.WindowsAppSDK.Runtime — the SDK's
    Microsoft.WindowsAppSDK.Base.targets rejects a framework-dependent app that
    references neither Runtime nor WindowsAppSDKSelfContained. Libraries don't produce
    an app, so they take the lean WinUI reference alone.

    Evaluating the conditions here in .targets (a late import) means per-project
    OutputType / WindowsAppSDKSelfContained / WindowsPackageType values are already
    resolved — including the perf harnesses that flip WindowsAppSDKSelfContained to
    true only under -p:PerfCiSelfContained=true, a case a static per-csproj reference
    would classify wrong and ship broken.

    Gated on ManagePackageVersionsCentrally=true so it applies only to repo projects
    under central package management — never external consumers or the scaffolded
    template (bootstrap writes a CPM-off Directory.Packages.props to mimic a real
    consumer, and the shipped template pins Microsoft.WindowsAppSDK itself with an
    explicit version). Set ReactorSkipWinAppSDKInjection=true to opt a repo project
    out entirely.
  -->
  <PropertyGroup Condition="'$(UseWinUI)' == 'true'">
    <_ReactorWinAppSDKMetapackage>false</_ReactorWinAppSDKMetapackage>
    <_ReactorWinAppSDKMetapackage Condition="'$(WindowsAppSDKSelfContained)' == 'true' or '$(WindowsPackageType)' == 'MSIX'">true</_ReactorWinAppSDKMetapackage>
    <_ReactorWinAppSDKFrameworkDependentApp>false</_ReactorWinAppSDKFrameworkDependentApp>
    <_ReactorWinAppSDKFrameworkDependentApp Condition="'$(_ReactorWinAppSDKMetapackage)' != 'true' and ('$(OutputType)' == 'Exe' or '$(OutputType)' == 'WinExe')">true</_ReactorWinAppSDKFrameworkDependentApp>
  </PropertyGroup>

  <ItemGroup Condition="'$(UseWinUI)' == 'true' and '$(ManagePackageVersionsCentrally)' == 'true' and '$(ReactorSkipWinAppSDKInjection)' != 'true'">
    <PackageReference Include="Microsoft.WindowsAppSDK" Condition="'$(_ReactorWinAppSDKMetapackage)' == 'true'" />
    <PackageReference Include="Microsoft.WindowsAppSDK.WinUI" Condition="'$(_ReactorWinAppSDKMetapackage)' != 'true'" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Runtime" Condition="'$(_ReactorWinAppSDKFrameworkDependentApp)' == 'true'" />
  </ItemGroup>

</Project>
