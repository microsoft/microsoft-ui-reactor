---
// Windows 11 "bloom" art: translucent petals fanning out of one point on a
// deep background. Drawn in SVG so it scales with its box and needs no image
// files. It fills its positioned parent and is decorative only.
//
//   <div class="relative"><Bloom id="blog" variant="blue" /> ...</div>
//
// `id` must be unique on the page: it namespaces the gradient and filter ids.
// `turn` rotates the flower and `x`/`y` move its center (0-1 of the box), so
// several blooms of one color still look different.
import { BLOOMS, type BloomVariant } from "./bloom-palettes";

interface Props {
  id: string;
  variant?: BloomVariant;
  turn?: number;
  x?: number;
  y?: number;
  /** Petal size relative to the default (1). */
  scale?: number;
  class?: string;
}

const { id, variant = "blue", turn = 0, x = 0.72, y = 0.62, scale = 1, class: className } = Astro.props;
const palette = BLOOMS[variant];
const width = 800;
const height = 500;
const cx = width * x;
const cy = height * y;
const uid = `bloom-${id}`;

// Seven petals; each is an ellipse pushed out from the center and turned.
const petals = [
  { angle: -150, rx: 250, ry: 74, push: 170, tone: 2 },
  { angle: -112, rx: 270, ry: 86, push: 186, tone: 0 },
  { angle: -72, rx: 290, ry: 92, push: 196, tone: 1 },
  { angle: -34, rx: 270, ry: 84, push: 184, tone: 2 },
  { angle: 4, rx: 250, ry: 78, push: 172, tone: 0 },
  { angle: 42, rx: 230, ry: 70, push: 160, tone: 1 },
  { angle: 128, rx: 210, ry: 64, push: 150, tone: 0 },
];
---

<svg
  class:list={["pointer-events-none absolute inset-0 h-full w-full", className]}
  viewBox={`0 0 ${width} ${height}`}
  preserveAspectRatio="xMidYMid slice"
  aria-hidden="true"
  focusable="false"
>
  <defs>
    <linearGradient id={`${uid}-bg`} x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color={palette.background[0]} />
      <stop offset="1" stop-color={palette.background[1]} />
    </linearGradient>
    {
      palette.petals.map((stops, index) => (
        <linearGradient id={`${uid}-p${index}`} x1="0" y1="0.5" x2="1" y2="0.5">
          <stop offset="0" stop-color={stops[1]} stop-opacity="0.15" />
          <stop offset="0.55" stop-color={stops[1]} stop-opacity="0.9" />
          <stop offset="1" stop-color={stops[0]} stop-opacity="1" />
        </linearGradient>
      ))
    }
    <radialGradient id={`${uid}-glow`}>
      <stop offset="0" stop-color={palette.glow} stop-opacity="0.75" />
      <stop offset="1" stop-color={palette.glow} stop-opacity="0" />
    </radialGradient>
    <filter id={`${uid}-soft`} x="-20%" y="-20%" width="140%" height="140%">
      <feGaussianBlur stdDeviation="6" />
    </filter>
    <filter id={`${uid}-haze`} x="-50%" y="-50%" width="200%" height="200%">
      <feGaussianBlur stdDeviation="34" />
    </filter>
  </defs>
  <rect width={width} height={height} fill={`url(#${uid}-bg)`} />
  <ellipse cx={cx} cy={cy} rx={360 * scale} ry={300 * scale} fill={`url(#${uid}-glow)`} />
  <g transform={`translate(${cx} ${cy}) rotate(${turn}) scale(${scale})`}>
    <g filter={`url(#${uid}-haze)`} opacity="0.55">
      {
        petals.map((petal) => (
          <ellipse
            rx={petal.rx}
            ry={petal.ry}
            fill={`url(#${uid}-p${petal.tone})`}
            transform={`rotate(${petal.angle}) translate(${petal.push} 0)`}
          />
        ))
      }
    </g>
    <g filter={`url(#${uid}-soft)`} style="mix-blend-mode: screen">
      {
        petals.map((petal) => (
          <ellipse
            rx={petal.rx}
            ry={petal.ry}
            fill={`url(#${uid}-p${petal.tone})`}
            opacity="0.78"
            transform={`rotate(${petal.angle}) translate(${petal.push} 0)`}
          />
        ))
      }
    </g>
    <circle r="26" fill={palette.glow} opacity="0.35" filter={`url(#${uid}-haze)`} />
  </g>
</svg>
