---
// The site's home page. A custom page at `/` wins over any docs page there.
// The Guides, Controls, Recipes, API reference and How it works lists are read
// from the navigation tree (nav.json), so they follow the docs when pages move.
import data from "blume:data";
import CodeBlock from "blume/components/content/CodeBlock.astro";
import Icon from "blume/components/Icon.astro";
import { stripBase, withBase } from "blume/components/islands/base-path.ts";
import PageLayout from "blume/components/layout/PageLayout.astro";

import Bloom from "../components/Bloom.astro";
import { BLOOMS } from "../components/bloom-palettes";
import { SHOWCASE_APPS } from "../components/showcase-apps";
import codeIcon from "../components/fluent/code_24_regular.svg?raw";
import contentViewIcon from "../components/fluent/content_view_24_regular.svg?raw";
import syncIcon from "../components/fluent/arrow_sync_24_regular.svg?raw";

const { config, navigation, fontCssVars } = data;

type NavNode = (typeof navigation.sidebar)[number];
type NavGroup = Extract<NavNode, { kind: "group" }>;
type NavPage = Extract<NavNode, { kind: "page" }>;

const base = import.meta.env.BASE_URL ?? "/";
const logical = (route: string | undefined) => (route ? stripBase(base, route) : undefined);

const findGroup = (nodes: NavNode[], path: string): NavGroup | undefined => {
  for (const node of nodes) {
    if (node.kind !== "group") continue;
    if (logical(node.path) === path || logical(node.route) === path) return node;
    const nested = findGroup(node.children, path);
    if (nested) return nested;
  }
  return undefined;
};

const section = (path: string): NavGroup => {
  const group = findGroup(navigation.sidebar, path);
  if (!group) throw new Error(`Home page: nav.json has no section at ${path}.`);
  return group;
};

const pagesIn = (node: NavNode): NavPage[] =>
  node.kind === "page" ? [node] : node.children.flatMap(pagesIn);

// A section's pages, without the section's own index page.
const pagesOf = (group: NavGroup) =>
  pagesIn(group).filter((page) => logical(page.route) !== logical(group.route ?? group.path));

// A section's sub-groups, each with its pages.
const subsections = (group: NavGroup) =>
  group.children
    .filter((child): child is NavGroup => child.kind === "group")
    .map((child) => ({ label: child.label, pages: pagesIn(child) }));

const href = (route: string) => withBase(route);

const guides = subsections(section("/guides"));
const internals = subsections(section("/how-it-works"));
const controls = pagesOf(section("/controls"));
const recipes = pagesOf(section("/recipes"));
const featuredHooks = ["UseState", "UseEffect", "UseReducer", "UseMemo", "UseContext", "UseResource", "UseNavigation", "UsePersisted"];
const hookPages = pagesOf(section("/reference"));
const hooks = featuredHooks
  .map((name) => hookPages.find((page) => page.label === name))
  .filter((page): page is NavPage => page !== undefined);
const firstInternal = internals[0]?.pages[0];

const blogPost = {
  title: "Microsoft.UI.Reactor: a C#-first way to build WinUI apps",
  summary: "No XAML, no code-behind, no view models. Just C#.",
  date: "Oct 21, 2026",
  dateTime: "2026-10-21",
  image: "/blog/reactor-part-1.webp",
  url: "https://devblogs.microsoft.com/ifdef-windows/microsoft-ui-reactor-a-c-first-way-to-build-winui-apps/",
};

const quickstart = `winget install Microsoft.WinAppCli
winapp new -t reactor -n MyApp
cd MyApp
dotnet run`;

const counter = `class Counter : Component
{
    public override Element Render()
    {
        var (count, setCount) = UseState(0);

        return HStack(8,
            Button("- 1", () => setCount(count - 1)),
            TextBlock($"{count}").FontSize(20).SemiBold(),
            Button("+ 1", () => setCount(count + 1))
        ).Padding(24);
    }
}`;

const facts: { title: string; text: string; icon?: string; image?: string }[] = [
  {
    title: "Native WinUI 3",
    text: "Every element is a real WinUI\u00a03 control, with Fluent styling and accessibility built in. No web view, no Electron.",
    image: "/brand/winui.svg",
  },
  { title: "Pure C#", text: "No XAML, no data binding, no view models. Your UI is code you can step through.", icon: codeIcon },
  { title: "Declarative", text: "Describe the UI for the current state. Reactor works out what changed.", icon: contentViewIcon },
  { title: "Hooks for state", text: "UseState, UseEffect, UseReducer and more keep state next to the UI that uses it.", icon: syncIcon },
];

const startHere = [
  { title: "Overview", text: "What Reactor is, and when to use it.", route: "/get-started" },
  { title: "Coming from XAML", text: "Map XAML, bindings and code-behind to Reactor.", route: "/get-started/xaml-developers" },
  { title: "Reactor vs XAML", text: "Why Reactor is designed the way it is.", route: "/get-started/reactor-vs-xaml" },
  { title: "Cheat sheet", text: "The whole framework on one page.", route: "/get-started/cheat-sheet" },
  { title: "Rules of Reactor", text: "The rules the render loop relies on, and the analyzers that check them.", route: "/get-started/rules-of-reactor" },
];

const pipeline = [
  { name: "Render()", text: "Your component returns a tree of elements." },
  { name: "Element tree", text: "Immutable C# records. Cheap to create and compare." },
  { name: "Reconciler", text: "Diffs the new tree against the last one." },
  { name: "WinUI controls", text: "Only the changed properties are set on real controls." },
];

const showcaseIcons = SHOWCASE_APPS.slice(0, 6);
const showcaseShots = SHOWCASE_APPS.flatMap((app) => (app.featured && app.screenshot ? [app.screenshot] : [])).slice(0, 2);
const [frontShot, backShot] = showcaseShots;
---

<PageLayout
  site={{ title: config.title, description: config.description }}
  logo={config.logo}
  banner={config.banner}
  navigation={navigation}
  fontCssVars={fontCssVars}
  favicon={config.favicon}
  appleIcon={config.appleIcon}
  themeMode={config.theme.mode}
  searchEnabled={config.search.enabled}
  page={{
    title: "Reactor: native Windows apps in pure C#",
    description:
      "Build native Windows apps with WinUI 3, in pure C#. No XAML, no data binding, no view models. Describe your UI as a function of state, and Reactor keeps the WinUI controls in sync.",
    route: "/",
  }}
>
  <div class="mx-auto max-w-6xl px-4 pb-24 pt-10 sm:px-6 sm:pt-16 lg:px-8">
    <!-- What Reactor is -->
    <section aria-labelledby="intro-title">
      <div class="max-w-3xl">
        <a
          href={blogPost.url}
          class="group flex max-w-2xl items-center gap-3 rounded-2xl border border-border bg-background p-2 pr-4 text-foreground shadow-[0_1px_2px_rgb(0_0_0/0.05)] transition-colors hover:bg-muted focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent sm:gap-4 sm:pr-5"
        >
          <img
            src={href(blogPost.image)}
            width="768"
            height="403"
            alt=""
            decoding="async"
            class="h-16 w-[122px] shrink-0 rounded-xl bg-muted object-cover sm:h-[84px] sm:w-40"
          />
          <span class="min-w-0 flex-1">
            <span class="flex items-center gap-2 text-xs text-muted-foreground">
              <span
                class="shrink-0 rounded-full px-2 py-0.5 font-semibold text-white"
                style={`background: linear-gradient(110deg, ${BLOOMS.blue.ink}, ${BLOOMS.violet.ink})`}
              >
                Blog
              </span>
              <span class="truncate">Latest post · <time datetime={blogPost.dateTime}>{blogPost.date}</time></span>
            </span>
            <span class="mt-1.5 line-clamp-2 text-[15px] font-semibold leading-snug sm:line-clamp-1 sm:text-base">{blogPost.title}</span>
            <span class="mt-0.5 hidden truncate text-sm text-muted-foreground sm:block">{blogPost.summary}</span>
          </span>
          <Icon name="arrow-up-right" size={16} class="hidden shrink-0 text-muted-foreground transition-transform group-hover:text-foreground motion-safe:group-hover:-translate-y-px motion-safe:group-hover:translate-x-px sm:block" />
        </a>
        <h1 id="intro-title" class="mt-8 font-display text-4xl font-semibold tracking-tight text-balance text-foreground sm:text-5xl lg:text-6xl">
          <span class="sm:whitespace-nowrap">Native Windows apps,</span> in pure C#.
        </h1>
        <p class="mt-5 max-w-[62ch] text-lg leading-relaxed text-muted-foreground">
          Reactor is a declarative UI framework for building native Windows apps with WinUI&nbsp;3. Write your UI in C#,
          with no XAML, no data binding and no view models. Describe it as a function of state, and Reactor keeps the
          WinUI controls in sync.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a
            href={href("/get-started/quickstart")}
            class="inline-flex h-11 items-center gap-2 rounded-full bg-foreground px-5 text-sm font-medium text-background transition-opacity hover:opacity-85 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
          >
            Get started
            <Icon name="arrow-right" size={16} />
          </a>
          <a
            href={href("/get-started/xaml-developers")}
            class="inline-flex h-11 items-center rounded-full border border-border px-5 text-sm font-medium text-foreground transition-colors hover:bg-muted focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
          >
            Coming from XAML
          </a>
        </div>
        <p class="mt-6 text-sm text-muted-foreground">
          Built on <span class="font-medium text-foreground">WinUI&nbsp;3</span>,{" the "}
          <span class="font-medium text-foreground">Windows App SDK</span>{" and "}
          <span class="font-medium text-foreground">.NET&nbsp;10</span>. Runs on Windows&nbsp;10 and Windows&nbsp;11.
        </p>
      </div>

      <div class="mt-12 grid overflow-hidden rounded-3xl border border-border lg:grid-cols-[1.1fr_1fr]">
        <div class="min-w-0 bg-muted/40 p-3 sm:p-5 [&_.prose]:my-0 [&_figure]:my-0 [&_pre]:my-0">
          <CodeBlock code={counter} lang="csharp" title="Counter.cs" />
        </div>
        <div class="relative isolate grid min-h-[340px] place-items-center p-6 sm:p-10" data-counter>
          <Bloom variant="blue" flipX />
          <div class="relative w-full max-w-[340px]">
            <div
              class="winui-window overflow-hidden rounded-lg bg-[#f3f3f3] text-[#1b1b1b] shadow-[0_32px_64px_-12px_rgb(0_0_0/0.55)] ring-1 ring-black/10 dark:bg-[#202020] dark:text-white dark:ring-white/10"
              role="group"
              aria-label="Preview of the Counter app"
            >
              <div class="flex h-8 items-center justify-between text-xs">
                <span class="flex items-center gap-2 pl-3">
                  <span class="grid size-4 place-items-center rounded-[4px] bg-[#0067c0] text-white" aria-hidden="true">
                    <Icon name="app-window" size={11} />
                  </span>
                  Counter
                </span>
                <span class="flex text-[#1b1b1b]/70 dark:text-white/70" aria-hidden="true">
                  <span class="grid h-8 w-11 place-items-center"><Icon name="minus" size={14} /></span>
                  <span class="grid h-8 w-11 place-items-center"><Icon name="square" size={11} /></span>
                  <span class="grid h-8 w-11 place-items-center"><Icon name="x" size={14} /></span>
                </span>
              </div>
              <div class="flex items-center justify-center gap-2 px-6 pb-10 pt-8">
                <button type="button" class="winui-button" data-step="-1">- 1</button>
                <output class="counter-value min-w-12 rounded px-2 text-center text-xl font-semibold tabular-nums" data-count aria-live="polite">0</output>
                <button type="button" class="winui-button" data-step="1">+ 1</button>
              </div>
            </div>
            <p class="mx-auto mt-4 w-fit rounded-full bg-black/60 px-3 py-1 text-center font-mono text-xs text-white" data-status>Render #1 · mounted 4 controls</p>
          </div>
        </div>
      </div>

      <ul class="mt-12 grid gap-x-8 gap-y-8 sm:grid-cols-2 lg:grid-cols-4">
        {
          facts.map((fact) => (
            <li class="border-t border-border pt-5">
              <span
                class="grid size-10 place-items-center rounded-xl bg-muted text-foreground ring-1 ring-inset ring-border [&_svg]:size-6 [&_svg]:fill-current"
                aria-hidden="true"
              >
                {fact.image ? <img src={href(fact.image)} width="24" height="24" alt="" class="size-6" /> : <Fragment set:html={fact.icon} />}
              </span>
              <h2 class="mt-4 text-sm font-semibold text-foreground">{fact.title}</h2>
              <p class="mt-1.5 text-sm leading-relaxed text-muted-foreground">{fact.text}</p>
            </li>
          ))
        }
      </ul>
    </section>

    <!-- Get started -->
    <section class="mt-24 sm:mt-32" aria-labelledby="get-started-title">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <h2 id="get-started-title" class="font-display text-2xl font-semibold tracking-tight text-foreground sm:text-3xl">Get started</h2>
        <a href={href("/get-started")} class="inline-flex items-center gap-1 text-sm font-medium text-foreground hover:underline">
          All get started pages <Icon name="arrow-right" size={14} />
        </a>
      </div>
      <div class="mt-8 grid gap-6 lg:grid-cols-[1.2fr_1fr] lg:gap-10">
        <div class="relative isolate overflow-hidden rounded-3xl text-white">
          <Bloom variant="teal" flipY />
          <div class="absolute inset-0 bg-gradient-to-r from-black/50 via-black/20 to-transparent" aria-hidden="true"></div>
          <div class="relative p-6 sm:p-8">
            <h3 class="font-display text-xl font-semibold">Quickstart</h3>
            <p class="mt-2 max-w-[52ch] text-white/80">
              Install the tools, create an app and run it. Then grow it into a todo list and a calculator.
            </p>
            <div class="code-on-dark mt-6 [&_.prose]:my-0 [&_figure]:my-0 [&_pre]:my-0!">
              <CodeBlock code={quickstart} lang="powershell" />
            </div>
            <a
              href={href("/get-started/quickstart")}
              class="mt-6 inline-flex h-10 items-center gap-1.5 rounded-full bg-white px-4 text-sm font-medium text-[#031619] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white"
            >
              Read the quickstart
              <Icon name="arrow-right" size={16} />
            </a>
          </div>
        </div>
        <ul class="divide-y divide-border border-y border-border">
          {
            startHere.map((item) => (
              <li>
                <a href={href(item.route)} class="group flex items-center justify-between gap-6 py-4">
                  <span>
                    <span class="block font-medium text-foreground">{item.title}</span>
                    <span class="mt-0.5 block text-sm text-muted-foreground">{item.text}</span>
                  </span>
                  <Icon name="arrow-right" size={16} class="shrink-0 text-muted-foreground transition-transform group-hover:text-foreground motion-safe:group-hover:translate-x-0.5" />
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <!-- Showcase -->
    <section class="mt-24 sm:mt-32" aria-labelledby="showcase-title">
      <a
        href={href("/showcase")}
        class="group relative isolate grid overflow-hidden rounded-3xl text-white focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent lg:grid-cols-[1fr_1.15fr]"
      >
        <Bloom variant="violet" class="transition-transform duration-700 ease-out motion-safe:group-hover:scale-[1.03]" />
        <div class="absolute inset-0 bg-gradient-to-b from-black/45 via-black/15 to-transparent lg:bg-gradient-to-r lg:from-black/50 lg:via-black/15" aria-hidden="true"></div>
        <div class="relative flex flex-col justify-center p-7 sm:p-10 lg:py-14">
          <ul class="flex -space-x-2" aria-hidden="true">
            {
              showcaseIcons.map((app) => (
                <li
                  class="grid size-11 place-items-center rounded-xl bg-white shadow-[0_8px_20px_-8px_rgb(0_0_0/0.7)] ring-2 ring-black/50"
                  style={`color: ${BLOOMS[app.bloom].ink}`}
                >
                  <Icon name={app.icon} size={20} />
                </li>
              ))
            }
          </ul>
          <h2 id="showcase-title" class="mt-7 font-display text-2xl font-semibold tracking-tight sm:text-3xl">Showcase</h2>
          <p class="mt-3 max-w-[44ch] text-white/85">
            Apps built with Reactor, from a registry editor to a docking IDE. Each one is open source, so you can read how it works.
          </p>
          <span class="mt-7 inline-flex h-10 w-fit items-center gap-1.5 rounded-full bg-white px-4 text-sm font-medium text-[#1a0b4d]">
            See the apps
            <Icon name="arrow-right" size={16} class="transition-transform motion-safe:group-hover:translate-x-0.5" />
          </span>
        </div>
        <div class="relative h-56 sm:h-80 lg:h-auto lg:min-h-[400px]" aria-hidden="true">
          {
            backShot && (
              <div class="absolute left-[16%] top-[12%] w-[86%] overflow-hidden rounded-t-[10px] bg-white shadow-[0_24px_60px_-20px_rgb(0_0_0/0.55)] ring-1 ring-black/10 transition-transform duration-500 ease-out motion-safe:group-hover:-translate-y-1 lg:top-[9%]">
                <img src={href(backShot.src)} width={backShot.width} height={backShot.height} alt="" loading="lazy" decoding="async" class="block h-auto w-full" />
              </div>
            )
          }
          {
            frontShot && (
              <div class="absolute left-[4%] top-[30%] w-[86%] overflow-hidden rounded-t-[10px] bg-white shadow-[0_28px_70px_-18px_rgb(0_0_0/0.65)] ring-1 ring-black/10 transition-transform duration-500 ease-out motion-safe:group-hover:-translate-y-1.5 lg:left-[2%] lg:top-[25%]">
                <img src={href(frontShot.src)} width={frontShot.width} height={frontShot.height} alt="" loading="lazy" decoding="async" class="block h-auto w-full" />
              </div>
            )
          }
        </div>
      </a>
    </section>

    <!-- Guides -->
    <section class="mt-24 sm:mt-32" aria-labelledby="guides-title">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <div>
          <h2 id="guides-title" class="font-display text-2xl font-semibold tracking-tight text-foreground sm:text-3xl">Guides</h2>
          <p class="mt-2 max-w-[60ch] text-muted-foreground">Everything you need to build, polish and ship a real app.</p>
        </div>
        <a href={href("/guides")} class="inline-flex items-center gap-1 text-sm font-medium text-foreground hover:underline">
          All guides <Icon name="arrow-right" size={14} />
        </a>
      </div>
      <div class="mt-10 grid gap-x-10 gap-y-10 sm:grid-cols-2 lg:grid-cols-3">
        {
          guides.map((group) => (
            <div>
              <h3 class="text-sm font-semibold text-foreground">{group.label}</h3>
              <ul class="mt-3 space-y-2 text-sm">
                {group.pages.map((page) => (
                  <li>
                    <a href={href(page.route)} class="text-muted-foreground transition-colors hover:text-foreground">
                      {page.label}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </section>

    <!-- Controls, recipes, API reference -->
    <section class="mt-24 grid gap-5 sm:mt-32 lg:grid-cols-3" aria-label="Controls, recipes and API reference">
      <div class="flex flex-col overflow-hidden rounded-3xl border border-border">
        <a href={href("/controls")} class="group relative isolate block h-28 overflow-hidden">
          <Bloom variant="amber" class="transition-transform duration-700 motion-safe:group-hover:scale-105" />
          <span class="sr-only">Controls</span>
        </a>
        <div class="flex flex-1 flex-col p-6">
          <h2 class="font-display text-lg font-semibold text-foreground">
            <a href={href("/controls")} class="hover:underline">Controls</a>
          </h2>
          <p class="mt-1.5 text-sm text-muted-foreground">Every WinUI control as a C# factory, grouped by what it does.</p>
          <ul class="mt-5 flex flex-wrap gap-2">
            {
              controls.map((page) => (
                <li>
                  <a href={href(page.route)} class="inline-flex rounded-full border border-border px-3 py-1 text-xs text-foreground transition-colors hover:bg-muted">
                    {page.label}
                  </a>
                </li>
              ))
            }
          </ul>
          <a href={href("/controls")} class="mt-auto inline-flex items-center gap-1 pt-5 text-sm font-medium text-foreground hover:underline">
            All controls <Icon name="arrow-right" size={14} />
          </a>
        </div>
      </div>

      <div class="flex flex-col overflow-hidden rounded-3xl border border-border">
        <a href={href("/recipes")} class="group relative isolate block h-28 overflow-hidden">
          <Bloom variant="green" flipX class="transition-transform duration-700 motion-safe:group-hover:scale-105" />
          <span class="sr-only">Recipes</span>
        </a>
        <div class="flex flex-1 flex-col p-6">
          <h2 class="font-display text-lg font-semibold text-foreground">
            <a href={href("/recipes")} class="hover:underline">Recipes</a>
          </h2>
          <p class="mt-1.5 text-sm text-muted-foreground">Complete, copyable answers to common UI tasks.</p>
          <ul class="mt-4 divide-y divide-border text-sm">
            {
              recipes.map((page) => (
                <li>
                  <a href={href(page.route)} class="flex items-center justify-between py-2 text-foreground hover:underline">
                    {page.label}
                  </a>
                </li>
              ))
            }
          </ul>
          <a href={href("/recipes")} class="mt-auto inline-flex items-center gap-1 pt-5 text-sm font-medium text-foreground hover:underline">
            All recipes <Icon name="arrow-right" size={14} />
          </a>
        </div>
      </div>

      <div class="flex flex-col overflow-hidden rounded-3xl border border-border">
        <a href={href("/reference")} class="group relative isolate block h-28 overflow-hidden">
          <Bloom variant="rose" flipY class="transition-transform duration-700 motion-safe:group-hover:scale-105" />
          <span class="sr-only">API reference</span>
        </a>
        <div class="flex flex-1 flex-col p-6">
          <h2 class="font-display text-lg font-semibold text-foreground">
            <a href={href("/reference")} class="hover:underline">API reference</a>
          </h2>
          <p class="mt-1.5 text-sm text-muted-foreground">Signatures and examples for every hook.</p>
          <ul class="mt-5 flex flex-wrap gap-2">
            {
              hooks.map((page) => (
                <li>
                  <a href={href(page.route)} class="inline-flex rounded-md bg-muted px-2 py-1 font-mono text-xs text-foreground transition-colors hover:bg-muted/60">
                    {page.label}
                  </a>
                </li>
              ))
            }
          </ul>
          <a href={href("/reference/hooks")} class="mt-auto inline-flex items-center gap-1 pt-5 text-sm font-medium text-foreground hover:underline">
            All hooks <Icon name="arrow-right" size={14} />
          </a>
        </div>
      </div>
    </section>

    <!-- How it works -->
    <section class="mt-24 overflow-hidden rounded-3xl bg-[#0b0d12] p-6 text-white ring-1 ring-white/10 sm:mt-32 sm:p-10 lg:p-12" aria-labelledby="how-title">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <div>
          <h2 id="how-title" class="font-display text-2xl font-semibold tracking-tight sm:text-3xl">How it works</h2>
          <p class="mt-2 max-w-[60ch] text-white/70">
            Reactor keeps a tree of plain C# records, compares it on every render, and patches only the WinUI controls that changed.
          </p>
        </div>
        {
          firstInternal && (
            <a href={href(firstInternal.route)} class="inline-flex items-center gap-1 text-sm font-medium text-white hover:underline">
              Start with {firstInternal.label.toLowerCase()} <Icon name="arrow-right" size={14} />
            </a>
          )
        }
      </div>

      <ol class="mt-10 grid gap-3 lg:grid-cols-[1fr_auto_1fr_auto_1fr_auto_1fr] lg:items-stretch">
        {
          pipeline.map((step, index) => (
            <>
              <li class="rounded-2xl bg-white/[0.06] p-4 ring-1 ring-white/10">
                <span class="font-mono text-sm text-[#8cc8ff]">{step.name}</span>
                <p class="mt-1.5 text-sm text-white/70">{step.text}</p>
              </li>
              {index < pipeline.length - 1 && (
                <li class="grid place-items-center text-white/40" aria-hidden="true">
                  <Icon name="arrow-right" size={18} class="rotate-90 lg:rotate-0" />
                </li>
              )}
            </>
          ))
        }
      </ol>

      <div class="mt-12 grid gap-x-10 gap-y-10 border-t border-white/10 pt-10 sm:grid-cols-2 lg:grid-cols-4">
        {
          internals.map((group) => (
            <div>
              <h3 class="text-sm font-semibold">{group.label}</h3>
              <ul class="mt-3 space-y-2 text-sm">
                {group.pages.map((page) => (
                  <li>
                    <a href={href(page.route)} class="text-white/70 transition-colors hover:text-white">
                      {page.label}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </section>
  </div>
</PageLayout>

<style>
  /* The Quickstart tile is dark in both themes, so its code always uses the dark Shiki colors. */
  .code-on-dark {
    --blume-foreground: #e6edf3;
    --blume-muted-foreground: rgb(255 255 255 / 0.72);
    --blume-border: rgb(255 255 255 / 0.2);
  }

  .code-on-dark :global(pre.astro-code),
  .code-on-dark :global(pre.astro-code span) {
    color: var(--shiki-dark, inherit) !important;
  }

  .winui-window {
    font-family: "Segoe UI Variable Text", "Segoe UI", system-ui, sans-serif;
  }

  .winui-button {
    height: 2rem;
    min-width: 3.5rem;
    padding: 0 0.75rem;
    border-radius: 0.25rem;
    font-size: 0.875rem;
    background: #fdfdfd;
    border: 1px solid rgb(0 0 0 / 0.06);
    border-bottom-color: rgb(0 0 0 / 0.16);
    color: inherit;
    cursor: pointer;
  }

  .winui-button:hover {
    background: #f6f6f6;
  }

  .winui-button:active {
    background: #f5f5f5;
    color: rgb(0 0 0 / 0.62);
    border-bottom-color: rgb(0 0 0 / 0.06);
  }

  .winui-button:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 1px;
  }

  :global([data-theme="dark"]) .winui-button {
    background: #2d2d2d;
    border-color: rgb(255 255 255 / 0.07);
    border-top-color: rgb(255 255 255 / 0.09);
  }

  :global([data-theme="dark"]) .winui-button:hover {
    background: #323232;
  }

  :global([data-theme="dark"]) .winui-button:active {
    background: #272727;
    color: rgb(255 255 255 / 0.78);
  }

  /* The devtools "highlight updates" outline, on the one control that changed. */
  @media (prefers-reduced-motion: no-preference) {
    .counter-value.is-updated {
      animation: updated 700ms ease-out;
    }
  }

  @keyframes updated {
    from {
      box-shadow: 0 0 0 2px #0067c0;
      background: rgb(0 103 192 / 0.12);
    }
    to {
      box-shadow: 0 0 0 2px rgb(0 103 192 / 0);
      background: rgb(0 103 192 / 0);
    }
  }
</style>

<script>
  const setUp = () => {
    for (const root of document.querySelectorAll<HTMLElement>("[data-counter]")) {
      if (root.dataset.ready) continue;
      root.dataset.ready = "true";

      const value = root.querySelector<HTMLElement>("[data-count]");
      const status = root.querySelector<HTMLElement>("[data-status]");
      if (!value || !status) continue;

      let count = 0;
      let renders = 1;
      for (const button of root.querySelectorAll<HTMLButtonElement>("[data-step]")) {
        button.addEventListener("click", () => {
          count += Number(button.dataset.step);
          renders += 1;
          value.textContent = String(count);
          status.textContent = `Render #${renders} · set TextBlock.Text = "${count}"`;
          value.classList.remove("is-updated");
          void value.offsetWidth;
          value.classList.add("is-updated");
        });
      }
    }
  };

  document.addEventListener("astro:page-load", setUp);
</script>
