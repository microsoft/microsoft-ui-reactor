<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <Platforms>x64;ARM64</Platforms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\..\..\src\Reactor\Reactor.csproj" />
    <!-- The devtools snippet calls ReactorDevtools.EnsureRegistered(). The shared
         apps/Directory.Build.props adds this reference in Debug only; add it for the
         other configurations so the Release build used by the docs compile also works. -->
    <ProjectReference Include="..\..\..\..\src\Reactor.Devtools\Reactor.Devtools.csproj"
                      Condition="'$(Configuration)' != 'Debug'" />
  </ItemGroup>
</Project>
