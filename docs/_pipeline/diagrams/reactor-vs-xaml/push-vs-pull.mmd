%% Pull-based XAML binding vs push-from-state Reactor render. The XAML
%% path threads through DependencyProperty.SetValue → BindingExpression
%% UpdateTarget → control DP. The Reactor path threads through setter →
%% slot → render → reconciler property write. Default Mermaid palette
%% renders legibly on both light and dark GitHub themes.
flowchart TB
    subgraph XAML["XAML — pull-based binding"]
        direction LR
        VMProp["VM property setter"]
        INPC["raise PropertyChanged"]
        BX["BindingExpression"]
        Reader["read VM getter"]
        DP["Control DependencyProperty"]
        VMProp --> INPC
        INPC --> BX
        BX --> Reader
        Reader --> DP
    end

    subgraph Reactor["Reactor — push from state"]
        direction LR
        Setter["UseState setter"]
        Slot["Hook slot<br/>(RenderContext)"]
        Render["Component.Render()"]
        ElementTree["Element tree"]
        Recon["Reconciler.Update<br/>property write"]
        Ctrl["WinUI control"]
        Setter --> Slot
        Slot --> Render
        Render --> ElementTree
        ElementTree --> Recon
        Recon --> Ctrl
    end
