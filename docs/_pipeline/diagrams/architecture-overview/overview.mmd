%% Reactor render loop. State change → component re-render → element
%% record tree → reconciler diff → element pool reuse → WinUI control
%% tree → composition → frame. Light/dark legible (default Mermaid
%% palette satisfies both GitHub themes).
flowchart LR
    State[State / hook setter]
    Component[Component.Render]
    Elements[Element record tree]
    Reconciler[Reconciler<br/>diff &amp; commit]
    Pool[ElementPool<br/>rent / return]
    WinUI[WinUI control tree]
    Comp[Composition layer]
    Frame[Frame to screen]

    State -->|setState| Component
    Component -->|describe UI| Elements
    Elements -->|old vs new| Reconciler
    Reconciler -->|rent reused control| Pool
    Pool --> WinUI
    Reconciler -->|property writes| WinUI
    WinUI --> Comp
    Comp --> Frame
