%% Positional hook slot table held by RenderContext. BeginRender
%% resets _hookIndex; every hook call reads or creates the slot at
%% _hookIndex and advances. Slot type mismatch throws
%% HookOrderException — that's why hook rules require call order
%% stability. Default Mermaid palette renders legibly on both light
%% and dark GitHub themes.
flowchart LR
    Begin["BeginRender<br/>_hookIndex = 0"]
    H0["Slot 0<br/>ValueHookState&lt;int&gt;<br/>(UseState count)"]
    H1["Slot 1<br/>EffectHookState<br/>(UseEffect deps)"]
    H2["Slot 2<br/>MemoHookState&lt;Sorted&gt;<br/>(UseMemo deps)"]
    H3["Slot 3<br/>RefHookState&lt;ElementRef&gt;<br/>(UseElementRef)"]
    Render["Render returns Element"]
    Flush["FlushEffects<br/>cleanups → bodies"]
    Mismatch["HookOrderException<br/>(slot type ≠ expected)"]

    Begin --> H0
    H0 -->|advance| H1
    H1 -->|advance| H2
    H2 -->|advance| H3
    H3 --> Render
    Render --> Flush
    H0 -.->|type mismatch| Mismatch
    H1 -.->|type mismatch| Mismatch
    H2 -.->|type mismatch| Mismatch
    H3 -.->|type mismatch| Mismatch
