%% modifier-system: a fluent chain folds into Element.Modifiers via
%% ElementModifiers.Merge. The concrete element type stays preserved so
%% .Set() still gets the strongly-typed control.
flowchart LR
    Start["Text(&quot;hi&quot;)<br/>TextBlockElement"] -->|.Bold| M1["TextBlockElement<br/>Modifiers = { FontWeight }"]
    M1 -->|.Margin(8)| M2["TextBlockElement<br/>Modifiers.Merge({ Margin })"]
    M2 -->|.Background(Theme.Accent)| M3["TextBlockElement<br/>ThemeBindings[&quot;Background&quot;]"]
    M3 -->|.Grid(row: 1)| M4["TextBlockElement<br/>Attached[GridAttached]"]
    M4 -->|.Set(tb =&gt; tb.TextWrapping = …)| M5["TextBlockElement<br/>+ Set callback"]
    M5 --> Reconciler["Reconciler reads Modifiers,<br/>ThemeBindings, Attached on commit"]
