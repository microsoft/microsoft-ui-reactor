%% XAML developer's mental model on the left, Reactor's on the right.
%% Highlights the moves XAML readers most often look for when reading
%% Reactor code for the first time: bindings collapse into state,
%% DataContext disappears, code-behind merges into Render(). Default
%% Mermaid palette renders legibly on both light and dark GitHub themes.
flowchart LR
    subgraph XAML["XAML page"]
        direction TB
        Markup["MyPage.xaml<br/>(controls + bindings)"]
        Cb["MyPage.xaml.cs<br/>(code-behind)"]
        VM["MyPageViewModel<br/>(INPC properties + ICommand)"]
        Conv["Value converters"]
        Markup -- "DataContext" --> VM
        Markup -- "x:Name refs" --> Cb
        Markup -- "{Binding}" --> Conv
    end

    subgraph Reactor["Reactor component"]
        direction TB
        Render["public override Element Render()"]
        Hooks["UseState / UseReducer / UseEffect"]
        Inline["plain C# expressions<br/>(no converters)"]
        Render --> Hooks
        Render --> Inline
    end

    XAML -. "translate" .-> Reactor
