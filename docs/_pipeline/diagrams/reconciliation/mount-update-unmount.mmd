%% Reconciler tri-state dispatch — Mount / Update / Unmount. Default
%% Mermaid palette renders legibly on both light and dark GitHub
%% themes.
flowchart TB
    Entry["Reconciler.Reconcile<br/>(oldEl, newEl, existingControl)"]
    NullNew{"newEl is null<br/>or EmptyElement?"}
    NullOld{"oldEl is null<br/>or no existing control?"}
    Unmount["Unmount path"]
    Mount["Mount path"]
    PoolRent["ElementPool.TryRent<br/>(poolable types only)"]
    Alloc["new TControl(…)"]
    MountSwitch["MountXxx switch<br/>(40+ handlers)"]
    Update["Update path"]
    CanUpdate{"CanUpdate(old, new)?"}
    UpdateSwitch["UpdateXxx switch<br/>property writes only"]
    Children["ChildReconciler<br/>keyed (prefix/suffix + LIS)<br/>or positional"]
    Replace["Unmount-then-Mount<br/>(type changed)"]
    Cleanup["FlushEffectCleanups"]
    PoolReturn["ElementPool.Return"]
    Done["Return UIElement"]

    Entry --> NullNew
    NullNew -- yes --> Unmount
    NullNew -- no --> NullOld
    NullOld -- yes --> Mount
    NullOld -- no --> Update
    Mount --> PoolRent
    PoolRent -- hit --> MountSwitch
    PoolRent -- miss --> Alloc
    Alloc --> MountSwitch
    MountSwitch --> Done
    Update --> CanUpdate
    CanUpdate -- true --> UpdateSwitch
    UpdateSwitch --> Children
    Children --> Done
    CanUpdate -- false --> Replace
    Replace --> Mount
    Unmount --> Cleanup
    Cleanup --> PoolReturn
