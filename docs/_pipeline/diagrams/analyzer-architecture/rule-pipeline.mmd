%% Reactor analyzer rule pipeline. Each registered SyntaxKind action runs
%% on every InvocationExpression in the compilation; the analyzers stack
%% cheap syntactic gates before paying for SemanticModel work, then route
%% confirmed violations to ReportDiagnostic with a code-fix link for the
%% IDE. Default Mermaid palette renders legibly on both light and dark
%% GitHub themes.
flowchart LR
    Syntax["SyntaxNode<br/>InvocationExpressionSyntax"]
    Filter{"Method-name fast path<br/>(IdentifierName / MemberAccess)"}
    Hook["LooksLikeHook?<br/>Use* prefix"]
    Symbol["SemanticModel.GetSymbolInfo<br/>(only when syntax matches)"]
    Body["Rule body<br/>HookRules · A11y · ThemeRef · WithKey · MemoCells"]
    Report["context.ReportDiagnostic<br/>REACTOR_*"]
    Fix["CodeFixProvider<br/>(optional, IDE quick-fix)"]
    Skip[/Skip — return early/]

    Syntax --> Filter
    Filter -->|"matches Button / Background / Select / Use*"| Hook
    Filter -->|"unrelated invocation"| Skip
    Hook -->|"name passes"| Symbol
    Hook -->|"name doesn't look like a hook"| Skip
    Symbol -->|"resolved + Reactor symbol"| Body
    Symbol -->|"unresolved or third-party"| Skip
    Body -->|"violation"| Report
    Body -->|"clean"| Skip
    Report -.->|"diagnostic properties: CaptureName, …"| Fix
