%% Reactor animation pipeline. Four systems author against a single
%% compositor layer: implicit per-property animation via .Animate(),
%% the ambient WithAnimation scope that routes reconciler property
%% writes through a Curve, the imperative KeyframeBuilder, and the
%% conditional Transition enter/exit. All four converge on Windows
%% Composition. Default Mermaid palette renders on both light and
%% dark GitHub themes.
flowchart TB
    Author["Component author"]

    subgraph Authoring["Author surface (Reactor)"]
        AnimMod[".Animate(props)<br/>declaration-site implicit"]
        Scope["WithAnimation(curve, () =&gt; ...)<br/>ambient scope, reconciler-driven"]
        KF["Keyframes(name, b =&gt; b.At(...))<br/>imperative timeline"]
        Trans[".Transition(Fade + Slide)<br/>enter / exit"]
    end

    subgraph Resolution["Reconciler resolution"]
        Recon["Reconciler.Update<br/>writes to live Visual"]
        Implicit["ImplicitAnimationCollection<br/>per-property triggers"]
        Explicit["KeyFrameAnimation / SpringAnimation<br/>StartAnimation()"]
    end

    Comp["Composition layer<br/>Visual.Properties · CompositionAnimation"]
    Native["Windows Composition (DWM)<br/>independent compositor thread"]
    Frame["Next frame to screen"]

    Author --> AnimMod
    Author --> Scope
    Author --> KF
    Author --> Trans

    AnimMod -->|"PropertyChanged hooks Visual"| Implicit
    Scope -->|"AnimationScope.Current routes writes"| Recon
    Recon -->|"property setter takes animation path"| Implicit
    KF --> Explicit
    Trans -->|"mount: ShowEffect · unmount: HideEffect"| Explicit

    Implicit --> Comp
    Explicit --> Comp
    Comp --> Native
    Native --> Frame
