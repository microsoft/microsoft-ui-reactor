<?xml version="1.0"?>
<!--
  Mirrors the real shapes that broke ref-gen (see ReferenceGenOverloadTests):

  * RenderContext.UseEffect — eight overloads sharing one short name, split
    across a params flavour, a Func<Action> cleanup flavour, and typed
    dependency arities. Declared here in a deliberately shuffled order so a
    test can prove render order comes from the cref, not the file.
  * MutationOptions`2 — a positional record. Roslyn emits no <member> entry
    for OnSuccess / OnError: the primary-constructor properties are
    compiler-generated, so a <see cref="P:...OnSuccess"/> can only be
    resolved through the declaring type.
  * Register — one name claimed by two unrelated declaring types. Genuinely
    ambiguous, unlike an overload set.
-->
<doc>
  <assembly>
    <name>Reactor</name>
  </assembly>
  <members>
