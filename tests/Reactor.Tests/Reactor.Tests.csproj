<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <Platforms>x64;ARM64</Platforms>
    <AssemblyName>Reactor.Tests</AssemblyName>
    <RootNamespace>Microsoft.UI.Reactor.Tests</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- AOT-honest (issue #70): the IL2*/IL3* analyzer is ENABLED (IsAotCompatible) even
         though this headless unit-test host is never trimmed/AOT-published in the normal
         `dotnet test` path. Several suites (CoreControlFamilyBoundaryTests IL scan,
         PublicApiSurfaceGuardTests, ImmutableRecordContractTests, the localization
         generator / CLI / devtools-MCP / search-index fixtures) reflect over types by
         design — those intentional reflection sites are *annotated* honestly with a
         justified [UnconditionalSuppressMessage] per site (behaviour-neutral; preferred
         over trim-semantic-changing [DynamicallyAccessedMembers], which per issue #70 can
         narrow preservation and regress). Suppressions survive ILC (unlike #pragma), so
         the analyzer keeps guarding against *new*, unintended reflection. See README.md
         for the per-category rationale and the native-AOT-run verdict. -->
    <IsAotCompatible>true</IsAotCompatible>
    <!-- Required by the [LibraryImport] source generator, which emits an unsafe stub.
         Used by the kernel32 package-identity probes in PackageRuntimeTests /
         GalleryPackageIdentityTests; no hand-written unsafe code in this project.
         LibraryImport is preferred over DllImport here because its marshalling is
         source-generated at compile time, which is what keeps the interop honest under
         the IsAotCompatible analysis above. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Show every individual trimmer warning instead of collapsing them into one. -->
    <TrimmerSingleWarn>false</TrimmerSingleWarn>
    <UseWinUI>true</UseWinUI>
    <!-- Tests P/Invoke Microsoft.WindowsAppRuntime.dll from a ModuleInitializer
         (TestSetup.cs); bundle the runtime so the test host can locate it
         without needing the system-wide Windows App Runtime install. -->
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Diagnostics.Tracing.TraceEvent" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Analyzer.Testing" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.CodeFix.Testing" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <!-- Supplies the MTP hangdump option (replaces the VSTest "blame hang timeout" flag). -->
    <PackageReference Include="Microsoft.Testing.Extensions.HangDump" />
    <!-- Supplies the MTP report-trx option; the internal OneBranch pipeline publishes a
         TRX from this suite via PublishTestResults. -->
    <PackageReference Include="Microsoft.Testing.Extensions.TrxReport" />
    <PackageReference Include="coverlet.collector">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\_shared\BuiltInHandlerBootstrap.cs" Link="BuiltInHandlerBootstrap.cs" />
  </ItemGroup>

  <!--
    ReactorGallery's deep-link routing (samples/ReactorGallery/DeepLink/GalleryRoutes.cs)
    is the piece that interprets untrusted `reactor-gallery://` URIs, so it is written
    free of any WinUI/WinRT dependency and compiled into this headless suite by source
    link rather than via a ProjectReference — pulling in the gallery *app* would drag
    WinUI app packaging into unit tests for no benefit. ControlRegistry.cs comes along
    because the route validator checks resolved tags against it.
  -->
  <ItemGroup>
    <Compile Include="..\..\samples\ReactorGallery\ControlRegistry.cs" Link="Samples\ReactorGallery\ControlRegistry.cs" />
    <Compile Include="..\..\samples\ReactorGallery\DeepLink\GalleryRoutes.cs" Link="Samples\ReactorGallery\GalleryRoutes.cs" />
    <Compile Include="..\..\samples\ReactorGallery\DeepLink\GalleryActivationRouting.cs" Link="Samples\ReactorGallery\GalleryActivationRouting.cs" />
    <Compile Include="..\..\samples\ReactorGallery\DeepLink\GalleryPackageIdentity.cs" Link="Samples\ReactorGallery\GalleryPackageIdentity.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Reactor\Reactor.csproj" />
    <!-- Spec 062 §7 Track B (B1a): charting moved core → Reactor.Advanced.
         The D3 / Chart* unit suites now resolve charting types (incl. the
         InternalsVisibleTo test seams) from Advanced. -->
    <ProjectReference Include="..\..\src\Reactor.Advanced\Reactor.Advanced.csproj" />
    <!-- Issue #433: md4c HTML renderer used by the Markdown/CommonMark tests. -->
    <ProjectReference Include="..\Reactor.Markdown.TestRenderer\Reactor.Markdown.TestRenderer.csproj" />
    <!-- Authoring attributes; referenced directly (Reactor's reference is
         PrivateAssets="all", so it does not flow transitively). Also puts the
         DLL on this project's output so the in-memory generator tests resolve
         the attributes from TPA. -->
    <ProjectReference Include="..\..\src\Reactor.Wrappers.Abstractions\Reactor.Wrappers.Abstractions.csproj" />
    <ProjectReference Include="..\..\src\Reactor.Localization.Generator\Reactor.Localization.Generator.csproj" />
    <ProjectReference Include="..\..\src\Reactor.Cli\Reactor.Cli.csproj" />
    <ProjectReference Include="..\..\src\Reactor.Analyzers\Reactor.Analyzers.csproj" />
    <ProjectReference Include="..\..\src\Reactor.Analyzers.Internal\Reactor.Analyzers.Internal.csproj" />
    <ProjectReference Include="..\..\src\Reactor.Wrappers.Generator\Reactor.Wrappers.Generator.csproj" />
    <!-- spec 045 §2.19: XAML wrapper unhooked at P2 review gate; the
         BehaviorBridgeMappingTests + DockingSmokeFixture tests retire
         alongside. WinUI.Dock vendored source stays in repo per §5.6 for
         license + reference; no test consumes it post-§2.19. -->
    <ProjectReference Include="..\..\samples\apps\minesweeper\Minesweeper.csproj" />
    <ProjectReference Include="..\..\tools\Reactor.MurCheckGuardrail\Reactor.MurCheckGuardrail.csproj" />
    <ProjectReference Include="..\..\tools\Reactor.ApiIndex\Reactor.ApiIndex.csproj" />
    <ProjectReference Include="..\..\tools\Reactor.SearchIndex\Reactor.SearchIndex.csproj" />
  </ItemGroup>

</Project>
