<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Spec 010 — this project exists to test the interceptor generator, so it forces
    ReactorSourceMap ON in EVERY configuration rather than inheriting the
    Debug-only default from build/Reactor.targets. Because that override lands in
    the project body — after Directory.Build.props has already imported the
    targets — the InterceptorsNamespaces entry the targets would normally supply
    has to be spelled out here too. A PackageReference consumer never does this:
    they get both from the Debug default.

    Reactor.Tests deliberately does NOT enable the generator: doing so would
    rewrite several thousand DSL call sites in a suite whose assertions were
    written against un-stamped elements, measuring the change's disruption rather
    than its behaviour.
  -->
  <PropertyGroup>
    <ReactorSourceMap>true</ReactorSourceMap>
    <InterceptorsNamespaces>$(InterceptorsNamespaces);Microsoft.UI.Reactor.Generated</InterceptorsNamespaces>

    <!-- Lets the measurement read the generated interceptor file off disk. -->
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
  </PropertyGroup>
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <Platforms>x64;ARM64</Platforms>
    <AssemblyName>Reactor.SourceMap.Spike</AssemblyName>
    <RootNamespace>Microsoft.UI.Reactor.SourceMap.Spike</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseWinUI>true</UseWinUI>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <!-- The generator reads this to decide whether to emit anything. -->
  <ItemGroup>
    <CompilerVisibleProperty Include="ReactorSourceMap" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <!-- Same WinRT/Windows App SDK bootstrap the headless Reactor.Tests suite uses. -->
  <ItemGroup>
    <Compile Include="..\Reactor.Tests\TestSetup.cs" Link="TestSetup.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Reactor\Reactor.csproj" />
    <ProjectReference Include="..\..\src\Reactor.SourceMap.Generator\Reactor.SourceMap.Generator.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
