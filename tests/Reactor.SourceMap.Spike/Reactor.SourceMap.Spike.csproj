<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Spec 010 Route B spike consumer.

    This project exists to prove the interceptor route END TO END at runtime, in a
    project small enough that turning interception on has a bounded blast radius.
    Reactor.Tests deliberately does NOT enable it: doing so would rewrite several
    thousand DSL call sites in a suite whose assertions were written against
    un-stamped elements, which measures the spike's disruption rather than its
    behaviour.

    The two properties below are the entire consumer-side opt-in story, and they
    MUST move together — emitting an interceptor into a project that has not
    listed the namespace is CS9137, a hard build error rather than a no-op.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <Platforms>x64;ARM64</Platforms>
    <AssemblyName>Reactor.SourceMap.Spike</AssemblyName>
    <RootNamespace>Microsoft.UI.Reactor.SourceMap.Spike</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseWinUI>true</UseWinUI>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <OutputType>Exe</OutputType>

    <!-- Route B opt-in (1 of 2): tells the generator to emit. -->
    <ReactorSourceMap>true</ReactorSourceMap>
    <!-- Route B opt-in (2 of 2): tells the C# compiler to honour the emitted
         [InterceptsLocation]. In a PackageReference consumer this line is
         supplied automatically by build/Microsoft.UI.Reactor.targets. -->
    <InterceptorsNamespaces>$(InterceptorsNamespaces);Microsoft.UI.Reactor.Generated</InterceptorsNamespaces>

    <!-- Lets the measurement read the generated interceptor file off disk. -->
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
  </PropertyGroup>

  <!-- The generator reads this to decide whether to emit anything. -->
  <ItemGroup>
    <CompilerVisibleProperty Include="ReactorSourceMap" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <!-- Same WinRT/Windows App SDK bootstrap the headless Reactor.Tests suite uses. -->
  <ItemGroup>
    <Compile Include="..\Reactor.Tests\TestSetup.cs" Link="TestSetup.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Reactor\Reactor.csproj" />
    <ProjectReference Include="..\..\src\Reactor.SourceMap.Generator\Reactor.SourceMap.Generator.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
