<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <RootNamespace>Microsoft.UI.Reactor.SelfTests</RootNamespace>
    <AssemblyName>Reactor.SelfTests</AssemblyName>
    <IsTestProject>true</IsTestProject>
    <!-- xunit.v3 v4 is Microsoft.Testing.Platform-only, so global.json pins the repo-wide
         runner to MTP. MSTest speaks MTP natively behind this switch, which keeps this
         harness runnable under the same `dotnet test` invocation as the xunit suites. -->
    <EnableMSTestRunner>true</EnableMSTestRunner>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="MSTest.TestAdapter" />
    <PackageReference Include="MSTest.TestFramework" />
  </ItemGroup>
  <ItemGroup>
    <!-- Build dependency: ensures Host is built before tests, no runtime reference -->
    <ProjectReference Include="..\Reactor.AppTests.Host\Reactor.AppTests.Host.csproj" ReferenceOutputAssembly="false" Private="false" />
  </ItemGroup>
</Project>
