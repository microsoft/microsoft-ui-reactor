<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <Platforms>x64;ARM64</Platforms>
    <AssemblyName>Reactor.Fuzz</AssemblyName>
    <RootNamespace>Microsoft.UI.Reactor.Fuzz</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseWinUI>true</UseWinUI>
    <!-- Fuzz harness loads WinUI types in-process; bundle the runtime. -->
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <IsPackable>false</IsPackable>
    <!-- SharpFuzz instrumentation is incompatible with NativeAOT and trim analysis. -->
    <IsAotCompatible>false</IsAotCompatible>
    <IsTrimmable>false</IsTrimmable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SharpFuzz" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Reactor\Reactor.csproj" />
    <!-- Issue #433: md4c HTML renderer driven by the fuzz harness. -->
    <ProjectReference Include="..\Reactor.Markdown.TestRenderer\Reactor.Markdown.TestRenderer.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="corpus\**\*" CopyToOutputDirectory="PreserveNewest" />
    <None Include="OneFuzzConfig.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="README.md" />
  </ItemGroup>

</Project>
