<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <Platforms>x64;ARM64</Platforms>
    <RootNamespace>Microsoft.UI.Reactor.AppTests.Host</RootNamespace>
    <AssemblyName>Reactor.AppTests.Host</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <!-- Full WinUI host (selftest runner); bundle the WAS runtime so the
         exe launches without depending on the machine-wide install. -->
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <!-- CsWinRT1030: generic WinRT-implementing collection use (e.g. List<Border>
         in SplitterMatrixFixtures) requires the CsWinRT-generated marshaling
         code to use unsafe blocks. This flag enables that for the generated
         code only; user code in this project does not opt into unsafe. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <PropertyGroup Condition="'$(PublishAotInternal)' == 'true'">
    <PublishAot>true</PublishAot>
  </PropertyGroup>

  <!-- Keeps the selftest's own DependencyProperty-bearing control types reflectable
       under NativeAOT, so Devtools_PropertyToolsDpDiscovery can assert the
       C#-authored-field arm there too (issue #1109). The Devtools package roots
       WinUI's DP statics; an assembly's own types are its own responsibility, and
       this file is the worked example the docs point at. -->
  <ItemGroup>
    <TrimmerRootDescriptor Include="ILLink.Descriptors.xml" />
  </ItemGroup>

  <!--
    Workaround for WindowsAppSDK#6394 (https://github.com/microsoft/WindowsAppSDK/issues/6394):
    NativeAOT publish of an unpackaged (WindowsPackageType=None) WinUI 3 app does not copy
    the generated project .pri (and any .xbf files) into the publish output. Without the
    .pri, MRT lookups fail (e.g. TabView/NavigationView throw FileNotFoundException from
    ResourceAccessor::GetLocalizedStringResource) and XamlControlsResources loads as an
    empty dictionary, breaking theme resolution.

    The .pri is generated by _GenerateProjectPriFile into $(TargetDir); we copy it (and
    any .xbf files) into $(PublishDir) post-Publish so the AOT-published exe behaves
    the same as the JIT bin output. Remove this target once WindowsAppSDK#6394 ships.
  -->
  <Target Name="_CopyWinUIResourcesForAot" AfterTargets="Publish"
          Condition="'$(PublishAot)' == 'true' and '$(AppxPackage)' != 'true'">
    <ItemGroup>
      <_WinUIResourcesForAot Include="$(OutputPath)**\*.xbf" />
      <_WinUIResourcesForAot Include="$(OutputPath)$(AssemblyName).pri" Condition="Exists('$(OutputPath)$(AssemblyName).pri')" />
    </ItemGroup>
    <Copy SourceFiles="@(_WinUIResourcesForAot)"
          DestinationFiles="@(_WinUIResourcesForAot->'$(PublishDir)%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

  <ItemGroup>
    <RuntimeHostConfigurationOption Include="Reactor.DevtoolsSupport"
                                    Value="true"
                                    Trim="true" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MessageFormat" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\_shared\BuiltInHandlerBootstrap.cs" Link="BuiltInHandlerBootstrap.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Reactor\Reactor.csproj" />
    <!-- Issue #433: md4c HTML renderer used by MarkdownHtmlFixtures. -->
    <ProjectReference Include="..\Reactor.Markdown.TestRenderer\Reactor.Markdown.TestRenderer.csproj" />
    <ProjectReference Include="..\..\src\Reactor.Advanced\Reactor.Advanced.csproj" />
    <ProjectReference Include="..\..\src\Reactor.Devtools\Reactor.Devtools.csproj" />
    <!-- Standalone library used by Issue142_ThirdPartyControlPrivateDp_Renders to
         simulate a 3P control NuGet referenced from a Reactor app that has its
         own XAML metadata. -->
    <ProjectReference Include="..\Reactor.AppTests.ThirdPartyControls\Reactor.AppTests.ThirdPartyControls.csproj" />
    <!-- Spec 047 §14 Phase 1 (1.16) — external-assembly proof. Lets the
         live-WinUI fixtures (Spec047ExternalProofFixtures.cs) exercise the
         MarqueeHandler authored against Reactor's public V1 surface only. -->
    <ProjectReference Include="..\external_proof\Reactor.External.TestControl\Reactor.External.TestControl.csproj" />
    <!-- Spec 058 §14 — the control-wrapper source generator, so the
         ToggleSwitchWrapperParityFixture can prove a generated wrapper behaves
         identically to the hand-written ToggleSwitchDescriptor. -->
    <ProjectReference Include="..\..\src\Reactor.Wrappers.Generator\Reactor.Wrappers.Generator.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <!-- The wrapper generator's authoring attributes. Referenced directly because
         Reactor references this assembly with PrivateAssets="all", so it does not
         flow transitively through the Reactor ProjectReference above. -->
    <ProjectReference Include="..\..\src\Reactor.Wrappers.Abstractions\Reactor.Wrappers.Abstractions.csproj" />
    <!-- Spec 045 §2.19: the XAML wrapper assembly was unhooked from the
         solution at the §2.29 review gate. The Phase-1 DockingSmokeFixtures
         have been retired; the Phase-2 NativeDockingSmokeFixtures cover the
         same surface against the native renderer. -->
  </ItemGroup>

</Project>
