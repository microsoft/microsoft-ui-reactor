<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Reactor.IntegrationTests</AssemblyName>
    <RootNamespace>Microsoft.UI.Reactor.IntegrationTests</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <!-- Fixture projects under MurCheck/Fixtures/ are deliberately broken so
         the smoke tests can drive `mur check` against them. They live as
         standalone csproj files; exclude their .cs from this project's
         default Compile glob so they don't poison this project's build. -->
    <Compile Remove="MurCheck\Fixtures\**\*.cs" />
    <None Include="MurCheck\Fixtures\**\*.cs" />
    <None Include="MurCheck\Fixtures\**\*.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

</Project>
