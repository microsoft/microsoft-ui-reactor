<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <Platforms>x64;ARM64</Platforms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <WindowsSdkPackageVersion>10.0.22621.57</WindowsSdkPackageVersion>
    <IsPackable>false</IsPackable>
    <IsAotCompatible>true</IsAotCompatible>
    <InvariantGlobalization>true</InvariantGlobalization>
    <ReactorRoot Condition="'$(ReactorRoot)' == ''">..\..\..</ReactorRoot>
  </PropertyGroup>
  <PropertyGroup Condition="'$(PublishAotInternal)' == 'true'">
    <PublishAot>true</PublishAot>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.WinUI.Controls.SettingsControls" />
    <PackageReference Include="CommunityToolkit.WinUI.Controls.HeaderedControls" />
    <PackageReference Include="CommunityToolkit.WinUI.Controls.RadialGauge" />
  </ItemGroup>
  <ItemGroup Condition="'$(ReactorPackageVersion)' == ''">
    <ProjectReference Include="$(ReactorRoot)\src\Reactor\Reactor.csproj" />
    <ProjectReference Include="$(ReactorRoot)\src\Reactor.Wrappers.Abstractions\Reactor.Wrappers.Abstractions.csproj" />
    <ProjectReference Include="$(ReactorRoot)\src\Reactor.Wrappers.Generator\Reactor.Wrappers.Generator.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>
  <ItemGroup Condition="'$(ReactorPackageVersion)' != ''">
    <PackageReference Include="Microsoft.UI.Reactor" Version="$(ReactorPackageVersion)" />
  </ItemGroup>
</Project>
