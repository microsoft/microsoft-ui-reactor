<Project Sdk="Microsoft.NET.Sdk" TreatAsLocalProperty="PublishTrimmed">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <PublishTrimmed>false</PublishTrimmed>
    <IsRoslynComponent>true</IsRoslynComponent>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <AssemblyName>Reactor.Analyzers</AssemblyName>
    <RootNamespace>Microsoft.UI.Reactor.Analyzers</RootNamespace>

    <!-- Roslyn loads analyzers into the in-process csc compiler, so the DLL
         must be architecture-neutral regardless of the consuming project's
         $(Platform). Without these, an x64/ARM64 build (e.g. `mur
         pack-local`) drops the analyzer in bin\x64\... and csc raises
         CS8034 "assembly architecture is not compatible with the current
         process" on the consumer side. -->
    <PlatformTarget>AnyCPU</PlatformTarget>
    <AppendPlatformToOutputPath>false</AppendPlatformToOutputPath>

    <!-- Bundled into Microsoft.UI.Reactor.nupkg — does not ship as its own
         package. See docs/specs/022-packaging-and-distribution.md §5. -->
    <IsPackable>false</IsPackable>

    <!-- RS1038: analyzers and their code-fix providers are intentionally
         co-located in this single assembly, which is shipped as one DLL under
         analyzers/dotnet/cs (see Reactor.csproj packing block). The code fixes
         require Microsoft.CodeAnalysis.Workspaces; splitting them into a
         separate assembly would mean shipping/packing a second analyzer DLL for
         no functional gain since consumers always build with the full SDK
         (where Workspaces is present). Suppressed deliberately. -->
    <NoWarn>$(NoWarn);RS1038</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <AdditionalFiles Include="AnalyzerReleases.Shipped.md" />
    <AdditionalFiles Include="AnalyzerReleases.Unshipped.md" />
  </ItemGroup>

  <!-- The REACTOR_DYM_003 StringSimilarity port is internal; the parity test in
       Reactor.Tests asserts it matches the CLI's copy byte-for-byte. -->
  <ItemGroup>
    <InternalsVisibleTo Include="Reactor.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" PrivateAssets="all" />
  </ItemGroup>

</Project>
