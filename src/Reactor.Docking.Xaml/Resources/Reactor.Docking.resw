<?xml version="1.0" encoding="utf-8"?>
<!--
  ════════════════════════════════════════════════════════════════════════
   Reactor.Docking string resources — `Docking.*` prefix reservation.

   Spec 045 §0.3 reserves the `Docking.*` resource-key prefix for every
   user-facing string the docking subsystem surfaces. All entries in this
   file (and any future docking .resw under any locale) MUST be named
   `Docking.<Group>.<Key>` — e.g. `Docking.DropTarget.Center`,
   `Docking.FloatingWindow.DefaultTitle`. New docking UI surfaces must
   land their strings under this prefix; do not introduce parallel
   prefixes (`Dock.*`, `DockManager.*`, etc.).

   Phase-1 status: this file is RESERVED but not yet wired through the
   `Reactor.Localization.Generator`. The vendored WinUI.Dock chrome
   supplies its own (English-only) strings during P1; no wrapper-side
   consumer reads from this file yet. Phase 2's native rewrite is the
   first consumer — it lifts the keys below into actual UI surfaces
   (drop-target tooltips, default floating-window title, side-pin
   tooltip) routed through `IntlAccessor` via the typed `Loc` generator.

   At P2 entry, wire this file via the standard items in the
   `Reactor.Docking.Xaml` csproj:
     <ItemGroup>
       <AdditionalFiles Include="Resources\**\*.resw" />
       <Content Include="Resources\**\*.resw"
                CopyToOutputDirectory="PreserveNewest"
                Link="Strings\en-US\%(Filename)%(Extension)" />
     </ItemGroup>

   Cross-reference:
     docs/specs/045-docking-windows-design.md §8.6 (Localization)
     docs/specs/tasks/045-docking-windows-implementation.md §0.3, §2.21
     docs/reference/localization-howto.md (project wiring)
  ════════════════════════════════════════════════════════════════════════
-->
<root>
  <resheader name="resmimetype">
    <value>text/microsoft-resx</value>
  </resheader>
  <resheader name="version">
    <value>2.0</value>
  </resheader>
  <resheader name="reader">
    <value>System.Resources.ResXResourceReader, System.Windows.Forms, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089</value>
  </resheader>
  <resheader name="writer">
    <value>System.Resources.ResXResourceWriter, System.Windows.Forms, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089</value>
  </resheader>

  <!-- Host landmark (P2 §2.22) ──────────────────────────────────────── -->
  <data name="Docking.DockHost.Landmark" xml:space="preserve">
    <value>Docking area</value>
    <comment>AutomationProperties.LocalizedLandmarkType + Name for the DockHost root. Spec 045 §2.22.</comment>
  </data>

  <!-- Drop-target overlay (P2 §2.3) ────────────────────────────────── -->
  <data name="Docking.DropTarget.Center" xml:space="preserve">
