<Project Sdk="Microsoft.NET.Sdk" TreatAsLocalProperty="PublishTrimmed">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <PublishTrimmed>false</PublishTrimmed>
    <IsRoslynComponent>true</IsRoslynComponent>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <AssemblyName>Reactor.SourceMap.Generator</AssemblyName>
    <RootNamespace>Microsoft.UI.Reactor.SourceMap.Generator</RootNamespace>

    <!-- Roslyn loads generators into the in-process csc compiler, so the DLL
         must be architecture-neutral regardless of the consuming project's
         $(Platform). Mirrors Reactor.Analyzers / Reactor.Wrappers.Generator. -->
    <PlatformTarget>AnyCPU</PlatformTarget>
    <AppendPlatformToOutputPath>false</AppendPlatformToOutputPath>

    <!-- Spec 010 (Route B). Bundled into Microsoft.UI.Reactor.nupkg under
         buildTransitive/sourcemap (see Reactor.csproj) rather than shipping as its own
         package. Deliberately NOT analyzers/dotnet/cs, where Reactor.Analyzers and
         Reactor.Wrappers.Generator live: everything in that folder loads into every
         consumer compilation, and this generator classifies every invocation
         semantically. build/Microsoft.UI.Reactor.targets adds it as an <Analyzer>
         only when ReactorSourceMap is true, which defaults to Debug-only — so a
         Release consumer does not load it unless it opts in explicitly. -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" PrivateAssets="all" />
  </ItemGroup>

  <PropertyGroup>
    <!-- RS2008: the one diagnostic this component reports (REACTOR_SOURCEMAP_001)
         belongs to the source-map generator, not to the Reactor.Analyzers bundle, so
         it is documented in docs/guide/source-mapping.md rather than tracked in that
         package's AnalyzerReleases files. Adding a row there would claim an id the
         analyzer assembly does not declare. -->
    <NoWarn>$(NoWarn);RS2008</NoWarn>
  </PropertyGroup>

  <!-- Spec 010 - lets Reactor.Tests unit-test ApplyPathMap directly. The
       end-to-end parity test in Reactor.SourceMap.Tests only exercises the PathMap
       the CI build happens to set, so the casing and prefix edge cases need a
       direct call. -->
  <ItemGroup>
    <InternalsVisibleTo Include="Reactor.Tests" />
  </ItemGroup>

</Project>
