<Project Sdk="Microsoft.NET.Sdk" TreatAsLocalProperty="PublishTrimmed">

  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <RootNamespace>Microsoft.UI.Reactor.Advanced</RootNamespace>
    <AssemblyName>Reactor.Advanced</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Spec 062 §7 Track B (B1a): charting moved here from core. Its
         ChartAutomationPeer marshals List&lt;AutomationPeer&gt; across the WinRT
         ABI, so the CsWinRT source generator requires unsafe blocks to emit
         AOT/trim-safe marshalling (CsWinRT1030). Core's Reactor.csproj already
         sets this; mirror it here so the NativeAOT publish stays clean. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <Platforms>AnyCPU;x64;ARM64</Platforms>

    <PublishTrimmed>false</PublishTrimmed>
    <IsTrimmable>true</IsTrimmable>
    <IsAotCompatible>true</IsAotCompatible>

    <IsPackable>true</IsPackable>
    <PackageId>Microsoft.UI.Reactor.Advanced</PackageId>
    <Version Condition="'$(Version)' == ''">0.0.0-local</Version>
    <Authors>Microsoft</Authors>
    <Company>Microsoft</Company>
    <Description>Advanced Reactor components for WinUI 3 — the Win2D canvas, the D3 charting subsystem (Microsoft.UI.Reactor.Charting), the docking / dock-layout subsystem (Microsoft.UI.Reactor.Docking), the CommonMark markdown renderer (Microsoft.UI.Reactor.Markdown), and the data grid (Microsoft.UI.Reactor.Controls DataGrid).</Description>
    <PackageTags>WinUI;WinUI3;Windows App SDK;WinAppSDK;XAML;Windows;desktop;UI;declarative;Reactor;Win2D;canvas;graphics;charts;docking;dock-layout;markdown;commonmark;datagrid;grid</PackageTags>
    <Copyright>© Microsoft Corporation. All rights reserved.</Copyright>
    <PackageIcon>Icon.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>
    <PackageProjectUrl>https://github.com/microsoft/microsoft-ui-reactor</PackageProjectUrl>
    <RepositoryUrl>https://github.com/microsoft/microsoft-ui-reactor</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591;CS8305;REACTOR_DOC_001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Graphics.Win2D" />
  </ItemGroup>

  <!-- Spec 062 §7 Track B (B1): the charting and docking subsystems now live in
       this assembly. Their test-only internal seams (charting's ChartElement<T> /
       ChartComponent AttachChartData drivers + D3 parser probes; docking's
       DockHostModel / DockLayoutMutator / native-control test hooks) were visible
       to these test hosts when both shipped in core; republish exactly that access
       here so the existing unit tests, selftest fixtures, and fuzz harness keep
       compiling unchanged. Microsoft.UI.Reactor.Devtools reaches docking's internal
       DockHostModelBridge for its docking.* MCP tools (it had core's IVT before the
       move) — mirror that here. -->
  <ItemGroup>
    <InternalsVisibleTo Include="Reactor.Tests" />
    <InternalsVisibleTo Include="Reactor.AppTests.Host" />
    <InternalsVisibleTo Include="Reactor.PackagedTests.Host" />
    <InternalsVisibleTo Include="Reactor.Fuzz" />
    <InternalsVisibleTo Include="Microsoft.UI.Reactor.Devtools" />
    <!-- Issue #433 / spec 062 §7 B2: the md4c HTML renderer (MarkdownHtml) lives
         in the test-support library tests/Reactor.Markdown.TestRenderer and drives
         the parser internals (Md4cParser, Md4cEntity), which moved here with the
         markdown subsystem. -->
    <InternalsVisibleTo Include="Reactor.Markdown.TestRenderer" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Reactor\Reactor.csproj"
                      GlobalPropertiesToRemove="PublishTrimmed;PublishAot;RuntimeIdentifier;SelfContained" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\skills\advanced.md"
          Pack="true" PackagePath="agentkit/skills/reactor-advanced.md" Visible="false" />
    <None Include="..\..\assets\Icon.png" Pack="true" PackagePath="" Visible="false" />
    <None Include="README.md" Pack="true" PackagePath="" Visible="false" />
  </ItemGroup>

</Project>
