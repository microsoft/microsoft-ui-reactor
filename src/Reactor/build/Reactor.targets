<Project>
  <!--
    Spec 010 — source mapping.

    Mirrors the platform precedent rather than inventing one. WPF gates XAML
    source info on <XamlDebuggingInformation>, which defaults TRUE in Debug and
    FALSE in Release; WinUI 3's Live Visual Tree / XAML Hot Reload likewise
    require a Debug configuration. So source mapping follows the build
    configuration, not a bespoke property the app author has to discover.

    Debug  → generated. The interceptors are compiled in, but stamp nothing
             until Reactor.Diagnostics.ReactorSourceMap.Enabled is set, which
             ReactorApp does when the process is launched with the devtools
             verb. A Debug build that never runs devtools pays no runtime
             allocation (measured: byte-identical per-render bytes to a build
             with no generator at all).
    Release → not generated. No build cost, and no absolute source paths are
             baked into shipped binaries.

    Cost of the Debug default, measured on samples/ReactorGallery (9,272 lines,
    1,660 intercepted call sites): +0.99s on an incremental one-line rebuild,
    +2.18s on a clean compile. Scales at roughly 0.5-0.6 ms per intercepted call
    site, so set <ReactorSourceMap>false</ReactorSourceMap> explicitly on a very
    large app if the edit loop matters more than element attribution.

    The InterceptorsNamespaces line below is not optional: emitting an
    [InterceptsLocation] into a compilation that has not opted the namespace in
    is CS9137, a hard build error rather than a silent no-op. It is welded to the
    same condition so the two can never drift apart, and so no app author ever
    has to know the namespace exists.
  -->
  <!--
    Debug default. NOTE the empty-string arm: this file is imported by the repo's
    own Directory.Build.props at the TOP of a project, and $(Configuration) is not
    defaulted until the SDK props are imported later, so it is genuinely EMPTY
    here for any build that does not pass -c / -p:Configuration explicitly (which
    is exactly what CI does). Treating empty as Debug matches MSBuild's own
    default. A real Release build passes Configuration as a global property, so it
    is already set by this point and correctly declines.

    A PackageReference consumer imports this file after the project body, where
    $(Configuration) is always set, so the empty arm is inert for them.
  -->
  <PropertyGroup Condition="'$(ReactorSourceMap)' == '' and ('$(Configuration)' == 'Debug' or '$(Configuration)' == '')">
    <ReactorSourceMap>true</ReactorSourceMap>
  </PropertyGroup>

  <PropertyGroup Condition="'$(ReactorSourceMap)' == 'true'">
    <InterceptorsNamespaces>$(InterceptorsNamespaces);Microsoft.UI.Reactor.Generated</InterceptorsNamespaces>
    <!--
      Compile-time signal that this assembly was BUILT with source mapping. It is
      deliberately a build fact rather than a runtime probe: code that needs to
      know whether locations are available must not infer it from "GetSource
      returned null", because that cannot distinguish "not compiled in" from
      "compiled in but broken". Tests use it to skip honestly on a Release build
      while still asserting hard on a Debug one; consumers can use it to guard
      inspector UI that would otherwise show empty locations.
    -->
    <DefineConstants>$(DefineConstants);REACTOR_SOURCEMAP</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <!-- Lets the generator read $(ReactorSourceMap) via the analyzer config. -->
    <CompilerVisibleProperty Include="ReactorSourceMap" />
  </ItemGroup>

  <ItemGroup>
    <!--
      ReactorApplication.InitializeComponent loads XAML resources from these
      sidecar assets. ProjectReference consumers get them from the library
      output automatically, but PackageReference publish only copies assemblies
      unless the package target explicitly marks these files for output/publish.
    -->
    <None Include="$(MSBuildThisFileDirectory)..\lib\**\Reactor.pri"
          Link="Reactor.pri"
          TargetPath="Reactor.pri"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest"
          Visible="false" />
    <None Include="$(MSBuildThisFileDirectory)..\lib\**\Reactor\Hosting\ReactorApplication.xaml"
          Link="Reactor\Hosting\ReactorApplication.xaml"
          TargetPath="Reactor\Hosting\ReactorApplication.xaml"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest"
          Visible="false" />
    <None Include="$(MSBuildThisFileDirectory)..\lib\**\Reactor\Hosting\ReactorApplication.xbf"
          Link="Reactor\Hosting\ReactorApplication.xbf"
          TargetPath="Reactor\Hosting\ReactorApplication.xbf"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest"
          Visible="false" />

    <!-- Default: devtools subsystem is trimmed out of AOT publishes.
         Apps that need devtools override by adding their own
         <RuntimeHostConfigurationOption Include="Reactor.DevtoolsSupport"
                                          Value="true" Trim="true" />.
         SDK uses last-write-wins for duplicate Include keys on
         RuntimeHostConfigurationOption. -->
    <RuntimeHostConfigurationOption Include="Reactor.DevtoolsSupport"
                                    Value="false"
                                    Trim="true"
                                    Condition="'@(RuntimeHostConfigurationOption->WithMetadataValue('Identity', 'Reactor.DevtoolsSupport'))' == ''" />
  </ItemGroup>

  <Target Name="_NormalizeReactorDevtoolsSupportSwitch"
          BeforeTargets="_GenerateRuntimeConfigurationFilesInputCache;GenerateBuildRuntimeConfigurationFiles;PrepareForILLink">
    <ItemGroup Condition="'@(RuntimeHostConfigurationOption->WithMetadataValue('Identity', 'Reactor.DevtoolsSupport')->WithMetadataValue('Value', 'true'))' != ''">
      <RuntimeHostConfigurationOption Remove="Reactor.DevtoolsSupport" />
      <RuntimeHostConfigurationOption Include="Reactor.DevtoolsSupport"
                                      Value="true"
                                      Trim="true" />
    </ItemGroup>
  </Target>

  <Target Name="_RestoreReactorDevtoolsSupportRuntimeKnob"
          AfterTargets="PrepareForILLink"
          BeforeTargets="WriteIlcRspFileForCompilation"
          Condition="'@(_TrimmerFeatureSettings->WithMetadataValue('Identity', 'Reactor.DevtoolsSupport')->WithMetadataValue('Value', 'true'))' != ''">
    <ItemGroup>
      <RuntimeHostConfigurationOption Include="Reactor.DevtoolsSupport"
                                      Value="true" />
    </ItemGroup>
  </Target>
</Project>
