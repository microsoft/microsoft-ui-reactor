<UserControl x:Class="Microsoft.UI.Reactor.VsExtension.UI.ReactorEmbedControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Microsoft.UI.Reactor.VsExtension.UI"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Loaded="OnLoaded"
             Unloaded="OnUnloaded">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" LastChildFill="True" Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}">
            <Button DockPanel.Dock="Right" Content="↻" Width="24" Margin="4,2"
                    Command="{Binding ForceReloadCommand}" ToolTip="Force reload" />
            <ComboBox ItemsSource="{Binding Components}"
                      SelectedItem="{Binding SelectedComponent}"
                      Margin="4,2" />
        </DockPanel>

        <Grid Grid.Row="1">
            <!--
                The placeholder overlay is drawn BENEATH the HwndHostPlaceholder in
                Z-order, but becomes visible because the host's HWND is hidden
                (SW_HIDE) via EmbeddedHostVisible whenever the embedded child isn't
                rendering yet. WPF airspace would otherwise show the empty Win32
                placeholder HWND on top, hiding this content. The placeholder HWND
                itself stays alive across visibility toggles so the EmbedClient's
                SetParent flow keeps working.
            -->
            <Border Visibility="{Binding PlaceholderVisible, Converter={StaticResource BoolToVisibility}}"
                    Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="32" MaxWidth="420">
                    <TextBlock Text="{Binding PlaceholderTitle}"
                               Foreground="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}"
                               FontSize="18" FontWeight="SemiBold"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="{Binding PlaceholderDetail}"
                               Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"
                               Margin="0,8,0,0"
                               TextWrapping="Wrap"
                               TextAlignment="Center" />
                    <ProgressBar IsIndeterminate="True"
                                 Width="220" Height="4"
                                 Margin="0,16,0,0" />
                    <TextBlock Text="{Binding StatusText}"
                               Foreground="{Binding StatusBrush}"
                               Margin="0,8,0,0"
                               FontStyle="Italic"
                               HorizontalAlignment="Center" />
                </StackPanel>
            </Border>
            <local:HwndHostPlaceholder x:Name="PlaceholderHost"
                                       Visibility="{Binding EmbeddedHostVisible, Converter={StaticResource BoolToVisibility}}" />
            <Border Visibility="{Binding ErrorOverlayVisible, Converter={StaticResource BoolToVisibility}}"
                    Background="#CC000000">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20">
                    <TextBlock Text="{Binding ErrorTitle}" Foreground="White" FontWeight="Bold" FontSize="16" />
                    <TextBlock Text="{Binding ErrorDetail}" Foreground="White" TextWrapping="Wrap" Margin="0,8,0,0" />
                </StackPanel>
            </Border>
            <Border Visibility="{Binding BuildingVisible, Converter={StaticResource BoolToVisibility}}"
                    Background="#80000000" Height="24" VerticalAlignment="Top">
                <TextBlock Text="Building…" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
        </Grid>

        <Border Grid.Row="2" BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}" BorderThickness="0,1,0,0">
            <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusBrush}" Margin="6,3" />
        </Border>
    </Grid>
</UserControl>
