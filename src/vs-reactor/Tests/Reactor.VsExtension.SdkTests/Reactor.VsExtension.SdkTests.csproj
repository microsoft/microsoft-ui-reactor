<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- See Reactor.VsExtension.csproj for the TF_BUILD (Azure DevOps / OneBranch)
         guard rationale: inert net10.0 on OB, full net472 VSIX-test project elsewhere. -->
    <TargetFramework Condition="'$(TF_BUILD)' != 'true'">net472</TargetFramework>
    <TargetFramework Condition="'$(TF_BUILD)' == 'true'">net10.0</TargetFramework>
    <EnableDefaultItems Condition="'$(TF_BUILD)' == 'true'">false</EnableDefaultItems>
    <EnableDefaultCompileItems Condition="'$(TF_BUILD)' == 'true'">false</EnableDefaultCompileItems>
    <OutputType Condition="'$(TF_BUILD)' != 'true'">Exe</OutputType>
    <OutputType Condition="'$(TF_BUILD)' == 'true'">Library</OutputType>
    <LangVersion>latest</LangVersion>
    <IsAotCompatible>false</IsAotCompatible>
    <IsPackable>false</IsPackable>
    <NoWarn>$(NoWarn);IL2026;IL3050;IL2104;IL2118;VSTHRD200;CS2008</NoWarn>
  </PropertyGroup>

  <ItemGroup Condition="'$(TF_BUILD)' != 'true'">
    <PackageReference Include="Microsoft.VisualStudio.SDK" />
    <PackageReference Include="Microsoft.VisualStudio.Sdk.TestFramework.Xunit.v3" />
    <PackageReference Include="System.Reflection.DispatchProxy" />
    <PackageReference Include="Microsoft.VisualStudio.Composition" />
    <PackageReference Include="Microsoft.VisualStudio.Interop" />
    <PackageReference Include="Microsoft.VisualStudio.Shell.15.0" />
    <PackageReference Include="Microsoft.VisualStudio.Utilities" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" PrivateAssets="all" IncludeAssets="runtime; build; native; contentfiles; analyzers; buildtransitive" />
    <!-- Pin transitive MessagePack (via Microsoft.VisualStudio.SDK → StreamJsonRpc) to a
         version that includes the GHSA-hv8m-jj95-wg3x LZ4 decompression fix (>= 2.5.301). -->
    <PackageReference Include="MessagePack" />
  </ItemGroup>

  <ItemGroup Condition="'$(TF_BUILD)' != 'true'">
    <ProjectReference Include="..\..\Reactor.VsExtension\Reactor.VsExtension.csproj" ReferenceOutputAssembly="true" CopyLocalSatelliteAssemblies="false" PrivateAssets="all" />
  </ItemGroup>
</Project>
