<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Plain net10.0 (no -windows / UseWinUI): this reads Microsoft.WinUI.dll as
         *metadata* via System.Reflection.Metadata and never loads it, so it stays
         headless and needs no WinUI/WindowsAppSDK reference of its own. That matters
         — loading a CsWinRT projection just to enumerate it would drag the whole
         Windows App SDK into a tool that only emits an XML file. -->
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Microsoft.UI.Reactor.DevtoolsDescriptorGen</RootNamespace>
    <AssemblyName>Reactor.DevtoolsDescriptorGen</AssemblyName>
    <OutputType>Exe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

</Project>
