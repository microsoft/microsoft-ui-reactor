  "media-player-element": {
    "keywords": ["video", "audio", "playback", "transport controls", "player"],
    "relatedControls": ["AnimatedVisualPlayer"],
    "sampleOverride": {
      "header": "Video with transport controls",
      "code": "var (failure, setFailure) = UseState<string?>(null);\n\nElement player = failure is null\n    // OnMediaFailed lets a dead source explain itself instead of leaving the\n    // player showing its opaque built-in error text.\n    ? (MediaPlayerElement(\"https://media.w3.org/2010/05/sintel/trailer.mp4\")\n        with { OnMediaFailed = message => setFailure(message) })\n        .Height(280).Width(480)\n    : Border(BodyStrong(\"Sample stream unavailable\")).Height(280).Width(480);\n\n// Transport controls are enabled by default; AutoPlay is opt-in:\n//   .Set(mpe => mpe.AutoPlay = true)"
    }
  },
