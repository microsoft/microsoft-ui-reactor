  "map-control": {
    "keywords": ["maps", "geolocation", "pan zoom", "markers", "interactive map"],
    "sampleOverride": {
      "header": "Interactive map",
      "code": "// MapControl needs a maps service token — without one it renders an empty\n// viewport and reports no error at all, so check for the token up front.\nvar token = Environment.GetEnvironmentVariable(\"REACTOR_GALLERY_MAP_TOKEN\");\n\nElement map = string.IsNullOrWhiteSpace(token)\n    ? Border(BodyStrong(\"No map service token configured\")).Height(320).Width(480)\n    : MapControl(mapServiceToken: token, zoomLevel: 4).Height(320).Width(480);\n\n// Pan and zoom with mouse/touch. Center and layers are set through .Set(m => { })."
    }
  },
