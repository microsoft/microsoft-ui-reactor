<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Headless unit tests for ReactorRegedit's pure logic (Core/). The app itself is a
    WinUI exe, so instead of referencing it this project compiles the Core sources
    directly. Not part of Reactor.slnx; run with:
      dotnet test samples/apps/regedit/ReactorRegedit.Tests
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <OutputType>Exe</OutputType>
    <RootNamespace>ReactorRegedit.Tests</RootNamespace>
    <ReactorSampleAnalyzers>false</ReactorSampleAnalyzers>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\Core\**\*.cs" Link="Core\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

</Project>
