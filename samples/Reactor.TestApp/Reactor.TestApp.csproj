<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <Platforms>x64;ARM64</Platforms>
    <RootNamespace>Reactor.TestApp</RootNamespace>
    <AssemblyName>Reactor.TestApp</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
  </PropertyGroup>

  <!-- ───────────────────────────────────────────────────────────────────────
    Native TableView control (opt-in). The "TableView" tab consumes the
    Reactor.Controls.TableView first-class control (the projected native
    split-binary Advanced TableView), exactly as a Reactor consumer would. It
    pulls a ~9 MB native dll + a CsWinRT projection, so it defaults OFF in shared
    CI (GITHUB_ACTIONS) to keep every Reactor PR build byte-identical, and ON for
    local dev + the on-demand tableview-control.yml workflow. Force with
    -p:IncludeTableView=true|false.
  ──────────────────────────────────────────────────────────────────────── -->
  <PropertyGroup>
    <IncludeTableView Condition="'$(IncludeTableView)' == '' and '$(GITHUB_ACTIONS)' == 'true'">false</IncludeTableView>
    <IncludeTableView Condition="'$(IncludeTableView)' == ''">true</IncludeTableView>
    <DefineConstants Condition="'$(IncludeTableView)' == 'true'">$(DefineConstants);INCLUDE_TABLEVIEW</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(IncludeTableView)' == 'true'">
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <!--
    Bundle the WindowsAppSDK runtime self-contained when (a) Debug, or (b) the native TableView is
    included. (a) The VS embedded preview panel (spec 056) runs through `dotnet watch run` which
    incrementally re-evaluates the project graph on each save; transitive WindowsAppSDK.* references get
    double-counted and trip Microsoft.WindowsAppSDK.ComponentReference.targets' strict version check
    ("version 2.0.20;2.0.20 was referenced"). Self-contained sidesteps the check.
    (b) REQUIRED for the native split-binary TableView (Advanced.dll) to RENDER: framework-dependent
    activation resolves a WinAppSDK runtime build whose ABI the dev-framework-built Advanced.dll's internal
    realization is not compatible with, so column headers + cells silently fail to generate (empty grid).
    The self-contained local runtime restores full rendering. This only engages when IncludeTableView=true
    (local / on-demand), never in shared CI where IncludeTableView=false.
  -->
  <PropertyGroup Condition="'$(Configuration)' == 'Debug' or '$(IncludeTableView)' == 'true'">
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Reactor\Reactor.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\Icons\*.svg" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\*.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- ── Native TableView control items (gated by IncludeTableView) ──────────── -->
  <PropertyGroup Condition="'$(IncludeTableView)' == 'true'">
    <!--
      Native Advanced.dll flavor selected by sample Configuration. Both flavors are checked in:
        native\fre\  = fre  (free / optimized, NDEBUG)  -> consumed by Release builds, for performance.
        native\chk\  = chk  (checked / asserts, debug)  -> consumed by Debug builds, for debugging.
      ("fre"/"chk" are the WinUI free/checked build flavors; named so to avoid the [Rr]elease/[Dd]ebug
      .gitignore rules.) Falls back to the checked (chk) binary if the optimized one isn't present.
    -->
    <_AdvancedDllDir>fre</_AdvancedDllDir>
    <_AdvancedDllDir Condition="'$(Configuration)' != 'Release'">chk</_AdvancedDllDir>
    <_AdvancedDll>$(MSBuildProjectDirectory)\native\$(_AdvancedDllDir)\Microsoft.UI.Xaml.Controls.Advanced.dll</_AdvancedDll>
    <_AdvancedDll Condition="!Exists('$(_AdvancedDll)')">$(MSBuildProjectDirectory)\native\chk\Microsoft.UI.Xaml.Controls.Advanced.dll</_AdvancedDll>
  </PropertyGroup>
  <ItemGroup Condition="'$(IncludeTableView)' == 'true'">
    <ProjectReference Include="..\TableView.Projection\TableView.Projection.csproj" />
    <!-- The consumable first-class control (referenced exactly as a Reactor consumer would). -->
    <ProjectReference Include="..\Reactor.Controls.TableView\Reactor.Controls.TableView.csproj" />
    <!-- The full 37-page native TableViewSamples gallery (compiled WinUI pages). -->
    <ProjectReference Include="..\TableViewSamples.Embedded\TableViewSamples.Embedded.csproj" />
    <Content Include="$(_AdvancedDll)" Link="Microsoft.UI.Xaml.Controls.Advanced.dll" CopyToOutputDirectory="PreserveNewest" />
    <None Include="TableViewStrings\Resources.resw" />
    <None Include="TableViewStrings\merge-tableview-strings.ps1" />
  </ItemGroup>
  <ItemGroup Condition="'$(IncludeTableView)' != 'true'">
    <Compile Remove="Demos\TableViewFirstClassGallery.cs" />
    <Compile Remove="Demos\TableViewSampleData.cs" />
    <Compile Remove="Demos\TableViewDemo.cs" />
    <Compile Remove="GlobalUsings.TableView.cs" />
  </ItemGroup>

  <!-- Native TableView localized strings -> merged into the app PRI (see merge-tableview-strings.ps1). -->
  <Target Name="MergeTableViewStrings" AfterTargets="Build" Condition="'$(IncludeTableView)' == 'true'">
    <Exec Command="powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\TableViewStrings\merge-tableview-strings.ps1&quot; -OutDir &quot;$(TargetDir.TrimEnd('\'))&quot; -ScriptDir &quot;$(MSBuildProjectDirectory)\TableViewStrings&quot;"
          ContinueOnError="true" />
  </Target>
</Project>

