<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <Platforms>x64;ARM64</Platforms>
    <RootNamespace>Reactor.TestApp</RootNamespace>
    <AssemblyName>Reactor.TestApp</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
  </PropertyGroup>

  <!-- ───────────────────────────────────────────────────────────────────────
    Native TableView control (opt-in). The "TableView" tab consumes the
    Reactor.Controls.TableView first-class control (the projected native
    split-binary Advanced TableView), exactly as a Reactor consumer would. It
    pulls a ~9 MB native dll + a CsWinRT projection, so it defaults OFF in shared
    CI (GITHUB_ACTIONS) to keep every Reactor PR build byte-identical, and ON for
    local dev + the on-demand tableview-control.yml workflow. Force with
    -p:IncludeTableView=true|false.
  ──────────────────────────────────────────────────────────────────────── -->
  <PropertyGroup>
    <IncludeTableView Condition="'$(IncludeTableView)' == '' and '$(GITHUB_ACTIONS)' == 'true'">false</IncludeTableView>
    <IncludeTableView Condition="'$(IncludeTableView)' == ''">true</IncludeTableView>
    <DefineConstants Condition="'$(IncludeTableView)' == 'true'">$(DefineConstants);INCLUDE_TABLEVIEW</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(IncludeTableView)' == 'true'">
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <!--
    Debug builds only: bundle the WindowsAppSDK runtime self-contained. The VS
    embedded preview panel (spec 056) runs through `dotnet watch run` which
    incrementally re-evaluates the project graph on each save; transitive
    WindowsAppSDK.* references get double-counted and trip
    Microsoft.WindowsAppSDK.ComponentReference.targets' strict version check
    ("version 2.0.20;2.0.20 was referenced"). Self-contained sidesteps the
    check. Only matters in Debug because Release/CI builds don't hot-reload.
  -->
  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Reactor\Reactor.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\Icons\*.svg" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\*.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- ── Native TableView control items (gated by IncludeTableView) ──────────── -->
  <ItemGroup Condition="'$(IncludeTableView)' == 'true'">
    <ProjectReference Include="..\TableView.Projection\TableView.Projection.csproj" />
    <!-- The consumable first-class control (referenced exactly as a Reactor consumer would). -->
    <ProjectReference Include="..\Reactor.Controls.TableView\Reactor.Controls.TableView.csproj" />
    <Content Include="Microsoft.UI.Xaml.Controls.Advanced.dll" CopyToOutputDirectory="PreserveNewest" />
    <None Include="TableViewStrings\Resources.resw" />
    <None Include="TableViewStrings\merge-tableview-strings.ps1" />
  </ItemGroup>
  <ItemGroup Condition="'$(IncludeTableView)' != 'true'">
    <Compile Remove="Demos\TableViewControlDemo.cs" />
    <Compile Remove="GlobalUsings.TableView.cs" />
  </ItemGroup>

  <!-- Native TableView localized strings -> merged into the app PRI (see merge-tableview-strings.ps1). -->
  <Target Name="MergeTableViewStrings" AfterTargets="Build" Condition="'$(IncludeTableView)' == 'true'">
    <Exec Command="powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\TableViewStrings\merge-tableview-strings.ps1&quot; -OutDir &quot;$(TargetDir.TrimEnd('\'))&quot; -ScriptDir &quot;$(MSBuildProjectDirectory)\TableViewStrings&quot;"
          ContinueOnError="true" />
  </Target>
</Project>

