<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <Platforms>x64;ARM64</Platforms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <RootNamespace>WinUIGalleryReactor</RootNamespace>
    <AssemblyName>ReactorGallery</AssemblyName>
    <!-- Override the default WinUI.ico (from samples/Directory.Build.props) with the
         WinUI Gallery logo, sourced from microsoft/WinUI-Gallery. -->
    <ApplicationIcon>Assets\GalleryIcon.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Reactor\Reactor.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="Assets\ControlImages\**" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\GalleryIcon.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
