<Project>

  <!--
    Microsoft.UI.Reactor.TableView — consumer-side targets.

    The native TableView ships as a separate WinRT component (Microsoft.UI.Xaml.Controls.Advanced.dll,
    deployed by NuGet from runtimes/win-x64/native/). WinRT activation needs the consumer's application
    manifest to map the TableView runtimeclasses to that DLL. If the consuming app has not declared its
    own ApplicationManifest, supply the one bundled in this package so the control activates out of the box.

    Unpackaged (WindowsPackageType=None) win-x64 apps only — packaged (MSIX) apps declare activation in
    their package manifest instead.
  -->
  <PropertyGroup Condition="'$(ApplicationManifest)' == '' and '$(WindowsPackageType)' == 'None'">
    <ApplicationManifest>$(MSBuildThisFileDirectory)app.manifest</ApplicationManifest>
  </PropertyGroup>

  <!--
    This POC ships an UNSHIPPED native satellite (Microsoft.UI.Xaml.Controls.Advanced.dll) whose WinRT
    types are not in the installed public WinAppSDK runtime. Framework-dependent activation then resolves
    an incompatible runtime and the control renders a blank body. Until the native TableView ships in
    public WinAppSDK, the consuming app must deploy a matching local runtime via
    WindowsAppSDKSelfContained=true. Warn (don't fail) so the requirement is visible instead of surfacing
    as a mystifying empty grid. Unpackaged win-x64 apps only.
  -->
  <Target Name="_WarnTableViewSelfContained" BeforeTargets="Build"
          Condition="'$(WindowsAppSDKSelfContained)' != 'true' and '$(WindowsPackageType)' == 'None'">
    <Warning Code="RTV0001"
             Text="Microsoft.UI.Reactor.TableView (POC) needs &lt;WindowsAppSDKSelfContained&gt;true&lt;/WindowsAppSDKSelfContained&gt; in your app project to render. Without it, the vendored native TableView activates against an incompatible installed WinAppSDK runtime and shows a blank table. This requirement goes away once the native control ships in public WinAppSDK." />
  </Target>

  <!--
    Merge the native control's localized SR_TableView* strings into the consumer's app PRI. The
    public WinAppSDK 2.0.1 PRI does not carry them, and native row/header realization throws without
    them, so the control would render a blank body. Unpackaged win-x64 apps only.
  -->
  <Target Name="_MergeTableViewStrings" AfterTargets="Build"
          Condition="'$(WindowsPackageType)' == 'None'">
    <Exec ContinueOnError="true"
          Command="powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildThisFileDirectory)merge-tableview-strings.ps1&quot; -OutDir &quot;$(TargetDir.TrimEnd('\'))&quot; -ScriptDir &quot;$(MSBuildThisFileDirectory.TrimEnd('\'))&quot; -AppPriName $(TargetName).pri" />
  </Target>

</Project>
