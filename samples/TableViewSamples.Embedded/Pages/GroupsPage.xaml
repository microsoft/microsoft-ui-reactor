<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="TableViewSamples.Pages.GroupsPage"
    NavigationCacheMode="Enabled"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:controls="using:TableViewSamples.Controls"
    xmlns:models="using:TableViewSamples.Models">

    <controls:SamplePresenter
        Header="Grouped rows"
        Description="Grouped data shape, group headers, and bulk expand / collapse buttons."
        SourceCaption="GroupsPage.xaml (excerpt)"
        SourceSnippet="Groups.xaml.txt"
        StretchExample="True">

        <controls:SamplePresenter.Example>
            <Grid RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <muxc:InfoBar
                    Grid.Row="0"
                    IsOpen="True"
                    IsClosable="False"
                    Severity="Informational"
                    Title="Try it"
                    Message="Toggle grouping, then expand / collapse groups or click a header to sort within each group. Funnels filter rows inside each group."/>
                <Border Grid.Row="1" Style="{StaticResource TableHostBorderStyle}" VerticalAlignment="Stretch">
                    <muxc:TableView
                        x:Name="PeopleTableControl"
                        AutomationProperties.AutomationId="PeopleTable"
                        VerticalAlignment="Stretch"
                        MinHeight="320">
                        <!-- Default group-header chrome (chevron + group key) is used.
                             Per-group counts are surfaced in the Options pane instead of
                             a custom header template, keeping the chevron affordance intact. -->
                        <muxc:TableView.Columns>
                            <muxc:TableViewTextColumn Header="First name" Width="{StaticResource ColWidthShortName}" Binding="{Binding FirstName}" SortMemberPath="FirstName"/>
                            <muxc:TableViewTextColumn Header="Last name"  Width="{StaticResource ColWidthShortName}" Binding="{Binding LastName}"  SortMemberPath="LastName"/>
                            <muxc:TableViewTextColumn Header="Role"       Width="{StaticResource ColWidthLongName}" Binding="{Binding Role}"       SortMemberPath="Role"/>
                            <muxc:TableViewTextColumn Header="Salary"     Width="{StaticResource ColWidthNumber}" Binding="{Binding Salary}"     SortMemberPath="Salary"/>
                            <muxc:TableViewTextColumn Header="Join date"  Width="{StaticResource ColWidthDate}" Binding="{Binding JoinDateText}" SortMemberPath="JoinDate"/>
                        </muxc:TableView.Columns>
                    </muxc:TableView>
                </Border>
            </Grid>
        </controls:SamplePresenter.Example>

        <controls:SamplePresenter.Options>
            <StackPanel Spacing="12">
                <TextBlock Text="Grouping controls" Style="{StaticResource SectionHeaderTextStyle}"/>
                <TextBlock
                    Text="Toggle grouping, reshuffle departments, or expand/collapse every group using the sample's grouped-row headers."
                    Style="{StaticResource SectionDescriptionTextStyle}"
                    TextWrapping="Wrap"/>
                <ToggleSwitch
                    x:Name="GroupingToggleControl"
                    Header="Group by Department"
                    IsOn="True"
                    OffContent="Off"
                    OnContent="On"
                    Toggled="OnGroupingToggled"
                    HorizontalAlignment="Stretch"/>
                <StackPanel Spacing="8">
                    <Button x:Name="ShuffleButton" AutomationProperties.AutomationId="ShuffleButton" Click="OnShuffleClick" Content="Shuffle ~25% of people across departments" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                    <Button x:Name="ExpandAllButton" AutomationProperties.AutomationId="ExpandAllButton" Click="OnExpandAllClick" Content="Expand all" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                    <Button x:Name="CollapseAllButton" AutomationProperties.AutomationId="CollapseAllButton" Click="OnCollapseAllClick" Content="Collapse all" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                </StackPanel>

                <TextBlock Text="Status" Style="{StaticResource SectionHeaderTextStyle}" Margin="0,8,0,0"/>
                <Grid ColumnSpacing="12" RowSpacing="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="IsGrouping" Style="{StaticResource StatusReadoutLabelStyle}"/>
                    <TextBlock x:Name="IsGroupingTextBlock" Grid.Row="0" Grid.Column="1" Style="{StaticResource StatusReadoutValueStyle}" AutomationProperties.AutomationId="IsGroupingText"/>
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Group count" Style="{StaticResource StatusReadoutLabelStyle}"/>
                    <TextBlock x:Name="GroupCountTextBlock" Grid.Row="1" Grid.Column="1" Style="{StaticResource StatusReadoutValueStyle}" AutomationProperties.AutomationId="GroupCountText"/>
                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Total people" Style="{StaticResource StatusReadoutLabelStyle}"/>
                    <TextBlock x:Name="TotalPeopleTextBlock" Grid.Row="2" Grid.Column="1" Style="{StaticResource StatusReadoutValueStyle}" AutomationProperties.AutomationId="TotalPeopleText"/>
                    <TextBlock Grid.Row="3" Grid.Column="0" VerticalAlignment="Top" Text="Source shape" Style="{StaticResource StatusReadoutLabelStyle}"/>
                    <TextBlock x:Name="SourceShapeTextBlock" Grid.Row="3" Grid.Column="1" Style="{StaticResource StatusReadoutValueStyle}" AutomationProperties.AutomationId="SourceShapeText" TextWrapping="Wrap"/>
                    <TextBlock Grid.Row="4" Grid.Column="0" VerticalAlignment="Top" Text="Per-group counts" Style="{StaticResource StatusReadoutLabelStyle}"/>
                    <TextBlock x:Name="PerGroupCountsTextBlock" Grid.Row="4" Grid.Column="1" Style="{StaticResource StatusReadoutValueStyle}" AutomationProperties.AutomationId="PerGroupCountsText" TextWrapping="Wrap"/>
                </Grid>

                <TextBlock Text="Group lifecycle events" Style="{StaticResource SectionHeaderTextStyle}" Margin="0,8,0,0"/>
                <TextBlock
                    Text="TableView fires GroupExpanding / GroupCollapsing (cancelable) and GroupExpanded / GroupCollapsed (notification) for every per-group transition. ExpandAllGroups / CollapseAllGroups raise the events once PER group with per-group Cancel semantics. The log below shows the most recent 12 raises."
                    Style="{StaticResource SectionDescriptionTextStyle}"
                    TextWrapping="Wrap"/>
                <CheckBox x:Name="CancelExpandingCheckBox" AutomationProperties.AutomationId="CancelExpandingCheckBox" Content="Cancel GroupExpanding"/>
                <CheckBox x:Name="CancelCollapsingCheckBox" AutomationProperties.AutomationId="CancelCollapsingCheckBox" Content="Cancel GroupCollapsing"/>
                <Button x:Name="ClearEventLogButton" AutomationProperties.AutomationId="ClearEventLogButton" Click="OnClearEventLogClick" Content="Clear log" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                <Border Padding="8" BorderThickness="1" CornerRadius="4" Background="{ThemeResource SystemControlBackgroundChromeMediumLowBrush}">
                    <TextBlock x:Name="GroupEventLogTextBlock"
                               AutomationProperties.AutomationId="GroupEventLogText"
                               TextWrapping="Wrap"
                               FontFamily="Consolas"
                               FontSize="12"
                               MinHeight="120"/>
                </Border>
                <TextBlock
                    Text="Tip: use a group chevron for one department, or the bulk buttons to expand/collapse every department."
                    Style="{StaticResource SectionDescriptionTextStyle}"
                    TextWrapping="Wrap"/>
            </StackPanel>
        </controls:SamplePresenter.Options>

    </controls:SamplePresenter>
</Page>
