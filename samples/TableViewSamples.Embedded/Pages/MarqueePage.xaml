<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="TableViewSamples.Pages.MarqueePage"
    NavigationCacheMode="Enabled"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:controls="using:TableViewSamples.Controls">

    <controls:SamplePresenter
        Header="Drag-selection rectangle"
        Description="Press and drag in the table's empty space to draw a rectangular marquee. On release, every row the rectangle touches is selected, replacing the current selection."
        SourceCaption="MarqueePage.xaml (excerpt)"
        SourceSnippet="Marquee.xaml.txt"
        StretchExample="True">

        <controls:SamplePresenter.Example>
            <Grid RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <muxc:InfoBar Grid.Row="0" IsOpen="True" Severity="Informational" IsClosable="False" Title="Try it" MinHeight="104" Message="Click and drag in an empty area of the table to draw a selection rectangle; on release, the rows it touches are selected."/>
                <Border Grid.Row="1" Style="{StaticResource TableHostBorderStyle}" VerticalAlignment="Stretch">
                    <muxc:TableView x:Name="PeopleTable" AutomationProperties.AutomationId="PeopleTable" SelectionMode="Extended" CanUserMarqueeSelect="True" ItemsSource="{x:Bind People}" SelectionChanged="OnTableSelectionChanged" VerticalAlignment="Stretch" MinHeight="320">
                        <muxc:TableViewTextColumn Header="First name" Width="{StaticResource ColWidthShortName}" Binding="{Binding FirstName}" CanUserSort="False" CanUserFilter="False"/>
                        <muxc:TableViewTextColumn Header="Last name"  Width="{StaticResource ColWidthShortName}" Binding="{Binding LastName}" CanUserSort="False" CanUserFilter="False"/>
                        <muxc:TableViewTextColumn Header="Department" Width="{StaticResource ColWidthDepartment}" Binding="{Binding Department}" CanUserSort="False" CanUserFilter="False"/>
                        <muxc:TableViewTextColumn Header="Role"       Width="{StaticResource ColWidthLongName}" Binding="{Binding Role}" CanUserSort="False" CanUserFilter="False"/>
                        <muxc:TableViewTextColumn Header="Salary"     Width="{StaticResource ColWidthNumber}" Binding="{Binding Salary}" CanUserSort="False" CanUserFilter="False"/>
                    </muxc:TableView>
                </Border>
            </Grid>
        </controls:SamplePresenter.Example>

        <controls:SamplePresenter.Options>
            <StackPanel Spacing="12">
                <TextBlock Text="Marquee controls" Style="{StaticResource SectionHeaderTextStyle}"/>
                <TextBlock Text="Ready to try: marquee is ON and the table starts in Extended selection mode. Click and drag with the left mouse button in the blank area below the last row to draw a selection rectangle, then release to commit the selection." Style="{StaticResource SectionDescriptionTextStyle}" TextWrapping="Wrap"/>
                <TextBlock x:Name="GestureStatusText" AutomationProperties.AutomationId="GestureStatusText" Text="Ready — drag in the blank area below the last row." FontWeight="SemiBold" TextWrapping="Wrap"/>
                <ToggleSwitch x:Name="MarqueeSelectToggle" AutomationProperties.AutomationId="MarqueeSelectToggle" Header="CanUserMarqueeSelect" IsOn="True" OnContent="On" OffContent="Off" Toggled="OnMarqueeSelectToggled"/>
                <ComboBox x:Name="SelectionModeCombo" AutomationProperties.AutomationId="SelectionModeCombo" Header="SelectionMode" SelectedIndex="3" SelectionChanged="OnSelectionModeChanged" HorizontalAlignment="Stretch">
                    <x:String>None</x:String><x:String>Single</x:String><x:String>Multiple</x:String><x:String>Extended</x:String>
                </ComboBox>
                <Button x:Name="ClearSelectionButton" AutomationProperties.AutomationId="ClearSelectionButton" Content="Clear selection" Click="OnClearSelectionClick" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                <TextBlock Text="Status" Style="{StaticResource SectionHeaderTextStyle}" Margin="0,8,0,0"/>
                <Grid ColumnSpacing="12" RowSpacing="4">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Gesture state" Style="{StaticResource StatusReadoutLabelStyle}"/>
                    <TextBlock Grid.Row="0" Grid.Column="1" x:Name="ReadoutGestureStatusText" Text="Ready — drag below the last row." Style="{StaticResource StatusReadoutValueStyle}" AutomationProperties.AutomationId="ReadoutGestureStatusText" TextWrapping="Wrap"/>
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Rows loaded" Style="{StaticResource StatusReadoutLabelStyle}"/>
                    <TextBlock Grid.Row="1" Grid.Column="1" x:Name="RowsLoadedText" Text="0" Style="{StaticResource StatusReadoutValueStyle}" AutomationProperties.AutomationId="RowsLoadedText"/>
                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Selected count" Style="{StaticResource StatusReadoutLabelStyle}"/>
                    <TextBlock Grid.Row="2" Grid.Column="1" x:Name="SelectedCountText" Text="0" Style="{StaticResource StatusReadoutValueStyle}" AutomationProperties.AutomationId="SelectedCountText"/>
                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Selected indices / ranges" Style="{StaticResource StatusReadoutLabelStyle}"/>
                    <StackPanel Grid.Row="3" Grid.Column="1" Spacing="4">
                        <TextBlock x:Name="SelectedIndicesText" Text="(none)" Style="{StaticResource StatusReadoutValueStyle}" AutomationProperties.AutomationId="SelectedIndicesText" TextWrapping="Wrap"/>
                        <TextBlock x:Name="CommitRangesText" Text="(none)" Style="{StaticResource StatusReadoutValueStyle}" AutomationProperties.AutomationId="CommitRangesText" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </controls:SamplePresenter.Options>
    </controls:SamplePresenter>
</Page>
