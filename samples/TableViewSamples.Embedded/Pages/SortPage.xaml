<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="TableViewSamples.Pages.SortPage"
    NavigationCacheMode="Enabled"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:controls="using:TableViewSamples.Controls">

    <controls:SamplePresenter
        Header="Multi-column sort"
        Description="Sport-standings ordering — group, then points desc, then goal difference desc as tiebreaker — is the textbook multi-key sort. Click a header to replace the sort. Ctrl-click to layer additional levels: the small badge next to the chevron shows priority order (1, 2, 3…). The badge appears only when 2+ columns are sorted simultaneously — a single sort stands alone unambiguously."
        SourceCaption="SortPage.xaml (excerpt)"
        SourceSnippet="Sort.xaml.txt"
        AdditionalSnippetCaption="SortPage.xaml.cs (excerpt)"
        AdditionalSnippet="Sort.cs.txt"
        StretchExample="True">

        <controls:SamplePresenter.Example>
            <Grid RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <muxc:InfoBar
                    Grid.Row="0"
                    IsOpen="True"
                    IsClosable="False"
                    Severity="Informational"
                    Title="Try it"
                    Message="Click a column header to sort; Ctrl-click another header to add a secondary sort. Use the buttons for one-click sort presets."
                    MinHeight="104"/>
                <Border Grid.Row="1" Style="{StaticResource TableHostBorderStyle}" VerticalAlignment="Stretch">
                    <muxc:TableView
                        x:Name="TeamsTable"
                        ItemsSource="{x:Bind Teams, Mode=OneWay}"
                        SelectionMode="Single"
                        Sorted="OnTableSorted"
                        Filtered="OnTableFiltered"
                        VerticalAlignment="Stretch"
                        MinHeight="320">
                        <muxc:TableViewTextColumn x:Name="GroupColumn"          Header="Group"  Width="{StaticResource ColWidthNumber}"  SortMemberPath="Group"          CanUserFilter="False" Binding="{Binding Group}"/>
                        <muxc:TableViewTextColumn x:Name="TeamColumn"           Header="Team"   Width="{StaticResource ColWidthDepartment}" SortMemberPath="Team"           CanUserFilter="False" Binding="{Binding Team}"/>
                        <muxc:TableViewTextColumn x:Name="PlayedColumn"         Header="P"      Width="{StaticResource ColWidthNumber}"  CanUserSort="False"             CanUserFilter="False" Binding="{Binding Played}"/>
                        <muxc:TableViewTextColumn x:Name="WinsColumn"           Header="W"      Width="{StaticResource ColWidthNumber}"  SortMemberPath="Wins"           CanUserFilter="False" Binding="{Binding Wins}"/>
                        <muxc:TableViewTextColumn x:Name="DrawsColumn"          Header="D"      Width="{StaticResource ColWidthNumber}"  SortMemberPath="Draws"          CanUserFilter="False" Binding="{Binding Draws}"/>
                        <muxc:TableViewTextColumn x:Name="LossesColumn"         Header="L"      Width="{StaticResource ColWidthNumber}"  SortMemberPath="Losses"         CanUserFilter="False" Binding="{Binding Losses}"/>
                        <muxc:TableViewTextColumn x:Name="GoalsForColumn"       Header="GF"     Width="{StaticResource ColWidthNumber}"  SortMemberPath="GoalsFor"       CanUserFilter="False" Binding="{Binding GoalsFor}"/>
                        <muxc:TableViewTextColumn x:Name="GoalsAgainstColumn"   Header="GA"     Width="{StaticResource ColWidthNumber}"  SortMemberPath="GoalsAgainst"   CanUserFilter="False" Binding="{Binding GoalsAgainst}"/>
                        <muxc:TableViewTextColumn x:Name="GoalDifferenceColumn" Header="GD"     Width="{StaticResource ColWidthNumber}"  SortMemberPath="GoalDifference" CanUserFilter="False" Binding="{Binding GoalDifference}"/>
                        <muxc:TableViewTextColumn x:Name="PointsColumn"         Header="Pts"    Width="{StaticResource ColWidthNumber}"  SortMemberPath="Points"         CanUserFilter="False" Binding="{Binding Points}"/>
                    </muxc:TableView>
                </Border>
            </Grid>
        </controls:SamplePresenter.Example>

        <controls:SamplePresenter.Options>
            <StackPanel Spacing="12">
                <TextBlock Text="Programmatic sort" Style="{StaticResource SectionHeaderTextStyle}"/>
                <TextBlock
                    Text="Build a multi-column sort from code. Each button adds or changes a sort level, and the table — with its header arrows and priority badges — updates to match. &#x201C;Official standings&#x201D; (highlighted) applies the full standings sort in one click: Group, then Points, then Goal Difference."
                    Style="{StaticResource SectionDescriptionTextStyle}"
                    TextWrapping="Wrap"/>
                <StackPanel Spacing="8">
                    <Button Content="Sort by Pts (desc)" Click="OnSortPointsDescClick" AutomationProperties.AutomationId="SortPointsDescButton" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                    <Button Content="Add Group (asc)" Click="OnAddGroupAscClick" AutomationProperties.AutomationId="AddGroupAscButton" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                    <Button Content="Add GD (desc)" Click="OnAddGoalDifferenceDescClick" AutomationProperties.AutomationId="AddGoalDifferenceDescButton" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                    <Button Content="Official standings" Click="OnOfficialStandingsClick" AutomationProperties.AutomationId="OfficialStandingsButton" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                    <Button Content="Toggle Pts" Click="OnTogglePointsClick" AutomationProperties.AutomationId="TogglePointsButton" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                    <Button Content="Clear sort" Click="OnClearSortClick" AutomationProperties.AutomationId="ClearSortButton" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                </StackPanel>

                <TextBlock Text="Status" Style="{StaticResource SectionHeaderTextStyle}" Margin="0,8,0,0"/>
                <Grid ColumnSpacing="12" RowSpacing="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Sorted fires" Style="{StaticResource StatusReadoutLabelStyle}"/>
                    <TextBlock Grid.Row="0" Grid.Column="1" x:Name="SortedFiredCountText" Text="0" Style="{StaticResource StatusReadoutValueStyle}" AutomationProperties.AutomationId="SortedFiredCountText"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Trigger column" Style="{StaticResource StatusReadoutLabelStyle}"/>
                    <TextBlock Grid.Row="1" Grid.Column="1" x:Name="TriggerColumnText" Text="(none)" Style="{StaticResource StatusReadoutValueStyle}" AutomationProperties.AutomationId="TriggerColumnText" TextWrapping="Wrap"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Sort priority" Style="{StaticResource StatusReadoutLabelStyle}" VerticalAlignment="Top"/>
                    <TextBlock Grid.Row="2" Grid.Column="1" x:Name="SortPriorityListText" Text="(none)" Style="{StaticResource StatusReadoutValueStyle}" AutomationProperties.AutomationId="SortPriorityListText" TextWrapping="Wrap"/>

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Visible rows" Style="{StaticResource StatusReadoutLabelStyle}"/>
                    <TextBlock Grid.Row="3" Grid.Column="1" x:Name="VisibleRowsText" Text="0 / 0" Style="{StaticResource StatusReadoutValueStyle}" AutomationProperties.AutomationId="VisibleRowsText"/>

                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Top 5 after sort" Style="{StaticResource StatusReadoutLabelStyle}" VerticalAlignment="Top"/>
                    <TextBlock Grid.Row="4" Grid.Column="1" x:Name="TopRowsPreviewText" Text="(load…)" Style="{StaticResource StatusReadoutValueStyle}" AutomationProperties.AutomationId="TopRowsPreviewText" TextWrapping="Wrap"/>
                </Grid>
            </StackPanel>
        </controls:SamplePresenter.Options>

    </controls:SamplePresenter>
</Page>
