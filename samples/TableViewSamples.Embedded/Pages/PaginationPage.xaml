<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="TableViewSamples.Pages.PaginationPage"
    NavigationCacheMode="Enabled"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:controls="using:TableViewSamples.Controls">

    <controls:SamplePresenter
        Header="Pagination"
        Description="Page through 1,000 records, 50 at a time. Demonstrates driving TableView.ItemsSource from a paged window over a large in-memory list — useful when the data is server-paged, file-backed, or otherwise unsuitable for full virtualization."
        SourceCaption="PaginationPage.xaml.cs (excerpt)"
        SourceSnippet="Pagination.cs.txt"
        StretchExample="True">

        <controls:SamplePresenter.Example>
            <Grid RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <muxc:InfoBar
                    Grid.Row="0"
                    IsOpen="True"
                    IsClosable="False"
                    Severity="Informational"
                    Title="Try it"
                    Message="Use First / Prev / Next / Last or type a page number. Change the page size to rebuild the current page."
                    MinHeight="104"/>
                <Border Grid.Row="1" Style="{StaticResource TableHostBorderStyle}" VerticalAlignment="Stretch">
                    <muxc:TableView
                        x:Name="PeopleTable"
                        AutomationProperties.AutomationId="PeopleTable"
                        ItemsSource="{x:Bind PageRows, Mode=OneWay}"
                        SelectionMode="Single"
                        VerticalAlignment="Stretch"
                        MinHeight="320">
                        <muxc:TableViewTextColumn Header="First name" Width="{StaticResource ColWidthLongName}"   Binding="{Binding FirstName}"  CanUserSort="False" CanUserFilter="False"/>
                        <muxc:TableViewTextColumn Header="Last name"  Width="{StaticResource ColWidthLongName}"   Binding="{Binding LastName}"   CanUserSort="False" CanUserFilter="False"/>
                        <muxc:TableViewTextColumn Header="Email"      Width="{StaticResource ColWidthEmail}"      Binding="{Binding Email}"      CanUserSort="False" CanUserFilter="False"/>
                        <muxc:TableViewTextColumn Header="Department" Width="{StaticResource ColWidthDepartment}" Binding="{Binding Department}" CanUserSort="False" CanUserFilter="False"/>
                        <muxc:TableViewTextColumn Header="Role"       Width="{StaticResource ColWidthLongName}"   Binding="{Binding Role}"       CanUserSort="False" CanUserFilter="False"/>
                        <muxc:TableViewTextColumn Header="Join date"  Width="{StaticResource ColWidthDate}"        Binding="{Binding JoinDateText}" CanUserSort="False" CanUserFilter="False"/>
                        <muxc:TableViewTextColumn Header="Salary"     Width="{StaticResource ColWidthNumber}"      Binding="{Binding Salary}"     CanUserSort="False" CanUserFilter="False"/>
                    </muxc:TableView>
                </Border>
            </Grid>
        </controls:SamplePresenter.Example>

        <controls:SamplePresenter.Options>
            <StackPanel Spacing="12">
                <TextBlock Text="Page controls" Style="{StaticResource SectionHeaderTextStyle}"/>
                <TextBlock
                    Text="Pick a page size, jump to a page, or step through the current page window."
                    Style="{StaticResource SectionDescriptionTextStyle}"
                    TextWrapping="Wrap"/>
                <ComboBox
                    x:Name="PageSizeCombo"
                    AutomationProperties.AutomationId="PageSizeCombo"
                    Header="Page size"
                    SelectedIndex="1"
                    Width="80"
                    HorizontalAlignment="Left"
                    SelectionChanged="OnPageSizeChanged">
                    <x:String>25</x:String>
                    <x:String>50</x:String>
                    <x:String>100</x:String>
                </ComboBox>

                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button
                        Grid.Column="0"
                        x:Name="FirstPageButton"
                        AutomationProperties.AutomationId="FirstPageButton"
                        Content="« First"
                        Click="OnFirstClick"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"/>
                    <Button
                        Grid.Column="1"
                        x:Name="PrevPageButton"
                        AutomationProperties.AutomationId="PrevPageButton"
                        Content="‹ Prev"
                        Click="OnPrevClick"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"/>
                </Grid>

                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock Text="Page" VerticalAlignment="Center"/>
                    <TextBox
                        x:Name="PageNumberBox"
                        AutomationProperties.AutomationId="PageNumberBox"
                        AutomationProperties.Name="Page number"
                        Width="56"
                        VerticalAlignment="Center"
                        InputScope="Number"
                        KeyDown="OnPageNumberKeyDown"
                        LostFocus="OnPageNumberLostFocus"/>
                    <TextBlock
                        x:Name="PageOfText"
                        AutomationProperties.AutomationId="PageOfText"
                        VerticalAlignment="Center"
                        Text="of —"/>
                </StackPanel>

                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button
                        Grid.Column="0"
                        x:Name="NextPageButton"
                        AutomationProperties.AutomationId="NextPageButton"
                        Content="Next ›"
                        Click="OnNextClick"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"/>
                    <Button
                        Grid.Column="1"
                        x:Name="LastPageButton"
                        AutomationProperties.AutomationId="LastPageButton"
                        Content="Last »"
                        Click="OnLastClick"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"/>
                </Grid>

                <TextBlock Text="Status" Style="{StaticResource SectionHeaderTextStyle}" Margin="0,8,0,0"/>
                <TextBlock
                    x:Name="RangeStatusText"
                    AutomationProperties.AutomationId="RangeStatusText"
                    Style="{StaticResource StatusReadoutValueStyle}"
                    Text="—"/>

                <muxc:InfoBar
                    IsOpen="True"
                    IsClosable="False"
                    Severity="Informational"
                    Title="What this sample proves"
                    Message="The TableView never sees the full 1,000-row source. On every page change the code-behind refills a small ObservableCollection — bound once to ItemsSource — with just the current window's rows. Selection clears per page by design — production apps that need per-row selection state should keep a side dictionary keyed by row identity (not by index, because indices shift)."/>
            </StackPanel>
        </controls:SamplePresenter.Options>

    </controls:SamplePresenter>
</Page>
