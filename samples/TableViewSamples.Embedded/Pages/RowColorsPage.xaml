<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="TableViewSamples.Pages.RowColorsPage"
    NavigationCacheMode="Enabled"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:controls="using:TableViewSamples.Controls">

    <Page.Resources>
        <ResourceDictionary>
            <!-- Default banding uses Excel-style hardcoded white + #F0F0F0 backgrounds
                 with dark text (set in code-behind) so the table reads consistently
                 in Light, Dark, and HighContrast. -->
        </ResourceDictionary>
    </Page.Resources>

    <controls:SamplePresenter
        Header="Row colors (banding)"
        Description="Opt in to per-row brushes with four properties: RowBackground / AlternatingRowBackground paint row backgrounds, and RowForeground / AlternatingRowForeground set row text color. All four default to null, so rows stay unbanded until you set them — set both background brushes to enable zebra striping."
        SourceCaption="RowColorsPage.xaml.cs (excerpt)"
        SourceSnippet="RowColors.cs.txt"
        StretchExample="True">

        <controls:SamplePresenter.Example>
            <Grid RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <muxc:InfoBar
                    Grid.Row="0"
                    IsOpen="True"
                    IsClosable="False"
                    Severity="Informational"
                    Title="Try it"
                    Message="Pick a preset to set row and alternating-row background / foreground colors. Each click instantly re-tints the rows; 'No banding' clears them."
                    MinHeight="80"/>
                <Border Grid.Row="1" Style="{StaticResource TableHostBorderStyle}" VerticalAlignment="Stretch" Padding="0">
                    <muxc:TableView
                        x:Name="PeopleTable"
                        AutomationProperties.AutomationId="PeopleTable"
                        ItemsSource="{x:Bind People, Mode=OneWay}"
                        SelectionMode="Extended"
                        VerticalAlignment="Stretch"
                        MinHeight="320">
                        <muxc:TableViewTextColumn Header="First name" Width="{StaticResource ColWidthShortName}" Binding="{Binding FirstName}" CanUserSort="False" CanUserFilter="False"/>
                        <muxc:TableViewTextColumn Header="Last name"  Width="{StaticResource ColWidthShortName}" Binding="{Binding LastName}" CanUserSort="False" CanUserFilter="False"/>
                        <muxc:TableViewTextColumn Header="Department" Width="{StaticResource ColWidthDepartment}" Binding="{Binding Department}" CanUserSort="False" CanUserFilter="False"/>
                        <muxc:TableViewTextColumn Header="Role"       Width="{StaticResource ColWidthLongName}" Binding="{Binding Role}" CanUserSort="False" CanUserFilter="False"/>
                        <muxc:TableViewTextColumn Header="Salary"     Width="{StaticResource ColWidthNumber}" Binding="{Binding Salary}" CanUserSort="False" CanUserFilter="False"/>
                    </muxc:TableView>
                </Border>
            </Grid>
        </controls:SamplePresenter.Example>

        <controls:SamplePresenter.Options>
            <muxc:RadioButtons
                x:Name="PresetPicker"
                AutomationProperties.AutomationId="PresetPicker"
                AutomationProperties.Name="Row color preset"
                SelectedIndex="0"
                SelectionChanged="OnPresetChanged">
                <x:String>Default banding — theme-aware row colors</x:String>
                <x:String>No banding — clear all row colors</x:String>
                <x:String>Custom banding — sky blue and cloud white</x:String>
                <x:String>Single color — every row the same shade</x:String>
                <x:String>Salary emphasis — gold text on even rows, white on odd</x:String>
                <x:String>Dark contrast — black and charcoal rows, white text</x:String>
            </muxc:RadioButtons>
        </controls:SamplePresenter.Options>

    </controls:SamplePresenter>
</Page>
