<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="TableViewSamples.Pages.AdvancedFilterPage"
    NavigationCacheMode="Enabled"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:controls="using:TableViewSamples.Controls">

    <controls:SamplePresenter
        Header="Advanced filter UI"
        Description="The funnel button on each column header opens a flyout where users build typed predicates (Contains, Equals, IsEmpty, …) per column. This sample shows how to narrow the operator vocabulary per column, swap in a custom flyout, and suppress the funnel entirely on a column-by-column basis."
        SourceCaption="AdvancedFilterPage.xaml (excerpt)"
        SourceSnippet="AdvancedFilter.xaml.txt"
        StretchExample="True">

        <controls:SamplePresenter.Example>
            <Grid RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <muxc:InfoBar
                    Grid.Row="0"
                    IsOpen="True"
                    IsClosable="False"
                    Severity="Informational"
                    Title="Try it"
                    Message="Click the funnel on each column header — every column shows a different filter surface (default, custom flyout, narrowed, or suppressed). Click Clear all filters to reset."
                    MinHeight="104"/>
                <Border Grid.Row="1" Style="{StaticResource TableHostBorderStyle}" VerticalAlignment="Stretch">
                    <muxc:TableView
                        x:Name="PeopleTable"
                        ItemsSource="{x:Bind People, Mode=OneWay}"
                        SelectionMode="Single"
                        Filtered="OnTableFiltered"
                        FilterFlyoutOpening="OnFilterFlyoutOpening"
                        VerticalAlignment="Stretch"
                        MinHeight="320">
                        <muxc:TableViewTextColumn x:Name="FirstNameColumn"  Header="First name" Width="{StaticResource ColWidthShortName}" Binding="{Binding FirstName}" SortMemberPath="FirstName" CanUserSort="False"/>
                        <muxc:TableViewTextColumn x:Name="LastNameColumn"   Header="Last name"  Width="{StaticResource ColWidthShortName}" Binding="{Binding LastName}"  SortMemberPath="LastName" CanUserSort="False"/>
                        <muxc:TableViewTextColumn x:Name="DepartmentColumn" Header="Department" Width="{StaticResource ColWidthDepartment}" Binding="{Binding Department}" SortMemberPath="Department" CanUserSort="False"/>
                        <muxc:TableViewTextColumn x:Name="RoleColumn" Header="Role" Width="{StaticResource ColWidthLongName}" Binding="{Binding Role}" SortMemberPath="Role" CanUserSort="False"/>
                        <muxc:TableViewTextColumn x:Name="EmailColumn" Header="Email" Width="{StaticResource ColWidthEmail}" Binding="{Binding Email}" SortMemberPath="Email" CanUserSort="False"/>
                    </muxc:TableView>
                </Border>
            </Grid>
        </controls:SamplePresenter.Example>

        <controls:SamplePresenter.Options>
            <StackPanel Spacing="12">
                <TextBlock Text="Filter actions" Style="{StaticResource SectionHeaderTextStyle}"/>
                <TextBlock
                    Text="Clear every active column filter in one batch; the Filtered event fires exactly once per ClearAllFilters() call regardless of how many columns were active."
                    Style="{StaticResource SectionDescriptionTextStyle}"
                    TextWrapping="Wrap"/>
                <Button
                    x:Name="ClearAllFiltersButton"
                    AutomationProperties.AutomationId="ClearAllFiltersButton"
                    Content="Clear all filters"
                    Click="OnClearAllFiltersClick"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center"/>

                <TextBlock Text="Live readouts" Style="{StaticResource SectionHeaderTextStyle}" Margin="0,8,0,0"/>
                <Grid ColumnSpacing="12" RowSpacing="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="FilterFlyoutOpening" Style="{StaticResource StatusReadoutLabelStyle}"/>
                    <TextBlock Grid.Row="0" Grid.Column="1" x:Name="FlyoutOpeningCountText" Text="0" Style="{StaticResource StatusReadoutValueStyle}" AutomationProperties.AutomationId="FlyoutOpeningCountText"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Last opening column" Style="{StaticResource StatusReadoutLabelStyle}"/>
                    <TextBlock Grid.Row="1" Grid.Column="1" x:Name="LastOpeningColumnText" Text="(none)" Style="{StaticResource StatusReadoutValueStyle}" AutomationProperties.AutomationId="LastOpeningColumnText" TextWrapping="Wrap"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Filtered fires" Style="{StaticResource StatusReadoutLabelStyle}"/>
                    <TextBlock Grid.Row="2" Grid.Column="1" x:Name="FilteredFiredCountText" Text="0" Style="{StaticResource StatusReadoutValueStyle}" AutomationProperties.AutomationId="FilteredFiredCountText"/>

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Active filters" Style="{StaticResource StatusReadoutLabelStyle}" VerticalAlignment="Top"/>
                    <TextBlock Grid.Row="3" Grid.Column="1" x:Name="ActiveFiltersText" Text="(none)" Style="{StaticResource StatusReadoutValueStyle}" TextWrapping="Wrap" AutomationProperties.AutomationId="ActiveFiltersText"/>

                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Visible rows" Style="{StaticResource StatusReadoutLabelStyle}"/>
                    <TextBlock Grid.Row="4" Grid.Column="1" x:Name="VisibleRowCountText" Text="?" Style="{StaticResource StatusReadoutValueStyle}" AutomationProperties.AutomationId="VisibleRowCountText"/>
                </Grid>
            </StackPanel>
        </controls:SamplePresenter.Options>

    </controls:SamplePresenter>
</Page>
