<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="TableViewSamples.Pages.CellStylingPage"
    NavigationCacheMode="Enabled"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:local="using:TableViewSamples.Pages"
    xmlns:controls="using:TableViewSamples.Controls">

    <Page.Resources>
        <!-- Data-bound conditional cell tints. Each tinted cell binds its Border
             background to the row value through a value converter, so a value
             change re-runs ONLY that one cell's converter and recolors it
             instantly - no per-column cell-tree rebuild. The active preset lives
             in the shared CellStylingPage.Scheme field, which the converters read
             to decide whether (and how vibrantly) to tint. -->
        <local:SalaryTintConverter x:Key="SalaryTintConverter"/>
        <local:DepartmentTintConverter x:Key="DepartmentTintConverter"/>
        <local:ActiveTintConverter x:Key="ActiveTintConverter"/>
    </Page.Resources>

    <controls:SamplePresenter
        Header="Per-cell conditional styling"
        Description="Tint individual cells based on the cell's value. The first four presets use subtle theme-aware tints; the vibrant preset resembles a sales-dashboard look with saturated category pills, stoplight Salary, and a status chip on Active. Turn on Live Updates to watch bound cell values change in place."
        SourceCaption="CellStylingPage.xaml (excerpt)"
        SourceSnippet="CellStyling.xaml.txt"
        AdditionalSnippetCaption="CellStylingPage.xaml.cs (excerpt)"
        AdditionalSnippet="CellStyling.cs.txt"
        StretchExample="True">

        <controls:SamplePresenter.Example>
            <Grid RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <muxc:InfoBar
                    Grid.Row="0"
                    IsOpen="True"
                    IsClosable="False"
                    Severity="Informational"
                    Title="Try it"
                    Message="Pick a styling rule to tint specific columns; only the targeted columns change. Selecting a row still highlights the whole row on top."
                    MinHeight="104"/>
                <Border Grid.Row="1" Style="{StaticResource TableHostBorderStyle}" VerticalAlignment="Stretch">
                    <muxc:TableView
                        x:Name="PeopleTable"
                        ItemsSource="{x:Bind People, Mode=OneWay}"
                        SelectionMode="Single"
                        VerticalAlignment="Stretch"
                        MinHeight="320">
                        <muxc:TableViewTextColumn x:Name="FirstNameCol"  Header="First name" Width="{StaticResource ColWidthShortName}" Binding="{Binding FirstName}" CanUserSort="False" CanUserFilter="False"/>
                        <muxc:TableViewTextColumn x:Name="LastNameCol"   Header="Last name"  Width="{StaticResource ColWidthShortName}" Binding="{Binding LastName}" CanUserSort="False" CanUserFilter="False"/>
                        <muxc:TableViewTemplateColumn x:Name="DepartmentCol" Header="Department" Width="{StaticResource ColWidthDepartment}" SortMemberPath="Department" CanUserSort="False" CanUserFilter="False">
                            <muxc:TableViewTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="{Binding Department, Converter={StaticResource DepartmentTintConverter}}" CornerRadius="4" Padding="8,2" Margin="2,1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                        <TextBlock Text="{Binding Department}" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                    </Border>
                                </DataTemplate>
                            </muxc:TableViewTemplateColumn.CellTemplate>
                        </muxc:TableViewTemplateColumn>
                        <muxc:TableViewTextColumn x:Name="RoleCol"       Header="Role"       Width="{StaticResource ColWidthLongName}" Binding="{Binding Role}" CanUserSort="False" CanUserFilter="False"/>
                        <muxc:TableViewTemplateColumn x:Name="SalaryCol" Header="Salary" Width="{StaticResource ColWidthNumber}" SortMemberPath="Salary" CanUserSort="False" CanUserFilter="False">
                            <muxc:TableViewTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="{Binding Salary, Converter={StaticResource SalaryTintConverter}}" CornerRadius="4" Padding="8,2" Margin="2,1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                        <TextBlock Text="{Binding Salary}" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                    </Border>
                                </DataTemplate>
                            </muxc:TableViewTemplateColumn.CellTemplate>
                        </muxc:TableViewTemplateColumn>
                        <muxc:TableViewTemplateColumn x:Name="ActiveCol" Header="Active" Width="{StaticResource ColWidthBoolean}" SortMemberPath="IsActive" CanUserSort="False" CanUserFilter="False">
                            <muxc:TableViewTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="{Binding IsActive, Converter={StaticResource ActiveTintConverter}}" CornerRadius="4" Padding="8,2" Margin="2,1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                        <TextBlock Text="{Binding IsActive}" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                    </Border>
                                </DataTemplate>
                            </muxc:TableViewTemplateColumn.CellTemplate>
                        </muxc:TableViewTemplateColumn>
                    </muxc:TableView>
                </Border>
            </Grid>
        </controls:SamplePresenter.Example>

        <controls:SamplePresenter.Options>
            <StackPanel Spacing="12">
                <TextBlock Text="Configuration" Style="{StaticResource SectionHeaderTextStyle}"/>
                <TextBlock
                    Text="Pick a styling rule. Cell tints are data-bound through a value converter, so cells recolor instantly as their values change — including during live updates — with no row rebuild."
                    Style="{StaticResource SectionDescriptionTextStyle}"
                    TextWrapping="Wrap"/>
                <muxc:RadioButtons
                    x:Name="SelectorPicker"
                    AutomationProperties.AutomationId="SelectorPicker"
                    AutomationProperties.Name="Cell styling rule"
                    SelectedIndex="4"
                    SelectionChanged="OnSelectorChanged">
                    <x:String>None — no cell styles</x:String>
                    <x:String>Salary tier — green ≥ 100k, amber 60–100k, red &lt; 60k (Salary column only)</x:String>
                    <x:String>Department + Active — Department column tints by category; Active column flags inactive</x:String>
                    <x:String>All three columns — Salary tier + Department + Active</x:String>
                    <x:String>Vibrant sales dashboard — saturated pills, stoplight Salary, status chip on Active</x:String>
                </muxc:RadioButtons>

                <TextBlock Text="Status" Style="{StaticResource SectionHeaderTextStyle}" Margin="0,8,0,0"/>
                <Grid ColumnSpacing="12" RowSpacing="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Active config" Style="{StaticResource StatusReadoutLabelStyle}" VerticalAlignment="Top"/>
                    <TextBlock Grid.Row="0" Grid.Column="1" x:Name="ActiveSelectorText" Text="(none)" Style="{StaticResource StatusReadoutValueStyle}" AutomationProperties.AutomationId="ActiveSelectorText" TextWrapping="Wrap"/>
                </Grid>

                <TextBlock Text="Live updates" Style="{StaticResource SectionHeaderTextStyle}" Margin="0,8,0,0"/>
                <TextBlock
                    Text="Update a visible sample row at the chosen interval. Both the cell text AND its tint update live in place — the bound converter re-runs for just the changed cell, so there is no per-tick rebuild."
                    Style="{StaticResource SectionDescriptionTextStyle}"
                    TextWrapping="Wrap"/>
                <ToggleSwitch
                    x:Name="LiveUpdatesToggle"
                    AutomationProperties.AutomationId="LiveUpdatesToggle"
                    Header="Live updates"
                    OffContent="Off"
                    OnContent="On"
                    IsOn="True"
                    Toggled="OnLiveUpdatesToggled"/>
                <Slider
                    x:Name="UpdateIntervalSlider"
                    AutomationProperties.AutomationId="UpdateIntervalSlider"
                    Header="Update interval (ms)"
                    Minimum="25"
                    Maximum="2000"
                    StepFrequency="25"
                    Value="500"/>
                <muxc:InfoBar
                    IsOpen="True"
                    IsClosable="False"
                    Severity="Success"
                    Title="How this works"
                    Message="Each tinted cell binds its background to the row value through a converter. A value change re-runs only that cell's converter, so live updates recolor smoothly without rebuilding the row — the recommended pattern for dynamic conditional styling."
                    Margin="0,4,0,0"/>
            </StackPanel>
        </controls:SamplePresenter.Options>

    </controls:SamplePresenter>
</Page>
