<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="TableViewSamples.Pages.FilterPage"
    NavigationCacheMode="Enabled"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:controls="using:TableViewSamples.Controls">

    <controls:SamplePresenter
        Header="Per-column filtering"
        Description="Per-column text filtering. Type a case-insensitive substring in any column's filter box to narrow the rows; the header funnel marks which columns are filtered, and Clear all resets them."
        SourceCaption="FilterPage.xaml (excerpt)"
        SourceSnippet="Filter.xaml.txt"
        AdditionalSnippetCaption="FilterPage.xaml.cs (excerpt)"
        AdditionalSnippet="Filter.cs.txt"
        StretchExample="True">

        <controls:SamplePresenter.Example>
            <Grid RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <muxc:InfoBar
                    Grid.Row="0"
                    IsOpen="True"
                    IsClosable="False"
                    Severity="Informational"
                    Title="Try it"
                    Message="Type in a column's filter box to narrow rows; the header funnel lights up. Click Clear all to reset every filter."
                    MinHeight="104"/>
                <Border Grid.Row="1" Style="{StaticResource TableHostBorderStyle}" VerticalAlignment="Stretch">
                    <muxc:TableView
                        x:Name="PeopleTable"
                        ItemsSource="{x:Bind People, Mode=OneWay}"
                        SelectionMode="Single"
                        Filtered="OnTableFiltered"
                        VerticalAlignment="Stretch"
                        MinHeight="320">
                        <muxc:TableViewTextColumn x:Name="FirstNameColumn"  Header="First name" Width="{StaticResource ColWidthShortName}" Binding="{Binding FirstName}" CanUserSort="False"/>
                        <muxc:TableViewTextColumn x:Name="LastNameColumn"   Header="Last name"  Width="{StaticResource ColWidthShortName}" Binding="{Binding LastName}" CanUserSort="False"/>
                        <muxc:TableViewTextColumn x:Name="EmailColumn"      Header="Email"      Width="{StaticResource ColWidthEmail}" Binding="{Binding Email}" CanUserSort="False"/>
                        <muxc:TableViewTextColumn x:Name="DepartmentColumn" Header="Department" Width="{StaticResource ColWidthDepartment}" Binding="{Binding Department}" CanUserSort="False"/>
                        <muxc:TableViewTextColumn x:Name="RoleColumn"       Header="Role"       Width="{StaticResource ColWidthLongName}" Binding="{Binding Role}" CanUserSort="False"/>
                        <muxc:TableViewTextColumn x:Name="SalaryColumn"     Header="Salary"     Width="{StaticResource ColWidthNumber}" CanUserFilter="False" Binding="{Binding Salary}" CanUserSort="False"/>
                    </muxc:TableView>
                </Border>
            </Grid>
        </controls:SamplePresenter.Example>

        <controls:SamplePresenter.Options>
            <StackPanel Spacing="12">
                <TextBlock Text="Filter inputs" Style="{StaticResource SectionHeaderTextStyle}"/>
                <TextBlock
                    Text="Type a substring (case-insensitive). Empty box clears that column."
                    Style="{StaticResource SectionDescriptionTextStyle}"
                    TextWrapping="Wrap"/>
                <TextBox
                    x:Name="LastNameFilterBox"
                    AutomationProperties.AutomationId="LastNameFilterBox"
                    PlaceholderText="Last name…"
                    Header="Last name"
                    HorizontalAlignment="Stretch"
                    TextChanged="OnLastNameFilterChanged"/>
                <TextBox
                    x:Name="DepartmentFilterBox"
                    AutomationProperties.AutomationId="DepartmentFilterBox"
                    PlaceholderText="Department…"
                    Header="Department"
                    HorizontalAlignment="Stretch"
                    TextChanged="OnDepartmentFilterChanged"/>
                <TextBox
                    x:Name="RoleFilterBox"
                    AutomationProperties.AutomationId="RoleFilterBox"
                    PlaceholderText="Role…"
                    Header="Role"
                    HorizontalAlignment="Stretch"
                    TextChanged="OnRoleFilterChanged"/>
                <TextBox
                    x:Name="EmailFilterBox"
                    AutomationProperties.AutomationId="EmailFilterBox"
                    PlaceholderText="Email…"
                    Header="Email"
                    HorizontalAlignment="Stretch"
                    TextChanged="OnEmailFilterChanged"/>
                <Button
                    x:Name="ClearAllFiltersButton"
                    AutomationProperties.AutomationId="ClearAllFiltersButton"
                    Content="Clear all"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center"
                    Click="OnClearAllFiltersClick"/>

                <TextBlock Text="Status" Style="{StaticResource SectionHeaderTextStyle}" Margin="0,8,0,0"/>
                <Grid ColumnSpacing="12" RowSpacing="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Filtered fires" Style="{StaticResource StatusReadoutLabelStyle}"/>
                    <TextBlock Grid.Row="0" Grid.Column="1" x:Name="FilteredFiredCountText" Text="0" Style="{StaticResource StatusReadoutValueStyle}" AutomationProperties.AutomationId="FilteredFiredCountText"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Trigger column" Style="{StaticResource StatusReadoutLabelStyle}"/>
                    <TextBlock Grid.Row="1" Grid.Column="1" x:Name="TriggerColumnText" Text="(none)" Style="{StaticResource StatusReadoutValueStyle}" AutomationProperties.AutomationId="TriggerColumnText" TextWrapping="Wrap"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Filtered columns" Style="{StaticResource StatusReadoutLabelStyle}" VerticalAlignment="Top"/>
                    <TextBlock Grid.Row="2" Grid.Column="1" x:Name="FilteredColumnsText" Text="(none)" Style="{StaticResource StatusReadoutValueStyle}" AutomationProperties.AutomationId="FilteredColumnsText" TextWrapping="Wrap"/>

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Visible rows" Style="{StaticResource StatusReadoutLabelStyle}"/>
                    <TextBlock Grid.Row="3" Grid.Column="1" x:Name="VisibleRowCountText" Text="?" Style="{StaticResource StatusReadoutValueStyle}" AutomationProperties.AutomationId="VisibleRowCountText"/>
                </Grid>
            </StackPanel>
        </controls:SamplePresenter.Options>

    </controls:SamplePresenter>
</Page>
