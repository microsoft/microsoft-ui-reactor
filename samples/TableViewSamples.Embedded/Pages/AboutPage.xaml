<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="TableViewSamples.Pages.AboutPage"
    NavigationCacheMode="Enabled"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:controls="using:TableViewSamples.Controls">
<ScrollViewer Padding="{StaticResource PageContentMargin}">
        <Grid RowSpacing="16" HorizontalAlignment="Stretch" MaxWidth="{StaticResource PageMaxContentWidth}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <controls:SamplePageHeader
                Grid.Row="0"
                Title="About this gallery"
                Description="A focused samples app that ships alongside the WinUI TableView control. Internal Microsoft use only — partner-share readiness preview, not a public release."/>

            <Grid Grid.Row="1" RowSpacing="12" ColumnSpacing="32">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Audience" VerticalAlignment="Top"
                           Style="{ThemeResource BodyStrongTextBlockStyle}"/>
                <TextBlock Grid.Row="0" Grid.Column="1"
                           Text="Internal Microsoft only. Not for external distribution. Used by partner teams (Outlook, Loop, Task Manager, etc.) to evaluate TableView before its public API surface lands."
                           Style="{ThemeResource BodyTextBlockStyle}"
                           TextWrapping="Wrap"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="App stack" VerticalAlignment="Top"
                           Style="{ThemeResource BodyStrongTextBlockStyle}"/>
                <StackPanel Grid.Row="1" Grid.Column="1" Spacing="2">
                    <TextBlock Text="C# 12 + .NET 8 desktop app" Style="{ThemeResource BodyTextBlockStyle}"/>
                    <TextBlock Text="Windows App SDK (experimental preview, internal build)"
                               Style="{ThemeResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <TextBlock Text="WinUI 3 (microsoft-ui-xaml-lift)"
                               Style="{ThemeResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </StackPanel>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="Sample source" VerticalAlignment="Top"
                           Style="{ThemeResource BodyStrongTextBlockStyle}"/>
                <StackPanel Grid.Row="2" Grid.Column="1" Spacing="2">
                    <TextBlock Text="Samples\TableViewSamples\" Style="{ThemeResource BodyTextBlockStyle}"/>
                    <TextBlock Text="36 pages: Home + Performance + Settings + About + 32 feature demos"
                               Style="{ThemeResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </StackPanel>

                <TextBlock Grid.Row="3" Grid.Column="0" Text="Control source" VerticalAlignment="Top"
                           Style="{ThemeResource BodyStrongTextBlockStyle}"/>
                <StackPanel Grid.Row="3" Grid.Column="1" Spacing="2">
                    <TextBlock Text="controls\dev\TableView\ (C++/WinRT)" Style="{ThemeResource BodyTextBlockStyle}"/>
                    <TextBlock Text="Namespace: Microsoft.UI.Xaml.Controls"
                               Style="{ThemeResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </StackPanel>

                <TextBlock Grid.Row="4" Grid.Column="0" Text="Repository" VerticalAlignment="Top"
                           Style="{ThemeResource BodyStrongTextBlockStyle}"/>
                <StackPanel Grid.Row="4" Grid.Column="1" Spacing="2">
                    <TextBlock TextWrapping="Wrap" Style="{ThemeResource BodyTextBlockStyle}">
                        <Hyperlink NavigateUri="https://dev.azure.com/microsoft/WinUI/_git/microsoft-ui-xaml-lift">
                            <Run Text="https://dev.azure.com/microsoft/WinUI/_git/microsoft-ui-xaml-lift"/>
                        </Hyperlink>
                    </TextBlock>
                    <TextBlock TextWrapping="Wrap"
                               Style="{ThemeResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                        Branch:
                        <Hyperlink NavigateUri="https://dev.azure.com/microsoft/WinUI/_git/microsoft-ui-xaml-lift?version=GBuser%2Fhik%2Ftableview%2Fadvanced-poc-v2">
                            <Run Text="user/hik/tableview/advanced-poc-v2"/>
                        </Hyperlink>
                    </TextBlock>
                </StackPanel>

                <TextBlock Grid.Row="5" Grid.Column="0" Text="Build" VerticalAlignment="Top"
                           Style="{ThemeResource BodyStrongTextBlockStyle}"/>
                <StackPanel Grid.Row="5" Grid.Column="1" Spacing="2">
                    <TextBlock x:Name="BuildLineText" Style="{ThemeResource BodyTextBlockStyle}" TextWrapping="Wrap"/>
                    <TextBlock x:Name="BuildCommitText" Style="{ThemeResource BodyTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                    <TextBlock x:Name="BuildCommitSubjectText" Style="{ThemeResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                </StackPanel>

                <TextBlock Grid.Row="6" Grid.Column="0" Text="Reporting bugs" VerticalAlignment="Top"
                           Style="{ThemeResource BodyStrongTextBlockStyle}"/>
                <StackPanel Grid.Row="6" Grid.Column="1" Spacing="6">
                    <TextBlock TextWrapping="Wrap" Style="{ThemeResource BodyTextBlockStyle}">
                        <Run Text="Two ways to report — pick whichever fits your workflow:"/>
                    </TextBlock>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="ReportEmailButton" Content="🔗 Report via email"
                                Style="{ThemeResource AccentButtonStyle}"
                                ToolTipService.ToolTip="Opens your mail client pre-filled with the current commit SHA, theme, and reporter info."/>
                        <Button x:Name="ReportLoopButton" Content="📝 Open Loop feedback page"
                                ToolTipService.ToolTip="Opens the shared Loop page where partner teams log issues. Paste the auto-filled snippet at the top."/>
                        <Button x:Name="CopyAutoFillButton" Content="📋 Copy auto-fill"
                                ToolTipService.ToolTip="Copies a Markdown block ready to paste into Loop / Teams / email."/>
                    </StackPanel>
                    <TextBlock Text="Auto-fill includes: commit SHA, branch, build timestamp, reporter (you), current theme, and OS / .NET version — everything a triager needs to reproduce."
                               Style="{ThemeResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap"/>
                    <TextBlock TextWrapping="Wrap" Style="{ThemeResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                        <Run Text="Email goes to "/>
                        <Hyperlink NavigateUri="mailto:hik@microsoft.com">
                            <Run Text="hik@microsoft.com"/>
                        </Hyperlink>
                        <Run Text=". Include the page name, repro steps, and the exception type + message if a crash."/>
                    </TextBlock>
                </StackPanel>

                <TextBlock Grid.Row="7" Grid.Column="0" Text="Theme" VerticalAlignment="Top"
                           Style="{ThemeResource BodyStrongTextBlockStyle}"/>
                <TextBlock Grid.Row="7" Grid.Column="1"
                           Text="Switch Default / Light / Dark from the theme button in the title bar (top-right), or choose a theme on the 'Theme &amp; settings' page. Changes apply live across every page."
                           Style="{ThemeResource BodyTextBlockStyle}"
                           TextWrapping="Wrap"/>

                <TextBlock Grid.Row="8" Grid.Column="0" Text="Diagnostics" VerticalAlignment="Top"
                           Style="{ThemeResource BodyStrongTextBlockStyle}"/>
                <TextBlock Grid.Row="8" Grid.Column="1"
                           Text="If a page crashes, use the Report buttons above. The auto-fill captures the commit, branch, build, theme, and OS / .NET version a triager needs — add the page name and repro steps before sending."
                           Style="{ThemeResource BodyTextBlockStyle}"
                           TextWrapping="Wrap"/>

                <TextBlock Grid.Row="9" Grid.Column="0" Text="Design &amp; references" VerticalAlignment="Top"
                           Style="{ThemeResource BodyStrongTextBlockStyle}"/>
                <StackPanel Grid.Row="9" Grid.Column="1" Spacing="6">
                    <TextBlock TextWrapping="Wrap" Style="{ThemeResource BodyTextBlockStyle}">
                        <Run Text="Scenario "/>
                        <Hyperlink NavigateUri="https://dev.azure.com/microsoft/OS/_workitems/edit/48784677">
                            <Run Text="48784677 — [K2WinUI] Implement TableView in WinUI 3"/>
                        </Hyperlink>
                        <Run Text=" · Key consumers: File Explorer, Task Manager, File Properties."/>
                    </TextBlock>
                    <TextBlock Text="Design docs (SharePoint)" Style="{ThemeResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <TextBlock TextWrapping="Wrap" Style="{ThemeResource BodyTextBlockStyle}">
                        <Hyperlink NavigateUri="https://microsoft.sharepoint-df.com/:w:/t/ShellFTL/IQCDT9uCQhsfSYPRRw6IWlenAZULe8fBwUos8n5BQKy20YQ"><Run Text="Master design"/></Hyperlink>
                        <Run Text="  ·  "/>
                        <Hyperlink NavigateUri="https://microsoft.sharepoint-df.com/:w:/t/ShellFTL/IQCWdCCYL2yJQ798dglrgQ7wAf6hq4NBblI0m9rk6mLDa10"><Run Text="Framework (Phase 1)"/></Hyperlink>
                        <Run Text="  ·  "/>
                        <Hyperlink NavigateUri="https://microsoft.sharepoint-df.com/:w:/t/ShellFTL/IQAyjfn-txpMTLBrZNygNqwMAZFDw_wN6yqv_HMw2AcstXY"><Run Text="Basic control (Phase 2)"/></Hyperlink>
                        <Run Text="  ·  "/>
                        <Hyperlink NavigateUri="https://microsoft.sharepoint-df.com/:w:/t/ShellFTL/IQAZoq3vvgA0Q7m1Jg7XlwLkAWsy-cPsCRpCwT4ESBP6I9c"><Run Text="Advanced features (Phase 3)"/></Hyperlink>
                        <Run Text="  ·  "/>
                        <Hyperlink NavigateUri="https://microsoft.sharepoint-df.com/:w:/t/ShellFTL/IQAYMIqv_5FWRplz9DHbtS3ZAYLjBz866RQvnl9PW3K13eI"><Run Text="Test plan"/></Hyperlink>
                    </TextBlock>
                    <TextBlock Text="Specs (SharePoint)" Style="{ThemeResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <TextBlock TextWrapping="Wrap" Style="{ThemeResource BodyTextBlockStyle}">
                        <Hyperlink NavigateUri="https://microsoft.sharepoint-df.com/:w:/t/ShellFTL/cQpHs7fLjBIoRYOLCoOthbqvEgUC7S8nv8BoFDUHrxCKSiU2_Q"><Run Text="Functional 1-pager"/></Hyperlink>
                        <Run Text="  ·  "/>
                        <Hyperlink NavigateUri="https://microsoft.sharepoint-df.com/:w:/t/ShellFTL/cQqRxJIsVcfqTY1Mt5UaR5uvEgUCc_QSPyrAvkcTr07nOr4YqQ"><Run Text="TSD (options eval v2)"/></Hyperlink>
                        <Run Text="  ·  "/>
                        <Hyperlink NavigateUri="https://microsoft.sharepoint-df.com/:x:/t/ShellFTL/cQr-hxP__ijmRKb8CWM6hXpAEgUCbkOorJ2OmggiZp2BQB_wsw"><Run Text="MLP requirements"/></Hyperlink>
                    </TextBlock>
                    <TextBlock Text="Pull requests" Style="{ThemeResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <TextBlock TextWrapping="Wrap" Style="{ThemeResource BodyTextBlockStyle}">
                        <Hyperlink NavigateUri="https://microsoft.visualstudio.com/WinUI/_git/microsoft-ui-xaml-lift/pullrequest/15494526"><Run Text="Framework #15494526"/></Hyperlink>
                        <Run Text="  ·  "/>
                        <Hyperlink NavigateUri="https://microsoft.visualstudio.com/WinUI/_git/microsoft-ui-xaml-lift/pullrequest/15505121"><Run Text="Basic #15505121"/></Hyperlink>
                        <Run Text="  ·  "/>
                        <Hyperlink NavigateUri="https://microsoft.visualstudio.com/WinUI/_git/microsoft-ui-xaml-lift/pullrequest/15522127"><Run Text="Advanced #15522127"/></Hyperlink>
                        <Run Text="  ·  "/>
                        <Hyperlink NavigateUri="https://microsoft.visualstudio.com/WinUI/_git/microsoft-ui-xaml-lift/pullrequest/15547177"><Run Text="Cumulative #15547177"/></Hyperlink>
                    </TextBlock>
                </StackPanel>
            </Grid>

            <muxc:InfoBar
                Grid.Row="2"
                IsOpen="True"
                IsClosable="False"
                Severity="Informational"
                Title="Gallery coverage"
                Message="The Home page lists the shipped TableView capabilities that have working samples in this app. The Performance page lets you run repeatable timing + memory scenarios. As new capabilities land, they'll appear on the Home page the same way."/>
        </Grid>
    </ScrollViewer>
</Page>
