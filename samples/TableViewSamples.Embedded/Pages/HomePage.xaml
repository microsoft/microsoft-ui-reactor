<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="TableViewSamples.Pages.HomePage"
    NavigationCacheMode="Enabled"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:controls="using:TableViewSamples.Controls">

    <ScrollViewer
        Padding="{StaticResource PageContentMargin}"
        VerticalScrollBarVisibility="Visible"
        HorizontalScrollMode="Disabled">
        <StackPanel
            Spacing="{StaticResource SectionSpacing}"
            HorizontalAlignment="Stretch"
            MaxWidth="{StaticResource PageMaxContentWidth}">

            <controls:SamplePageHeader
                Title="TableView"
                Description="A native WinUI 3 tabular control for data-heavy desktop experiences — typed columns, multi-column sort and filter, inline edit, frozen leading and trailing columns, hierarchical and grouped rows, and two-axis virtualization with built-in keyboard navigation, accessibility, and Excel-style clipboard."/>

            <muxc:InfoBar
                IsOpen="True"
                IsClosable="False"
                Severity="Informational"
                Title="About this gallery"
                Message="C# WinUI 3 desktop app (.NET 8, Windows App SDK preview). 36 focused sample pages cover the TableView control — typed columns, sort, filter, inline edit, virtualization, frozen columns, row reorder, grouping, pagination, data export, grid lines, and more. Every page includes a 'Try it' callout, sample XAML, and (where relevant) source-excerpt cards. Open the Showcase page for a single live TableView that composes sort, filter, frozen columns, inline edit, marquee, and clipboard in one control. Use the theme toggle in the title bar — or the Settings page — to flip Default / Light / Dark and the choice persists across launches."/>

            <StackPanel Spacing="{StaticResource SectionInnerSpacing}">
                <TextBlock Text="What's supported today" Style="{StaticResource SectionHeaderTextStyle}"/>
                <ItemsControl>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnSpacing="8" Margin="0,2,0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="·" VerticalAlignment="Top" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <TextBlock Grid.Column="1" Text="{Binding}" TextWrapping="Wrap" Style="{ThemeResource BodyTextBlockStyle}"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                    <x:String>Typed columns — text, checkbox, template</x:String>
                    <x:String>Multi-column sort with priority badges</x:String>
                    <x:String>Per-column filter popups (and Advanced filter builder)</x:String>
                    <x:String>Inline edit — Enter / Tab to commit, Esc to cancel</x:String>
                    <x:String>Single / Multiple / Extended selection with leading checkbox gutter</x:String>
                    <x:String>Column resize — drag the gripper or set Min / Width / Max programmatically</x:String>
                    <x:String>Column reorder — programmatic MoveColumn() + in-control drag gesture</x:String>
                    <x:String>Sticky headers — pinned during horizontal and vertical scroll</x:String>
                    <x:String>2-level grouping with collapsible group headers</x:String>
                    <x:String>HeadersVisibility — All / Column / Row / None</x:String>
                    <x:String>Dynamic columns at runtime (bind to ObservableCollection)</x:String>
                    <x:String>Two-axis virtualization — rows up to 1M via ISupportIncrementalLoading</x:String>
                    <x:String>Frozen leading and trailing columns</x:String>
                    <x:String>N-level hierarchy with expand / collapse</x:String>
                    <x:String>Drag-selection (marquee) rectangle</x:String>
                    <x:String>Row drag-and-drop reorder</x:String>
                    <x:String>RTL flow (mirrored layout, gripper, frozen edges)</x:String>
                    <x:String>Conditional row + per-cell style selectors</x:String>
                    <x:String>Custom row templates (RowTemplate DataTemplate)</x:String>
                    <x:String>Mixed controls in cells (TextBox / Button / ComboBox)</x:String>
                    <x:String>Persisted layout state (Save / Load JSON)</x:String>
                    <x:String>Clipboard — Ctrl+C / Ctrl+V / Ctrl+X / Ctrl+D with Excel-compatible TSV</x:String>
                    <x:String>Pagination — page-window over a large source list (1,000 rows / 25-50-100 per page)</x:String>
                    <x:String>Data export — CSV / TSV / JSON serialization of the rows currently displayed</x:String>
                </ItemsControl>
            </StackPanel>

            <StackPanel Spacing="{StaticResource SectionInnerSpacing}">
                <TextBlock Text="Customers" Style="{StaticResource SectionHeaderTextStyle}"/>
                <TextBlock
                    Text="First-party Windows surfaces and third-party app developers that need a native WinUI 3 tabular control. Today these experiences render tables on a mix of legacy stacks (DirectUI, ComCtl) or a partial WinUI 3 migration."
                    Style="{StaticResource SectionDescriptionTextStyle}"
                    TextWrapping="Wrap"/>
                <Border Style="{StaticResource TableHostBorderStyle}" HorizontalAlignment="Left" MaxWidth="640" Margin="0,4,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Header row -->
                        <Border Grid.Row="0" Grid.ColumnSpan="2" Background="{ThemeResource LayerFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1"/>
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Customer" Padding="12,8"
                                   Style="{ThemeResource BodyStrongTextBlockStyle}"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="Current UI framework" Padding="12,8"
                                   Style="{ThemeResource BodyStrongTextBlockStyle}"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="File Explorer" Padding="12,8" Style="{ThemeResource BodyTextBlockStyle}"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="WinUI 3, DirectUI and ComCtl" Padding="12,8" Style="{ThemeResource BodyTextBlockStyle}"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Task Manager" Padding="12,8" Style="{ThemeResource BodyTextBlockStyle}"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="WinUI 3, DirectUI" Padding="12,8" Style="{ThemeResource BodyTextBlockStyle}"/>

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="File Properties dialog" Padding="12,8" Style="{ThemeResource BodyTextBlockStyle}"/>
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="ComCtl" Padding="12,8" Style="{ThemeResource BodyTextBlockStyle}"/>

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Third-party app developers" Padding="12,8" Style="{ThemeResource BodyTextBlockStyle}"/>
                        <TextBlock Grid.Row="4" Grid.Column="1" Text="N/A" Padding="12,8" Style="{ThemeResource BodyTextBlockStyle}"/>
                    </Grid>
                </Border>
            </StackPanel>

            <StackPanel Spacing="{StaticResource SectionInnerSpacing}">
                <TextBlock Text="Problem statement" Style="{StaticResource SectionHeaderTextStyle}"/>
                <TextBlock
                    Text="Windows' own data-table surfaces are split across DirectUI, ComCtl, and partial WinUI 3 — each app hand-builds and maintains its own table, and third-party developers have no first-party WinUI 3 option at all. TableView is the single native, accessible, virtualized tabular control these customers can share instead of reinventing one each."
                    Style="{StaticResource SectionDescriptionTextStyle}"
                    TextWrapping="Wrap"/>
            </StackPanel>

            <StackPanel Spacing="{StaticResource SectionInnerSpacing}">
                <TextBlock Text="Accessibility &amp; input" Style="{StaticResource SectionHeaderTextStyle}"/>
                <TextBlock
                    Text="Full keyboard navigation (arrows, Tab, F2, Enter, Esc), narrator support via TableView and TableViewRow automation peers, Ctrl+C/X/V/D clipboard with Excel-compatible TSV, and Shift-Click / Ctrl-Click multi-select out of the box."
                    Style="{StaticResource SectionDescriptionTextStyle}"
                    TextWrapping="Wrap"/>
            </StackPanel>

            <StackPanel Spacing="{StaticResource SectionInnerSpacing}">
                <TextBlock Text="Scales to large data" Style="{StaticResource SectionHeaderTextStyle}"/>
                <TextBlock
                    Text="Two-axis virtualization realizes only the rows and columns currently in view, so tens of thousands of rows scroll smoothly without holding their cell controls in memory. See the Virtualization page for a live 10,000-row demo and the Performance page for repeatable timing scenarios."
                    Style="{StaticResource SectionDescriptionTextStyle}"
                    TextWrapping="Wrap"/>
            </StackPanel>

            <muxc:InfoBar
                IsOpen="True"
                IsClosable="False"
                Severity="Informational"
                Title="Feedback &amp; code review">
                <muxc:InfoBar.Content>
                    <StackPanel Margin="0,8,0,4" Spacing="6">
                        <TextBlock TextWrapping="Wrap">
                            <Run Text="Report a bug or post feedback on the shared "/>
                            <Hyperlink x:Name="LoopFeedbackLink"><Run Text="Loop feedback page"/></Hyperlink>
                            <Run Text=". Review all TableView changes in the "/>
                            <Hyperlink x:Name="CumulativePrLink"><Run Text="cumulative review PR"/></Hyperlink>
                            <Run Text="."/>
                        </TextBlock>
                    </StackPanel>
                </muxc:InfoBar.Content>
            </muxc:InfoBar>

        </StackPanel>
    </ScrollViewer>
</Page>
