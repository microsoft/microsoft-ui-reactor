<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="TableViewSamples.Pages.FrozenTrailingColumnsPage"
    NavigationCacheMode="Enabled"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:controls="using:TableViewSamples.Controls">

    <controls:SamplePresenter
        Header="Frozen trailing columns"
        Description="Pin one or more columns to the trailing edge: as the user scrolls horizontally, the trailing-frozen columns stay visible while the middle columns scroll under them. Mirrors the leading-frozen demo on the opposite edge — useful for keeping a 'Total' or 'Status' column always in view."
        SourceCaption="FrozenTrailingColumnsPage.xaml (excerpt)"
        SourceSnippet="FrozenTrailingColumns.xaml.txt"
        StretchExample="True">

        <controls:SamplePresenter.Example>
            <Grid RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <muxc:InfoBar
                    Grid.Row="0"
                    IsOpen="True"
                    IsClosable="False"
                    Severity="Informational"
                    Title="Try it"
                    MinHeight="104"
                    Message="Toggle a switch to pin that column to the trailing (right) edge, then scroll horizontally — pinned columns stay anchored at the right while the rest scroll."/>
                <Border Grid.Row="1" Style="{StaticResource TableHostBorderStyle}" Padding="0" VerticalAlignment="Stretch">
                    <muxc:TableView
                        x:Name="PeopleTable"
                        AutomationProperties.AutomationId="PeopleTable"
                        SelectionMode="Single"
                        ItemsSource="{x:Bind People}"
                        VerticalAlignment="Stretch"
                        MinHeight="320">
                        <muxc:TableViewTextColumn x:Name="FirstNameColumn" Header="First name" Width="{StaticResource ColWidthShortName}" Binding="{Binding FirstName}" FrozenEdge="Leading" CanUserSort="False" CanUserFilter="False"/>
                        <muxc:TableViewTextColumn                          Header="Last name"  Width="{StaticResource ColWidthShortName}" Binding="{Binding LastName}" CanUserSort="False" CanUserFilter="False"/>
                        <muxc:TableViewTextColumn                          Header="Email"      Width="{StaticResource ColWidthEmail}" Binding="{Binding Email}" CanUserSort="False" CanUserFilter="False"/>
                        <muxc:TableViewTextColumn                          Header="Department" Width="{StaticResource ColWidthDepartment}" Binding="{Binding Department}" CanUserSort="False" CanUserFilter="False"/>
                        <muxc:TableViewTextColumn x:Name="RoleColumn"      Header="Role"       Width="{StaticResource ColWidthLongName}" Binding="{Binding Role}" CanUserSort="False" CanUserFilter="False"/>
                        <muxc:TableViewTextColumn                          Header="Join date"  Width="{StaticResource ColWidthDate}" Binding="{Binding JoinDateText}" CanUserSort="False" CanUserFilter="False"/>
                        <muxc:TableViewTextColumn x:Name="SalaryColumn"    Header="Salary"     Width="{StaticResource ColWidthNumber}" Binding="{Binding Salary}" FrozenEdge="Trailing" CanUserSort="False" CanUserFilter="False"/>
                        <muxc:TableViewTextColumn x:Name="ActiveColumn"    Header="Active"     Width="{StaticResource ColWidthBoolean}" Binding="{Binding IsActive}" FrozenEdge="Trailing" CanUserSort="False" CanUserFilter="False"/>
                    </muxc:TableView>
                </Border>
            </Grid>
        </controls:SamplePresenter.Example>

        <controls:SamplePresenter.Options>
            <StackPanel Spacing="12">
                <TextBlock Text="Trailing columns" Style="{StaticResource SectionHeaderTextStyle}"/>
                <TextBlock
                    Text="Toggle each switch to pin that column to the trailing (right) edge. Then drag the body horizontally — the trailing columns stay anchored at the right while the middle columns scroll under them. The leading 'First name' column is pinned at the left for contrast."
                    Style="{StaticResource SectionDescriptionTextStyle}"
                    TextWrapping="Wrap"/>
                <ToggleSwitch
                    x:Name="PinSalaryToggle"
                    AutomationProperties.AutomationId="PinSalaryToggle"
                    Header="Salary"
                    IsOn="True"
                    OnContent="Pinned right"
                    OffContent="Scrolling"
                    Toggled="OnPinSalaryToggled"/>
                <ToggleSwitch
                    x:Name="PinActiveToggle"
                    AutomationProperties.AutomationId="PinActiveToggle"
                    Header="Active"
                    IsOn="True"
                    OnContent="Pinned right"
                    OffContent="Scrolling"
                    Toggled="OnPinActiveToggled"/>
                <ToggleSwitch
                    x:Name="PinRoleToggle"
                    AutomationProperties.AutomationId="PinRoleToggle"
                    Header="Role"
                    IsOn="False"
                    OnContent="Pinned right"
                    OffContent="Scrolling"
                    Toggled="OnPinRoleToggled"/>

                <TextBlock Text="Status" Style="{StaticResource SectionHeaderTextStyle}" Margin="0,8,0,0"/>
                <Grid ColumnSpacing="12" RowSpacing="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Trailing-pinned columns" Style="{StaticResource StatusReadoutLabelStyle}"/>
                    <TextBlock Grid.Row="0" Grid.Column="1" x:Name="TrailingColumnsText" Text="" Style="{StaticResource StatusReadoutValueStyle}" AutomationProperties.AutomationId="TrailingColumnsText" TextWrapping="Wrap"/>
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Body H offset" Style="{StaticResource StatusReadoutLabelStyle}"/>
                    <TextBlock Grid.Row="1" Grid.Column="1" x:Name="BodyOffsetText" Text="0" Style="{StaticResource StatusReadoutValueStyle}" AutomationProperties.AutomationId="BodyOffsetText"/>
                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Scrollable width" Style="{StaticResource StatusReadoutLabelStyle}"/>
                    <TextBlock Grid.Row="2" Grid.Column="1" x:Name="ScrollableWidthText" Text="0" Style="{StaticResource StatusReadoutValueStyle}" AutomationProperties.AutomationId="ScrollableWidthText"/>
                </Grid>

                <TextBlock Text="Resizing the window" Style="{StaticResource SectionHeaderTextStyle}" Margin="0,8,0,0"/>
                <TextBlock
                    Text="Resize the window horizontally and the trailing columns stay glued to the right edge. When the whole table already fits on screen, the trailing columns simply sit in their natural place with no pinning."
                    Style="{StaticResource SectionDescriptionTextStyle}"
                    TextWrapping="Wrap"/>
            </StackPanel>
        </controls:SamplePresenter.Options>

    </controls:SamplePresenter>
</Page>
