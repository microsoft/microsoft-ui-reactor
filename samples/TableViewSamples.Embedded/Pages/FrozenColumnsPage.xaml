<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="TableViewSamples.Pages.FrozenColumnsPage"
    NavigationCacheMode="Enabled"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:controls="using:TableViewSamples.Controls">

    <controls:SamplePresenter
        Header="Frozen leading columns"
        Description="Pin one or more columns to the leading edge: as you scroll horizontally, the leading-frozen columns stay visible while the middle columns scroll under them. Useful for keeping an identifier column (Name, Id) always in view on a wide table."
        SourceCaption="FrozenColumnsPage.xaml (excerpt)"
        SourceSnippet="FrozenColumns.xaml.txt"
        StretchExample="True">

        <controls:SamplePresenter.Example>
            <Grid RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <muxc:InfoBar
                    Grid.Row="0"
                    IsOpen="True"
                    IsClosable="False"
                    Severity="Informational"
                    Title="Try it"
                    MinHeight="104"
                    Message="Toggle a switch to freeze that column at the leading edge, then scroll horizontally — frozen columns stay pinned to the left while the rest scroll."/>
                <Border Grid.Row="1" Style="{StaticResource TableHostBorderStyle}" Padding="0" VerticalAlignment="Stretch">
                    <muxc:TableView
                        x:Name="PeopleTable"
                        AutomationProperties.AutomationId="PeopleTable"
                        SelectionMode="Single"
                        ItemsSource="{x:Bind People}"
                        VerticalAlignment="Stretch"
                        MinHeight="320">
                        <muxc:TableViewTextColumn x:Name="FirstNameColumn" Header="First name" Width="{StaticResource ColWidthShortName}" Binding="{Binding FirstName}" FrozenEdge="Leading" CanUserSort="False" CanUserFilter="False"/>
                        <muxc:TableViewTextColumn x:Name="LastNameColumn"  Header="Last name"  Width="{StaticResource ColWidthShortName}" Binding="{Binding LastName}"  FrozenEdge="Leading" CanUserSort="False" CanUserFilter="False"/>
                        <muxc:TableViewTextColumn x:Name="EmailColumn"     Header="Email"      Width="{StaticResource ColWidthEmail}" Binding="{Binding Email}" CanUserSort="False" CanUserFilter="False"/>
                        <muxc:TableViewTextColumn                          Header="Department" Width="{StaticResource ColWidthDepartment}" Binding="{Binding Department}" CanUserSort="False" CanUserFilter="False"/>
                        <muxc:TableViewTextColumn                          Header="Role"       Width="{StaticResource ColWidthLongName}" Binding="{Binding Role}" CanUserSort="False" CanUserFilter="False"/>
                        <muxc:TableViewTextColumn                          Header="Join date"  Width="{StaticResource ColWidthDate}" Binding="{Binding JoinDateText}" CanUserSort="False" CanUserFilter="False"/>
                        <muxc:TableViewTextColumn                          Header="Salary"     Width="{StaticResource ColWidthNumber}" Binding="{Binding Salary}" CanUserSort="False" CanUserFilter="False"/>
                        <muxc:TableViewTextColumn                          Header="Active"     Width="{StaticResource ColWidthBoolean}" Binding="{Binding IsActive}" CanUserSort="False" CanUserFilter="False"/>
                    </muxc:TableView>
                </Border>
            </Grid>
        </controls:SamplePresenter.Example>

        <controls:SamplePresenter.Options>
            <StackPanel Spacing="12">
                <TextBlock Text="Frozen columns" Style="{StaticResource SectionHeaderTextStyle}"/>
                <TextBlock
                    Text="Toggle each switch to freeze that column. Then drag the body horizontally — the frozen columns stay pinned. Pin from the leading edge for clean visuals."
                    Style="{StaticResource SectionDescriptionTextStyle}"
                    TextWrapping="Wrap"/>
                <ToggleSwitch
                    x:Name="FreezeFirstNameToggle"
                    AutomationProperties.AutomationId="FreezeFirstNameToggle"
                    Header="First name"
                    IsOn="True"
                    OnContent="Frozen"
                    OffContent="Scrolling"
                    Toggled="OnFreezeFirstNameToggled"/>
                <ToggleSwitch
                    x:Name="FreezeLastNameToggle"
                    AutomationProperties.AutomationId="FreezeLastNameToggle"
                    Header="Last name"
                    IsOn="True"
                    OnContent="Frozen"
                    OffContent="Scrolling"
                    Toggled="OnFreezeLastNameToggled"/>
                <ToggleSwitch
                    x:Name="FreezeEmailToggle"
                    AutomationProperties.AutomationId="FreezeEmailToggle"
                    Header="Email"
                    IsOn="False"
                    OnContent="Frozen"
                    OffContent="Scrolling"
                    Toggled="OnFreezeEmailToggled"/>

                <TextBlock Text="Status" Style="{StaticResource SectionHeaderTextStyle}" Margin="0,8,0,0"/>
                <Grid ColumnSpacing="12" RowSpacing="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Frozen columns" Style="{StaticResource StatusReadoutLabelStyle}"/>
                    <TextBlock Grid.Row="0" Grid.Column="1" x:Name="FrozenColumnsText" Text="" Style="{StaticResource StatusReadoutValueStyle}" AutomationProperties.AutomationId="FrozenColumnsText" TextWrapping="Wrap"/>
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Body H offset" Style="{StaticResource StatusReadoutLabelStyle}"/>
                    <TextBlock Grid.Row="1" Grid.Column="1" x:Name="BodyOffsetText" Text="0" Style="{StaticResource StatusReadoutValueStyle}" AutomationProperties.AutomationId="BodyOffsetText"/>
                </Grid>

                <TextBlock Text="Selection highlight" Style="{StaticResource SectionHeaderTextStyle}" Margin="0,8,0,0"/>
                <TextBlock
                    Text="Select a row and watch the highlight — and the pointer-over effect — stretch across both the pinned columns and the scrolling columns as one continuous row."
                    Style="{StaticResource SectionDescriptionTextStyle}"
                    TextWrapping="Wrap"/>
            </StackPanel>
        </controls:SamplePresenter.Options>

    </controls:SamplePresenter>
</Page>
