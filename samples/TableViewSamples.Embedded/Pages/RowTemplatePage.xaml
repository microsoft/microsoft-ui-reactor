<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="TableViewSamples.Pages.RowTemplatePage"
    NavigationCacheMode="Enabled"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:muxcp="using:Microsoft.UI.Xaml.Controls.Primitives"
    xmlns:controls="using:TableViewSamples.Controls"
    xmlns:models="using:TableViewSamples.Models">

    <Page.Resources>
        <!-- The four DataTemplates used by the picker.
             Each one's root is a layout element whose DataContext is the row's
             data item (a Person). Setting TableView.RowTemplate to any of these
             replaces the per-column cell loop with a single instantiation of
             the template root for every realized data row. -->

        <!-- Card-style — prominent two-line layout with an avatar circle.
             The dominant visual is the name; secondary text shows role at
             the company. Suitable for a directory or roster. -->
        <DataTemplate x:Key="CardRowTemplate" x:DataType="models:Person">
            <Grid ColumnSpacing="14" Padding="16,8" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="44"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Avatar disc -->
                <Border Grid.Column="0"
                        Width="44" Height="44"
                        CornerRadius="22"
                        Background="{ThemeResource AccentFillColorDefaultBrush}"
                        VerticalAlignment="Center">
                    <TextBlock
                        Text="{x:Bind Initial}"
                        Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                        FontSize="18"
                        FontWeight="SemiBold"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"/>
                </Border>

                <!-- Name + role/department -->
                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                    <TextBlock
                        Text="{x:Bind FullName}"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                        TextTrimming="CharacterEllipsis"/>
                    <TextBlock
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextTrimming="CharacterEllipsis">
                        <Run Text="{x:Bind Role}"/>
                        <Run Text=" · "/>
                        <Run Text="{x:Bind Department}"/>
                    </TextBlock>
                </StackPanel>

                <!-- Status text — always shown; reviewers can see the
                     bound IsActive at a glance. -->
                <TextBlock Grid.Column="2"
                    VerticalAlignment="Center"
                    Margin="6,0,2,0"
                    FontSize="11"
                    FontWeight="SemiBold"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                    <Run Text="Active: "/>
                    <Run Text="{x:Bind IsActive}"/>
                </TextBlock>
            </Grid>
        </DataTemplate>

        <!-- Compact-stacked — denser two-line text (name + email) with
             no avatar. Suitable for high-density list scenarios. -->
        <DataTemplate x:Key="CompactRowTemplate" x:DataType="models:Person">
            <StackPanel Padding="14,4" Spacing="0" VerticalAlignment="Center">
                <TextBlock
                    Text="{x:Bind FullName}"
                    FontSize="13"
                    FontWeight="SemiBold"
                    Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                    TextTrimming="CharacterEllipsis"/>
                <TextBlock
                    Text="{x:Bind Email}"
                    FontSize="11"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextTrimming="CharacterEllipsis"/>
            </StackPanel>
        </DataTemplate>

        <!-- Rich media — avatar + name + role on the left,
             department badge in the middle, salary on the right.
             Showcases that template authors own the full row. -->
        <DataTemplate x:Key="MixedRowTemplate" x:DataType="models:Person">
            <Grid ColumnSpacing="12" Padding="14,8" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="36"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Width="36" Height="36"
                        CornerRadius="18"
                        Background="{ThemeResource SystemFillColorAttentionBackgroundBrush}"
                        VerticalAlignment="Center">
                    <TextBlock
                        Text="{x:Bind Initial}"
                        Foreground="{ThemeResource SystemFillColorAttentionBrush}"
                        FontSize="14"
                        FontWeight="SemiBold"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"/>
                </Border>

                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                    <TextBlock
                        Text="{x:Bind FullName}"
                        FontSize="13"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                        TextTrimming="CharacterEllipsis"/>
                    <TextBlock
                        Text="{x:Bind Role}"
                        FontSize="11"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextTrimming="CharacterEllipsis"/>
                </StackPanel>

                <Border Grid.Column="2"
                        VerticalAlignment="Center"
                        CornerRadius="4"
                        Padding="8,3"
                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                    <TextBlock
                        Text="{x:Bind Department}"
                        FontSize="11"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </Border>

                <TextBlock
                    Grid.Column="3"
                    VerticalAlignment="Center"
                    Margin="6,0,4,0"
                    FontSize="13"
                    FontWeight="SemiBold"
                    Foreground="{ThemeResource TextFillColorPrimaryBrush}">
                    <Run Text="$"/>
                    <Run Text="{x:Bind Salary}"/>
                </TextBlock>
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <controls:SamplePresenter
        Header="Custom row templates"
        Description="Replace the default per-column cells with a single DataTemplate that renders the whole row — useful for card-style rosters, two-line compact lists, or mixed avatar / badge layouts. Selection visuals, keyboard nav, and the header row keep working because they live outside the cell host."
        SourceCaption="RowTemplatePage.xaml (excerpt)"
        SourceSnippet="RowTemplate.xaml.txt"
        AdditionalSnippetCaption="RowTemplatePage.xaml.cs (excerpt)"
        AdditionalSnippet="RowTemplate.cs.txt"
        StretchExample="True">

        <controls:SamplePresenter.Example>
            <Grid RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <muxc:InfoBar
                    Grid.Row="0"
                    IsOpen="True"
                    IsClosable="False"
                    Severity="Informational"
                    Title="Try it"
                    Message="Switch templates to rebuild every row in place. Selection and keyboard nav keep working; 'None' restores the default cells."
                    MinHeight="104"/>
                <Border Grid.Row="1" Style="{StaticResource TableHostBorderStyle}" VerticalAlignment="Stretch">
                    <muxc:TableView
                        x:Name="PeopleTable"
                        ItemsSource="{x:Bind People, Mode=OneWay}"
                        SelectionMode="Single"
                        VerticalAlignment="Stretch"
                        MinHeight="320">
                        <muxc:TableViewTextColumn Header="Name"       Width="{StaticResource ColWidthLongName}" Binding="{Binding FullName}" CanUserSort="False" CanUserFilter="False"/>
                        <muxc:TableViewTextColumn Header="Department" Width="{StaticResource ColWidthDepartment}" Binding="{Binding Department}" CanUserSort="False" CanUserFilter="False"/>
                        <muxc:TableViewTextColumn Header="Role"       Width="{StaticResource ColWidthLongName}" Binding="{Binding Role}" CanUserSort="False" CanUserFilter="False"/>
                        <muxc:TableViewTextColumn Header="Salary"     Width="{StaticResource ColWidthNumber}" Binding="{Binding Salary}" CanUserSort="False" CanUserFilter="False"/>
                    </muxc:TableView>
                </Border>
            </Grid>
        </controls:SamplePresenter.Example>

        <controls:SamplePresenter.Options>
            <StackPanel Spacing="12">
                <TextBlock Text="Template picker" Style="{StaticResource SectionHeaderTextStyle}"/>
                <TextBlock Text="Pick a row template. The TableView's realized rows re-shape immediately — no rebind needed." Style="{StaticResource SectionDescriptionTextStyle}" TextWrapping="Wrap"/>
                <muxc:RadioButtons
                    x:Name="TemplatePicker"
                    AutomationProperties.AutomationId="TemplatePicker"
                    AutomationProperties.Name="Row template"
                    SelectedIndex="0"
                    SelectionChanged="OnTemplateChanged">
                    <x:String>None — default per-column cells</x:String>
                    <x:String>Card — avatar disc + name + role/department + Active pill</x:String>
                    <x:String>Compact — two-line stacked name and email</x:String>
                    <x:String>Mixed — avatar + name/role + department badge + salary</x:String>
                </muxc:RadioButtons>
                <TextBlock Text="Status" Style="{StaticResource SectionHeaderTextStyle}" Margin="0,8,0,0"/>
                <Grid ColumnSpacing="12" RowSpacing="4">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Active template" Style="{StaticResource StatusReadoutLabelStyle}"/>
                    <TextBlock Grid.Row="0" Grid.Column="1" x:Name="ActiveTemplateText" Text="(none)" Style="{StaticResource StatusReadoutValueStyle}" AutomationProperties.AutomationId="ActiveTemplateText"/>
                </Grid>
            </StackPanel>
        </controls:SamplePresenter.Options>
    </controls:SamplePresenter>
</Page>