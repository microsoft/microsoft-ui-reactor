<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="TableViewSamples.Pages.ConditionalStylingPage"
    NavigationCacheMode="Enabled"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:controls="using:TableViewSamples.Controls">

    <Page.Resources>
        <!-- Styles returned by the selectors below. Each targets TableViewRow
             so the row's PART_RootBorder.Background TemplateBinding picks up
             whatever brush we set here. Keep them subtle: selection visuals
             must remain readable when a row is both selected AND styled. -->

        <!-- "By department" palette: subtle category tints -->
        <Style x:Key="EngineeringRowStyle" TargetType="muxc:TableViewRow">
            <Setter Property="Background" Value="#1F0078D4"/>
        </Style>
        <Style x:Key="SalesRowStyle" TargetType="muxc:TableViewRow">
            <Setter Property="Background" Value="#1F107C10"/>
        </Style>
        <Style x:Key="MarketingRowStyle" TargetType="muxc:TableViewRow">
            <Setter Property="Background" Value="#1FCA5010"/>
        </Style>
        <Style x:Key="HRRowStyle" TargetType="muxc:TableViewRow">
            <Setter Property="Background" Value="#1F8E2EBD"/>
        </Style>
        <Style x:Key="OperationsRowStyle" TargetType="muxc:TableViewRow">
            <Setter Property="Background" Value="#1FB7472A"/>
        </Style>
        <Style x:Key="DesignRowStyle" TargetType="muxc:TableViewRow">
            <Setter Property="Background" Value="#1F8764B8"/>
        </Style>
        <Style x:Key="ProductRowStyle" TargetType="muxc:TableViewRow">
            <Setter Property="Background" Value="#1F00B7C3"/>
        </Style>
        <Style x:Key="FinanceRowStyle" TargetType="muxc:TableViewRow">
            <Setter Property="Background" Value="#1F498205"/>
        </Style>

        <!-- "By salary tier" palette: stoplight emphasis -->
        <Style x:Key="HighSalaryRowStyle" TargetType="muxc:TableViewRow">
            <Setter Property="Background" Value="{ThemeResource SystemFillColorSuccessBackgroundBrush}"/>
        </Style>
        <Style x:Key="LowSalaryRowStyle" TargetType="muxc:TableViewRow">
            <Setter Property="Background" Value="{ThemeResource SystemFillColorCautionBackgroundBrush}"/>
        </Style>

        <!-- "Inactive" highlight -->
        <Style x:Key="InactiveRowStyle" TargetType="muxc:TableViewRow">
            <Setter Property="Background" Value="{ThemeResource SystemFillColorCriticalBackgroundBrush}"/>
            <Setter Property="Opacity" Value="0.85"/>
        </Style>
    </Page.Resources>

    <controls:SamplePresenter
        Header="Conditional row styling"
        Description="Apply a different row Style based on the data — tint by department, by salary tier, or call out inactive employees. A StyleSelector returns the Style for each row, so rows re-tint as they scroll into view."
        SourceCaption="ConditionalStylingPage.xaml (excerpt)"
        SourceSnippet="ConditionalStyling.xaml.txt"
        AdditionalSnippetCaption="ConditionalStylingPage.xaml.cs (excerpt)"
        AdditionalSnippet="ConditionalStyling.cs.txt"
        StretchExample="True">

        <controls:SamplePresenter.Example>
            <Grid RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <muxc:InfoBar
                    Grid.Row="0"
                    IsOpen="True"
                    IsClosable="False"
                    Severity="Informational"
                    Title="Try it"
                    Message="Pick a rule to re-tint rows by department, salary tier, or active state. Rows pick up the style as they scroll into view; selection still highlights on top."
                    MinHeight="104"/>
                <Border Grid.Row="1" Style="{StaticResource TableHostBorderStyle}" Padding="0" VerticalAlignment="Stretch">
                    <muxc:TableView
                        x:Name="PeopleTable"
                        ItemsSource="{x:Bind People, Mode=OneWay}"
                        SelectionMode="Single"
                        VerticalAlignment="Stretch"
                        MinHeight="320">
                        <muxc:TableViewTextColumn Header="First name" Width="{StaticResource ColWidthShortName}" Binding="{Binding FirstName}" CanUserSort="False" CanUserFilter="False"/>
                        <muxc:TableViewTextColumn Header="Last name"  Width="{StaticResource ColWidthShortName}" Binding="{Binding LastName}" CanUserSort="False" CanUserFilter="False"/>
                        <muxc:TableViewTextColumn Header="Department" Width="{StaticResource ColWidthDepartment}" Binding="{Binding Department}" CanUserSort="False" CanUserFilter="False"/>
                        <muxc:TableViewTextColumn Header="Role"       Width="{StaticResource ColWidthLongName}" Binding="{Binding Role}" CanUserSort="False" CanUserFilter="False"/>
                        <muxc:TableViewTextColumn Header="Salary"     Width="{StaticResource ColWidthNumber}" Binding="{Binding Salary}" CanUserSort="False" CanUserFilter="False"/>
                        <muxc:TableViewTextColumn Header="Active"     Width="{StaticResource ColWidthBoolean}"  Binding="{Binding IsActive}" CanUserSort="False" CanUserFilter="False"/>
                    </muxc:TableView>
                </Border>
            </Grid>
        </controls:SamplePresenter.Example>

        <controls:SamplePresenter.Options>
            <StackPanel Spacing="12">
                <TextBlock
                    Text="Pick a selector. Each option swaps RowStyleSelector at runtime; the realized rows re-style immediately without rebinding."
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextWrapping="Wrap"/>
                <muxc:RadioButtons
                    x:Name="SelectorPicker"
                    AutomationProperties.AutomationId="SelectorPicker"
                    AutomationProperties.Name="Row style selector"
                    SelectedIndex="0"
                    SelectionChanged="OnSelectorChanged">
                    <x:String>None — implicit theme style</x:String>
                    <x:String>By department — category tints</x:String>
                    <x:String>By salary tier — top earners green, below 60k amber</x:String>
                    <x:String>Highlight inactive — critical-fill background</x:String>
                </muxc:RadioButtons>

                <TextBlock Text="Live readouts" Style="{StaticResource SectionHeaderTextStyle}" Margin="0,8,0,0"/>
                <Grid ColumnSpacing="12" RowSpacing="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Active selector:" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <TextBlock Grid.Row="0" Grid.Column="1" x:Name="ActiveSelectorText" Text="(none)" AutomationProperties.AutomationId="ActiveSelectorText" TextWrapping="Wrap"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Selector invocations:" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <TextBlock Grid.Row="1" Grid.Column="1" x:Name="InvocationCountText" Text="0" AutomationProperties.AutomationId="InvocationCountText"/>
                </Grid>
            </StackPanel>
        </controls:SamplePresenter.Options>

    </controls:SamplePresenter>
</Page>
