<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="TableViewSamples.Pages.RowDetailsPage"
    NavigationCacheMode="Enabled"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:controls="using:TableViewSamples.Controls">

    <controls:SamplePresenter
        Header="Row details template"
        Description="Per-row expansion area shown below the row body. RowDetailsTemplate sets the visual, RowDetailsVisibilityMode picks Collapsed / Visible / VisibleWhenSelected. Per-row toggle is available via SetRowDetailsExpanded(item, true)."
        SourceCaption="RowDetailsPage.xaml (excerpt)"
        SourceSnippet="RowDetails.xaml.txt"
        StretchExample="True">

        <controls:SamplePresenter.Example>
            <Grid RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <muxc:InfoBar
                    Grid.Row="0"
                    IsOpen="True"
                    IsClosable="False"
                    Severity="Informational"
                    Title="Try it"
                    Message="Pick a visibility mode to show each row's details panel — always, never, or only when selected. The readouts track each change."
                    MinHeight="104"/>
                <Border Grid.Row="1" Style="{StaticResource TableHostBorderStyle}" VerticalAlignment="Stretch">
                    <muxc:TableView
                        x:Name="PeopleTable"
                        ItemsSource="{x:Bind People, Mode=OneWay}"
                        SelectionMode="Single"
                        RowDetailsVisibilityMode="VisibleWhenSelected"
                        RowDetailsVisibilityChanged="OnRowDetailsVisibilityChanged"
                        VerticalAlignment="Stretch"
                        MinHeight="320">
                        <muxc:TableView.RowDetailsTemplate>
                            <DataTemplate>
                                <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Padding="20,14">
                                    <StackPanel Spacing="6">
                                        <TextBlock FontWeight="SemiBold" Text="{Binding FullName}"/>
                                        <Grid ColumnSpacing="20" RowSpacing="4">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Email:" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Email}"/>
                                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Department / Role:" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                            <TextBlock Grid.Row="1" Grid.Column="1"><Run Text="{Binding Department}"/><Run Text=" — "/><Run Text="{Binding Role}"/></TextBlock>
                                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Joined:" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding JoinDateText}"/>
                                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Salary:" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Salary}"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </muxc:TableView.RowDetailsTemplate>
                        <muxc:TableViewTextColumn Header="First name" Width="{StaticResource ColWidthShortName}" Binding="{Binding FirstName}" CanUserSort="False" CanUserFilter="False"/>
                        <muxc:TableViewTextColumn Header="Last name"  Width="{StaticResource ColWidthShortName}" Binding="{Binding LastName}"  CanUserSort="False" CanUserFilter="False"/>
                        <muxc:TableViewTextColumn Header="Email"      Width="{StaticResource ColWidthEmail}"     Binding="{Binding Email}"      CanUserSort="False" CanUserFilter="False"/>
                        <muxc:TableViewTextColumn Header="Department" Width="{StaticResource ColWidthDepartment}" Binding="{Binding Department}" CanUserSort="False" CanUserFilter="False"/>
                        <muxc:TableViewTextColumn Header="Role"       Width="{StaticResource ColWidthLongName}"  Binding="{Binding Role}"       CanUserSort="False" CanUserFilter="False"/>
                        <muxc:TableViewTextColumn Header="Join date"  Width="{StaticResource ColWidthDate}"      Binding="{Binding JoinDateText}" CanUserSort="False" CanUserFilter="False"/>
                    </muxc:TableView>
                </Border>
            </Grid>
        </controls:SamplePresenter.Example>

        <controls:SamplePresenter.Options>
            <StackPanel Spacing="12">
                <TextBlock Text="Visibility mode" Style="{StaticResource SectionHeaderTextStyle}"/>
                <TextBlock Text="Pick how row details are shown. VisibleWhenSelected is the default for this sample." Style="{StaticResource SectionDescriptionTextStyle}" TextWrapping="Wrap"/>
                <StackPanel Spacing="8" AutomationProperties.Name="RowDetailsVisibilityMode options">
                    <RadioButton x:Name="CollapsedRadio" Content="Collapsed" Tag="Collapsed" GroupName="RowDetailsMode" Checked="OnVisibilityModeChecked"/>
                    <RadioButton x:Name="VisibleRadio" Content="Visible" Tag="Visible" GroupName="RowDetailsMode" Checked="OnVisibilityModeChecked"/>
                    <RadioButton x:Name="VisibleWhenSelectedRadio" Content="VisibleWhenSelected" Tag="VisibleWhenSelected" GroupName="RowDetailsMode" IsChecked="True" Checked="OnVisibilityModeChecked"/>
                </StackPanel>
                <TextBlock Text="Status" Style="{StaticResource SectionHeaderTextStyle}" Margin="0,8,0,0"/>
                <Grid ColumnSpacing="12" RowSpacing="4">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Visibility events" Style="{StaticResource StatusReadoutLabelStyle}"/>
                    <TextBlock Grid.Row="0" Grid.Column="1" x:Name="EventCountText" Text="0" Style="{StaticResource StatusReadoutValueStyle}" AutomationProperties.AutomationId="EventCountText"/>
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Last event" Style="{StaticResource StatusReadoutLabelStyle}"/>
                    <TextBlock Grid.Row="1" Grid.Column="1" x:Name="LastEventText" Text="(none yet)" Style="{StaticResource StatusReadoutValueStyle}" AutomationProperties.AutomationId="LastEventText" TextWrapping="Wrap"/>
                </Grid>
            </StackPanel>
        </controls:SamplePresenter.Options>
    </controls:SamplePresenter>
</Page>
