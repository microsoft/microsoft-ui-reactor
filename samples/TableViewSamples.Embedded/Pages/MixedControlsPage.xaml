<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="TableViewSamples.Pages.MixedControlsPage"
    NavigationCacheMode="Disabled"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:controls="using:TableViewSamples.Controls"
    xmlns:data="using:TableViewSamples.Data"
    xmlns:models="using:TableViewSamples.Models">

    <Page.Resources>

        <!-- Display + edit are the SAME template here.  These four controls
             (DatePicker, TimePicker, ComboBox, CheckBox) are intrinsically
             interactive, so there is no benefit to swapping in a separate
             read-only TextBlock for display mode — we just let the picker /
             check be the cell content directly.  TwoWay bindings push the
             user's change straight back into the Person row. -->

        <DataTemplate x:Key="JoinDateCell" x:DataType="models:Person">
            <!-- MinYear/MaxYear are intentionally NOT set in XAML. The XAML
                 markup compiler can't convert ISO-8601 strings to DateTimeOffset
                 attribute values; setting these via XAML attributes fails
                 WMC0055. Defaults (1900-9999) are fine for this demo. -->
            <DatePicker
                Date="{x:Bind JoinDate, Mode=TwoWay}"
                Margin="6,2"
                VerticalAlignment="Center"
                HorizontalAlignment="Stretch"/>
        </DataTemplate>

        <DataTemplate x:Key="ShiftStartCell" x:DataType="models:Person">
            <TimePicker
                Time="{x:Bind ShiftStart, Mode=TwoWay}"
                ClockIdentifier="24HourClock"
                MinuteIncrement="15"
                Margin="6,2"
                VerticalAlignment="Center"
                HorizontalAlignment="Stretch"/>
        </DataTemplate>

        <DataTemplate x:Key="DepartmentCell" x:DataType="models:Person">
            <ComboBox
                SelectedItem="{x:Bind Department, Mode=TwoWay}"
                ItemsSource="{x:Bind data:PersonData.Departments}"
                Margin="6,2"
                VerticalAlignment="Center"
                HorizontalAlignment="Stretch"/>
        </DataTemplate>

        <DataTemplate x:Key="IsActiveCell" x:DataType="models:Person">
            <CheckBox
                IsChecked="{x:Bind IsActive, Mode=TwoWay}"
                MinWidth="0"
                Margin="14,2"
                VerticalAlignment="Center"
                HorizontalAlignment="Left"/>
        </DataTemplate>

    </Page.Resources>

    <controls:SamplePresenter
        Header="Mixed controls in cells"
        Description="Host non-text controls — DatePicker, TimePicker, ComboBox, CheckBox — directly inside cells via TableViewTemplateColumn. TwoWay bindings push the user's edits straight back into the row's data object."
        SourceCaption="MixedControlsPage.xaml (excerpt)"
        SourceSnippet="MixedControls.xaml.txt"
        StretchExample="True">

        <controls:SamplePresenter.Example>
            <Grid RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <muxc:InfoBar
                    Grid.Row="0"
                    IsOpen="True"
                    IsClosable="False"
                    Severity="Informational"
                    Title="Try it"
                    Message="Edit any row's date, time, department, or Active checkbox — changes bind straight back to the row and the readout below updates live."
                    MinHeight="104"/>
                <Border Grid.Row="1" Style="{StaticResource TableHostBorderStyle}" VerticalAlignment="Stretch">
                    <muxc:TableView
                        x:Name="PeopleTable"
                        ItemsSource="{x:Bind People, Mode=OneWay}"
                        SelectionMode="Single"
                        VerticalAlignment="Stretch"
                        MinHeight="320">

                        <!-- Plain text column for context.  Width matches the other
                             columns so the table looks balanced. -->
                        <muxc:TableViewTextColumn
                            Header="Name"
                            Width="{StaticResource ColWidthLongName}"
                            Binding="{Binding FullName}" CanUserSort="False" CanUserFilter="False"/>

                        <!-- DatePicker in a cell — bound TwoWay to Person.JoinDate.
                             SortMemberPath is mandatory on a template column (the column
                             has no Binding the framework can fall back to — the binding
                             lives inside the DataTemplate). -->
                        <muxc:TableViewTemplateColumn
                            Header="Join date"
                            Width="{StaticResource ColWidthDate}"
                            SortMemberPath="JoinDate"
                            CellTemplate="{StaticResource JoinDateCell}" CanUserSort="False" CanUserFilter="False"/>

                        <!-- TimePicker in a cell — bound TwoWay to Person.ShiftStart. -->
                        <muxc:TableViewTemplateColumn
                            Header="Shift start"
                            Width="{StaticResource ColWidthDate}"
                            SortMemberPath="ShiftStart"
                            CellTemplate="{StaticResource ShiftStartCell}" CanUserSort="False" CanUserFilter="False"/>

                        <!-- ComboBox in a cell — choices come from
                             PersonData.Departments; selected item TwoWay-bound to
                             Person.Department so the row data updates immediately. -->
                        <muxc:TableViewTemplateColumn
                            Header="Department"
                            Width="{StaticResource ColWidthDepartment}"
                            SortMemberPath="Department"
                            CellTemplate="{StaticResource DepartmentCell}" CanUserSort="False" CanUserFilter="False"/>

                        <!-- CheckBox in a cell — bound TwoWay to Person.IsActive. -->
                        <muxc:TableViewTemplateColumn
                            Header="Active"
                            Width="{StaticResource ColWidthBoolean}"
                            SortMemberPath="IsActive"
                            CellTemplate="{StaticResource IsActiveCell}" CanUserSort="False" CanUserFilter="False"/>
                    </muxc:TableView>
                </Border>
            </Grid>
        </controls:SamplePresenter.Example>

        <controls:SamplePresenter.Options>
            <StackPanel Spacing="12">
                <TextBlock Text="Live data readout" Style="{StaticResource SectionHeaderTextStyle}"/>
                <TextBlock Text="First row" Style="{StaticResource SectionDescriptionTextStyle}" TextWrapping="Wrap"/>
                <TextBlock
                    x:Name="LiveReadout"
                    FontFamily="Consolas"
                    FontSize="12"
                    TextWrapping="Wrap"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </StackPanel>
        </controls:SamplePresenter.Options>
    </controls:SamplePresenter>
</Page>
