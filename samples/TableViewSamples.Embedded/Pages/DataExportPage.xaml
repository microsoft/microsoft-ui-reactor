<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="TableViewSamples.Pages.DataExportPage"
    NavigationCacheMode="Enabled"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:controls="using:TableViewSamples.Controls">

    <controls:SamplePresenter
        Header="Data export"
        Description="Serialize the rows currently displayed in a TableView to CSV, TSV (Excel-compatible), or JSON. The exporter walks TableView.Columns so it honors the user's column order and skips columns the consumer hasn't shown."
        SourceCaption="DataExportPage.xaml.cs (excerpt)"
        SourceSnippet="DataExport.cs.txt"
        StretchExample="True">

        <controls:SamplePresenter.Example>
            <Grid RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <muxc:InfoBar
                    Grid.Row="0"
                    IsOpen="True"
                    IsClosable="False"
                    Severity="Informational"
                    Title="Try it"
                    Message="Pick a format, click Export, and check the preview. The file is also saved to %TEMP% and copied to the clipboard."
                    MinHeight="104"/>
                <Border Grid.Row="1" Style="{StaticResource TableHostBorderStyle}" VerticalAlignment="Stretch">
                    <muxc:TableView
                        x:Name="PeopleTable"
                        AutomationProperties.AutomationId="PeopleTable"
                        ItemsSource="{x:Bind People, Mode=OneTime}"
                        SelectionMode="Single"
                        VerticalAlignment="Stretch"
                        MinHeight="320">
                        <muxc:TableViewTextColumn Header="First name" Width="{StaticResource ColWidthLongName}"   Binding="{Binding FirstName}" CanUserSort="False" CanUserFilter="False"/>
                        <muxc:TableViewTextColumn Header="Last name"  Width="{StaticResource ColWidthLongName}"   Binding="{Binding LastName}"  CanUserSort="False" CanUserFilter="False"/>
                        <muxc:TableViewTextColumn Header="Email"      Width="{StaticResource ColWidthEmail}"      Binding="{Binding Email}"      CanUserSort="False" CanUserFilter="False"/>
                        <muxc:TableViewTextColumn Header="Department" Width="{StaticResource ColWidthDepartment}" Binding="{Binding Department}" CanUserSort="False" CanUserFilter="False"/>
                        <muxc:TableViewTextColumn Header="Role"       Width="{StaticResource ColWidthLongName}"   Binding="{Binding Role}"        CanUserSort="False" CanUserFilter="False"/>
                        <muxc:TableViewTextColumn Header="Join date"  Width="{StaticResource ColWidthDate}"        Binding="{Binding JoinDateText}" CanUserSort="False" CanUserFilter="False"/>
                        <muxc:TableViewTextColumn Header="Salary"     Width="{StaticResource ColWidthNumber}"      Binding="{Binding Salary}"      CanUserSort="False" CanUserFilter="False"/>
                        <muxc:TableViewTextColumn Header="Active"     Width="{StaticResource ColWidthBoolean}"     Binding="{Binding IsActive}"   CanUserSort="False" CanUserFilter="False"/>
                    </muxc:TableView>
                </Border>
            </Grid>
        </controls:SamplePresenter.Example>

        <controls:SamplePresenter.Options>
            <StackPanel Spacing="12">
                <TextBlock Text="Export options" Style="{StaticResource SectionHeaderTextStyle}"/>
                <TextBlock
                    Text="Choose a format, export the visible rows, then inspect or open the generated file."
                    Style="{StaticResource SectionDescriptionTextStyle}"
                    TextWrapping="Wrap"/>
                <muxc:RadioButtons
                    x:Name="FormatRadios"
                    AutomationProperties.AutomationId="FormatRadios"
                    AutomationProperties.Name="Export format"
                    MaxColumns="3"
                    SelectedIndex="0">
                    <RadioButton Content="CSV"  AutomationProperties.AutomationId="FormatCsvRadio"/>
                    <RadioButton Content="TSV"  AutomationProperties.AutomationId="FormatTsvRadio"/>
                    <RadioButton Content="JSON" AutomationProperties.AutomationId="FormatJsonRadio"/>
                </muxc:RadioButtons>
                <StackPanel Spacing="8">
                    <Button
                        x:Name="ExportButton"
                        AutomationProperties.AutomationId="ExportButton"
                        Content="Export"
                        Style="{ThemeResource AccentButtonStyle}"
                        Click="OnExportClick"
                        HorizontalContentAlignment="Center"
                        HorizontalAlignment="Stretch"/>
                    <Button
                        x:Name="OpenInExplorerButton"
                        AutomationProperties.AutomationId="OpenInExplorerButton"
                        Content="Show in Explorer"
                        IsEnabled="False"
                        Click="OnOpenInExplorerClick"
                        HorizontalContentAlignment="Center"
                        HorizontalAlignment="Stretch"/>
                </StackPanel>

                <TextBlock Text="Status" Style="{StaticResource SectionHeaderTextStyle}" Margin="0,8,0,0"/>
                <TextBlock
                    x:Name="StatusText"
                    AutomationProperties.AutomationId="StatusText"
                    Style="{StaticResource StatusReadoutValueStyle}"
                    Text="No export yet. Choose a format and click Export."/>

                <TextBlock Text="Preview" Style="{StaticResource SectionHeaderTextStyle}" Margin="0,8,0,0"/>
                <Border
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource ControlCornerRadius}"
                    Background="{ThemeResource SubtleFillColorTransparentBrush}"
                    Padding="0">
                    <TextBox
                        x:Name="ExportPreviewText"
                        AutomationProperties.AutomationId="ExportPreviewText"
                        AutomationProperties.Name="Export preview"
                        AcceptsReturn="True"
                        IsReadOnly="True"
                        IsSpellCheckEnabled="False"
                        FontFamily="Consolas, Cascadia Mono, Courier New"
                        Height="220"
                        PlaceholderText="Preview of the exported text appears here (first 30 lines)."
                        ScrollViewer.HorizontalScrollBarVisibility="Auto"
                        ScrollViewer.VerticalScrollBarVisibility="Auto"
                        TextWrapping="NoWrap"/>
                </Border>

                <muxc:InfoBar
                    IsOpen="True"
                    IsClosable="False"
                    Severity="Informational"
                    Title="What this sample proves"
                    Message="CSV and TSV use the built-in TableView.GetDataAsText formatter, which honors the visible column order and handles CSV/TSV escaping plus TemplateColumn/CheckBoxColumn. JSON isn't part of the public formatter set, so this page hand-rolls it in ~40 lines of C# that walk TableView.Columns (respecting user reordering) and read each column's Binding.Path against the ItemsSource — copy-paste straight into your app."/>
            </StackPanel>
        </controls:SamplePresenter.Options>

    </controls:SamplePresenter>
</Page>
