<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="TableViewSamples.Pages.LayoutPage"
    NavigationCacheMode="Enabled"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:controls="using:TableViewSamples.Controls">

    <controls:SamplePresenter
        Header="Persisted layout state"
        Description="Capture the table's current sort, column order, and frozen-edge configuration into a single string token, then restore it later — handy for saving per-user view preferences across sessions."
        SourceCaption="LayoutPage.xaml.cs (excerpt)"
        SourceSnippet="Layout.xaml.txt"
        StretchExample="True">

        <controls:SamplePresenter.Example>
            <Grid RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <muxc:InfoBar
                    Grid.Row="0"
                    IsOpen="True"
                    IsClosable="False"
                    Severity="Informational"
                    Title="Try it"
                    MinHeight="104"
                    Message="Reorder columns and sort, then click Save layout to capture the state as a token. Reset to defaults, then Load layout to restore it."/>
                <Border Grid.Row="1" Style="{StaticResource TableHostBorderStyle}" VerticalAlignment="Stretch">
                    <muxc:TableView
                        x:Name="LayoutTable"
                        AutomationProperties.AutomationId="LayoutTable"
                        SelectionMode="Single"
                        CanUserReorderColumns="True"
                        ItemsSource="{x:Bind People}"
                        Sorted="OnTableSorted"
                        VerticalAlignment="Stretch"
                        MinHeight="320">
                        <muxc:TableViewTextColumn Header="Name"     ColumnId="name"     Width="{StaticResource ColWidthLongName}" SortMemberPath="Name"     Binding="{Binding Name}" CanUserFilter="False"/>
                        <muxc:TableViewTextColumn Header="Role"     ColumnId="role"     Width="{StaticResource ColWidthLongName}" SortMemberPath="Role"     Binding="{Binding Role}" CanUserFilter="False"/>
                        <muxc:TableViewTextColumn Header="Team"     ColumnId="team"     Width="{StaticResource ColWidthDepartment}" SortMemberPath="Team"     Binding="{Binding Team}" CanUserFilter="False"/>
                        <muxc:TableViewTextColumn Header="Location" ColumnId="location" Width="{StaticResource ColWidthLocation}" SortMemberPath="Location" Binding="{Binding Location}" CanUserFilter="False"/>
                    </muxc:TableView>
                </Border>
            </Grid>
        </controls:SamplePresenter.Example>

        <controls:SamplePresenter.Options>
            <StackPanel Spacing="12">
                <TextBlock Text="Layout actions" Style="{StaticResource SectionHeaderTextStyle}"/>
                <TextBlock
                    Text="Change the layout (resize a column edge, drag headers to reorder, click a header to sort, toggle the frozen edge below). Save captures a token; Reset restores defaults; Load reapplies the token."
                    Style="{StaticResource SectionDescriptionTextStyle}"
                    TextWrapping="Wrap"/>
                <StackPanel Spacing="8">
                    <Button
                        x:Name="SaveButton"
                        AutomationProperties.AutomationId="SaveButton"
                        Content="Save layout"
                        Click="OnSaveClick"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"/>
                    <Button
                        x:Name="LoadButton"
                        AutomationProperties.AutomationId="LoadButton"
                        Content="Load layout"
                        Click="OnLoadClick"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"/>
                    <Button
                        x:Name="ResetButton"
                        AutomationProperties.AutomationId="ResetButton"
                        Content="Reset to defaults"
                        Click="OnResetClick"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"/>
                    <Button
                        x:Name="ToggleFrozenButton"
                        AutomationProperties.AutomationId="ToggleFrozenButton"
                        Content="Freeze leading column"
                        Click="OnToggleFrozenClick"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"/>
                </StackPanel>

                <TextBlock Text="Saved token" Style="{StaticResource SectionHeaderTextStyle}" Margin="0,8,0,0"/>
                <TextBlock
                    Text="The saved token appears here. Edit it before clicking Load to experiment with the schema."
                    Style="{StaticResource SectionDescriptionTextStyle}"
                    TextWrapping="Wrap"/>
                <TextBox
                    x:Name="JsonText"
                    AutomationProperties.AutomationId="JsonText"
                    AcceptsReturn="True"
                    IsSpellCheckEnabled="False"
                    FontFamily="Consolas"
                    FontSize="12"
                    Height="160"
                    TextWrapping="Wrap"
                    Text=""/>

                <TextBlock Text="Status" Style="{StaticResource SectionHeaderTextStyle}" Margin="0,8,0,0"/>
                <Grid ColumnSpacing="12" RowSpacing="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Last action" Style="{StaticResource StatusReadoutLabelStyle}" VerticalAlignment="Top"/>
                    <TextBlock Grid.Row="0" Grid.Column="1" x:Name="LastActionText" Text="(none)" Style="{StaticResource StatusReadoutValueStyle}" AutomationProperties.AutomationId="LastActionText" TextWrapping="Wrap"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Token length" Style="{StaticResource StatusReadoutLabelStyle}"/>
                    <TextBlock Grid.Row="1" Grid.Column="1" x:Name="TokenLengthText" Text="0 chars" Style="{StaticResource StatusReadoutValueStyle}" AutomationProperties.AutomationId="TokenLengthText"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Sort priority" Style="{StaticResource StatusReadoutLabelStyle}" VerticalAlignment="Top"/>
                    <TextBlock Grid.Row="2" Grid.Column="1" x:Name="SortStateText" Text="(none)" Style="{StaticResource StatusReadoutValueStyle}" AutomationProperties.AutomationId="SortStateText" TextWrapping="Wrap"/>
                </Grid>
            </StackPanel>
        </controls:SamplePresenter.Options>

    </controls:SamplePresenter>
</Page>
