<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="TableViewSamples.Pages.HierarchyPage"
    NavigationCacheMode="Enabled"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:controls="using:TableViewSamples.Controls">

    <controls:SamplePresenter
        Header="N-level hierarchy"
        Description="Tree-grid mode: each row exposes its child rows through a named children property (set via HierarchicalChildrenPropertyName), and an expand chevron in the first column lets the user drill in. Supports arbitrary nesting depth."
        SourceCaption="HierarchyPage.xaml (excerpt)"
        SourceSnippet="Hierarchy.xaml.txt"
        StretchExample="True">

        <controls:SamplePresenter.Example>
            <Grid RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <muxc:InfoBar
                    Grid.Row="0"
                    IsOpen="True"
                    IsClosable="False"
                    Severity="Informational"
                    Title="Try it"
                    Message="Click a chevron to expand / collapse a node. Sorting and filtering work per level and keep the tree path visible. Use Expand all / Collapse all too."
                    MinHeight="104"/>
                <Border Grid.Row="1" Style="{StaticResource TableHostBorderStyle}" VerticalAlignment="Stretch" Padding="0">
                    <muxc:TableView
                        x:Name="OrgTable"
                        AutomationProperties.AutomationId="OrgTable"
                        SelectionMode="Single"
                        HierarchicalChildrenPropertyName="Children"
                        HierarchicalItemsSource="{x:Bind Roots}"
                        VerticalAlignment="Stretch"
                        MinHeight="320">
                        <muxc:TableViewTextColumn Header="Name"     Width="{StaticResource ColWidthLongName}" Binding="{Binding Name}"     SortMemberPath="Name"/>
                        <muxc:TableViewTextColumn Header="Headcount" Width="140" Binding="{Binding Headcount}" SortMemberPath="Headcount"/>
                        <muxc:TableViewTextColumn Header="Title"    Width="{StaticResource ColWidthLongName}" Binding="{Binding Owner}"    SortMemberPath="Owner"/>
                        <muxc:TableViewTextColumn Header="Location" Width="{StaticResource ColWidthLocation}" Binding="{Binding Location}" SortMemberPath="Location"/>
                    </muxc:TableView>
                </Border>
            </Grid>
        </controls:SamplePresenter.Example>

        <controls:SamplePresenter.Options>
            <StackPanel Spacing="12">
                <TextBlock Text="Hierarchy actions" Style="{StaticResource SectionHeaderTextStyle}"/>
                <TextBlock Text="Expand, collapse, or toggle the selected node without using chevrons." Style="{StaticResource SectionDescriptionTextStyle}" TextWrapping="Wrap"/>
                <StackPanel Spacing="8">
                    <Button x:Name="ExpandAllButton" AutomationProperties.AutomationId="ExpandAllButton" Content="Expand all" Click="OnExpandAllClick" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                    <Button x:Name="CollapseAllButton" AutomationProperties.AutomationId="CollapseAllButton" Content="Collapse all" Click="OnCollapseAllClick" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                    <Button x:Name="ToggleSelectedButton" AutomationProperties.AutomationId="ToggleSelectedButton" Content="Toggle selected" Click="OnToggleSelectedClick" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                </StackPanel>

                <TextBlock Text="Status" Style="{StaticResource SectionHeaderTextStyle}" Margin="0,8,0,0"/>
                <Grid ColumnSpacing="12" RowSpacing="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="IsHierarchical" Style="{StaticResource StatusReadoutLabelStyle}"/>
                    <TextBlock Grid.Row="0" Grid.Column="1" x:Name="IsHierarchicalText" Text="True" Style="{StaticResource StatusReadoutValueStyle}" AutomationProperties.AutomationId="IsHierarchicalText"/>
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="ChildrenPropertyName" Style="{StaticResource StatusReadoutLabelStyle}"/>
                    <TextBlock Grid.Row="1" Grid.Column="1" x:Name="ChildrenPropertyNameText" Text="(default)" Style="{StaticResource StatusReadoutValueStyle}" AutomationProperties.AutomationId="ChildrenPropertyNameText" TextWrapping="Wrap"/>
                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Selected node" Style="{StaticResource StatusReadoutLabelStyle}" VerticalAlignment="Top"/>
                    <TextBlock Grid.Row="2" Grid.Column="1" x:Name="SelectedNodeText" Text="(none)" Style="{StaticResource StatusReadoutValueStyle}" AutomationProperties.AutomationId="SelectedNodeText" TextWrapping="Wrap"/>
                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Sorted columns" Style="{StaticResource StatusReadoutLabelStyle}" VerticalAlignment="Top"/>
                    <TextBlock Grid.Row="3" Grid.Column="1" x:Name="SortedColumnsText" Text="(none)" Style="{StaticResource StatusReadoutValueStyle}" AutomationProperties.AutomationId="SortedColumnsText" TextWrapping="Wrap"/>
                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Filtered columns" Style="{StaticResource StatusReadoutLabelStyle}" VerticalAlignment="Top"/>
                    <TextBlock Grid.Row="4" Grid.Column="1" x:Name="FilteredColumnsText" Text="(none)" Style="{StaticResource StatusReadoutValueStyle}" AutomationProperties.AutomationId="FilteredColumnsText" TextWrapping="Wrap"/>
                    <TextBlock Grid.Row="5" Grid.Column="0" Text="Last action" Style="{StaticResource StatusReadoutLabelStyle}"/>
                    <TextBlock Grid.Row="5" Grid.Column="1" x:Name="LastActionText" Text="(none)" Style="{StaticResource StatusReadoutValueStyle}" AutomationProperties.AutomationId="LastActionText" TextWrapping="Wrap"/>
                </Grid>
            </StackPanel>
        </controls:SamplePresenter.Options>

    </controls:SamplePresenter>
</Page>
