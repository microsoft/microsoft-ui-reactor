<Page
    x:Class="TransitionComparison.Xaml.PageB"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Full-bleed slab, same colours as the Reactor twin's Page B. -->
    <Grid Background="#6D28D9">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6">
            <TextBlock Text="PAGE  B" FontSize="64" FontWeight="Bold" Foreground="#FFFFFF"
                       HorizontalAlignment="Center" />
            <TextBlock Text="violet" FontSize="18" Foreground="#FFFFFF" Opacity="0.85"
                       HorizontalAlignment="Center" />
        </StackPanel>
    </Grid>
</Page>
