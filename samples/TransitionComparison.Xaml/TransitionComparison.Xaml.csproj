<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Deliberately does NOT reference Reactor. This is the control side of the comparison:
    plain WinUI 3, a real Frame, real XAML Pages, and the stock NavigationTransitionInfo
    types. Its twin is samples/TransitionComparison.Reactor.
  -->

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <Platforms>x64;ARM64</Platforms>
    <RootNamespace>TransitionComparison.Xaml</RootNamespace>
    <AssemblyName>TransitionComparison.Xaml</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
  </PropertyGroup>

</Project>
